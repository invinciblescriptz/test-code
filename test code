    local function CreateControlButton(text, color, callback)
        local btn = Utility.Create("TextButton", {
            BackgroundColor3 = Color3.fromRGB(0, 0, 0),
            BackgroundTransparency = 0.7,
            Size = UDim2.fromOffset(24, 24),
            Font = State.Theme.FontBold,
            TextSize = 12,
            TextColor3 = Color3.new(1, 1, 1),
            Text = text,
            AutoButtonColor = false,
            Parent = controls
        })
        Utility.AddCorner(btn, 4)
        btn.MouseEnter:Connect(function()
            Utility.Tween(btn, { BackgroundTransparency = 0.3 })
        end)
        btn.MouseLeave:Connect(function()
            Utility.Tween(btn, { BackgroundTransparency = 0.7 })
        end)
        btn.MouseButton1Click:Connect(callback)
        return btn
    end

    self.MinimizeBtn = CreateControlButton("–", nil, function()
        self:ToggleMinimize()
    end)
    self.CloseBtn = CreateControlButton("×", State.Theme.DangerColor, function()
        self:Destroy()
    end)

    -- Tab Selector
    self.TabSelector = Utility.Create("Frame", {
        Name = "TabSelector",
        BackgroundColor3 = State.Theme.SidebarColor,
        Position = UDim2.fromOffset(0, 32),
        Size = UDim2.new(1, 0, 0, 32),
        BorderSizePixel = 0,
        Visible = false,
        Parent = self.Instance
    })

    self.TabButtons = Utility.Create("ScrollingFrame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 0,
        ScrollingDirection = Enum.ScrollingDirection.X,
        Parent = self.TabSelector
    })
    Utility.AddListLayout(self.TabButtons, Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
    Utility.AddPadding(self.TabButtons, 4, 4, 8, 8)

    -- Content Container
    self.Content = Utility.Create("Frame", {
        Name = "Content",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 64),
        Size = UDim2.new(1, 0, 1, -64),
        ClipsDescendants = true,
        Parent = self.Instance
    })

    -- Resizer
    self.Resizer = Utility.Create("Frame", {
        Name = "Resizer",
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -16, 1, -16),
        Size = UDim2.fromOffset(16, 16),
        Parent = self.Instance
    })

    -- Dragging
    Utility.MakeDraggable(self.Instance, self.TitleBar)

    -- Resizing logic
    do
        local resizing = false
        local startPos, startSize
        self.Resizer.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 and self.Options.CanResize then
                resizing = true
                State.Resizing = true
                startPos = Utility.MousePos()
                startSize = self.Instance.AbsoluteSize
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                resizing = false
                State.Resizing = false
            end
        end)
        RunService.Heartbeat:Connect(function()
            if resizing then
                local delta = Utility.MousePos() - startPos
                local newX = math.max(self.Options.MinWindowSize.X, startSize.X + delta.X)
                local newY = math.max(self.Options.MinWindowSize.Y, startSize.Y + delta.Y)
                self.Instance.Size = UDim2.fromOffset(newX, newY)
            end
        end)
    end

    table.insert(State.Windows, self)
    return self
end

function Window:UpdateTheme()
    self.Instance.BackgroundColor3 = State.Theme.BackgroundColor
    self.TitleBar.BackgroundColor3 = State.Theme.MainColor
    self.TabSelector.BackgroundColor3 = State.Theme.SidebarColor
    -- More updates can be added here for live theme switching
end

function Window:ToggleMinimize()
    self.Minimized = not self.Minimized
    if self.Minimized then
        self.OldSize = self.Instance.Size
        Utility.Tween(self.Instance, { Size = UDim2.fromOffset(self.Instance.AbsoluteSize.X, 32) })
        self.Content.Visible = false
        self.TabSelector.Visible = false
        self.Resizer.Visible = false
    else
        Utility.Tween(self.Instance, { Size = self.OldSize or UDim2.fromOffset(self.Options.MinWindowSize.X, self.Options.MinWindowSize.Y) })
        self.Content.Visible = true
        self.TabSelector.Visible = #self.Tabs > 1
        self.Resizer.Visible = true
    end
end

function Window:Destroy()
    for i, win in ipairs(State.Windows) do
        if win == self then
            table.remove(State.Windows, i)
            break
        end
    end
    self.Instance:Destroy()
end

