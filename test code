-- ==================== FIXED DRAG ====================
local dragging = false
local dragInput
local dragStart
local startPos

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = window.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input == dragInput) then
        local delta = input.Position - dragStart
        window.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- UI Functions
local function CreateLabel(text)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, 0, 0, 35)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = THEME.Text
    l.Font = Enum.Font.GothamBold
    l.TextSize = 20
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = scrolling
    return l
end

local function CreateToggle(text, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 58)
    frame.BackgroundTransparency = 1
    frame.Parent = scrolling

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = THEME.Text
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 18
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 70, 0, 36)
    toggleBtn.Position = UDim2.new(1, -85, 0.5, -18)
    toggleBtn.BackgroundColor3 = default and THEME.Accent or THEME.Surface2
    toggleBtn.Text = ""
    toggleBtn.Parent = frame
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 18)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 30, 0, 30)
    knob.Position = default and UDim2.new(1, -38, 0.5, -15) or UDim2.new(0, 4, 0.5, -15)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Parent = toggleBtn
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local state = default
    toggleBtn.MouseButton1Click:Connect(function()
        state = not state
        TweenService:Create(toggleBtn, TweenInfo.new(0.25), {BackgroundColor3 = state and THEME.Accent or THEME.Surface2}):Play()
        TweenService:Create(knob, TweenInfo.new(0.25), {
            Position = state and UDim2.new(1, -38, 0.5, -15) or UDim2.new(0, 4, 0.5, -15)
        }):Play()
        callback(state)
    end)
end

local function CreateDropdown(titleText, isMulti, callback)
    CreateLabel(titleText)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 58)
    btn.BackgroundColor3 = THEME.Surface2
    btn.Text = "▼  Select Player"
    btn.TextColor3 = THEME.Text
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 18
    btn.Parent = scrolling
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 14)

    local dropFrame = Instance.new("Frame")
    dropFrame.Size = UDim2.new(0.95, 0, 0, 280)
    dropFrame.Position = UDim2.new(0.025, 0, 0.5, 40)
    dropFrame.BackgroundColor3 = THEME.Surface
    dropFrame.Visible = false
    dropFrame.ZIndex = 50
    dropFrame.Parent = window
    Instance.new("UICorner", dropFrame).CornerRadius = UDim.new(0, 14)

    local dropScroll = Instance.new("ScrollingFrame")
    dropScroll.Size = UDim2.new(1, -15, 1, -15)
    dropScroll.Position = UDim2.new(0, 8, 0, 8)
    dropScroll.BackgroundTransparency = 1
    dropScroll.ScrollBarThickness = 5
    dropScroll.Parent = dropFrame

    local dropLayout = Instance.new("UIListLayout")
    dropLayout.Padding = UDim.new(0, 6)
    dropLayout.Parent = dropScroll

    local function refresh()
        for _, v in pairs(dropScroll:GetChildren()) do
            if v:IsA("TextButton") then v:Destroy() end
        end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local option = Instance.new("TextButton")
                option.Size = UDim2.new(1, 0, 0, 45)
                option.BackgroundColor3 = THEME.Surface2
                option.Text = plr.DisplayName .. "\n@" .. plr.Name
                option.TextColor3 = THEME.Text
                option.Font = Enum.Font.GothamSemibold
                option.TextSize = 15
                option.TextYAlignment = Enum.TextYAlignment.Center
                option.Parent = dropScroll
                Instance.new("UICorner", option).CornerRadius = UDim.new(0, 10)

                option.MouseButton1Click:Connect(function()
                    callback(plr)
                    if not isMulti then
                        dropFrame.Visible = false
                    end
                end)
            end
        end
        dropScroll.CanvasSize = UDim2.new(0,0,0, dropLayout.AbsoluteContentSize.Y)
    end

    btn.MouseButton1Click:Connect(function()
        dropFrame.Visible = not dropFrame.Visible
        if dropFrame.Visible then refresh() end
    end)
end

