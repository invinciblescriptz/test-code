	makeCorner(dropFrame, 4)
	makeStroke(dropFrame)

	local dropList = makeList(dropFrame, 2)
	makePadding(dropFrame, 4, 4, 4, 4)

	local function toggle()
		open = not open
		if open then
			dropFrame.Visible = true
			local height = math.min(#options * 26 + 8, 150)
			tween(dropFrame, {Size = UDim2.new(1, 0, 0, height)}, 0.2)
			frame.Size = UDim2.new(1, -4, 0, 30 + height)
		else
			tween(dropFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.15).Completed:Connect(function()
				dropFrame.Visible = false
			end)
			frame.Size = UDim2.new(1, -4, 0, 30)
		end
	end

	btn.MouseButton1Click:Connect(toggle)

	local obj = {
		Frame = frame,
		Add = function(_, optionText)
			local optBtn = Instance.new("TextButton")
			optBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
			optBtn.BorderSizePixel = 0
			optBtn.Size = UDim2.new(1, 0, 0, 24)
