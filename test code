	function tab:AddSlider(text, callback, opts)
		opts = opts or {}
		local min = opts.min or 0
		local max = opts.max or 100
		local default = opts.default or min
		local precise = opts.precise ~= false

		local slider = SliderPrefab:Clone()
		slider.Visible = true
		slider:FindFirstChild("Label").Text = text or "Slider"
		slider.Parent = page

		local valueLabel = slider:FindFirstChild("Value")
		local track = slider:FindFirstChild("Track")
		local fill = track:FindFirstChild("Fill")
		local knob = track:FindFirstChild("Knob")
		local hitbox = slider:FindFirstChild("Hitbox")

		local value = default
		local sliding = false

		local function Update(val, fire)
			value = Clamp(val, min, max)
			if not precise then
				value = math.floor(value + 0.5)
			else
				value = Round(value, 2)
			end
			local pct = (value - min) / (max - min)
			fill.Size = UDim2.new(pct, 0, 1, 0)
			knob.Position = UDim2.new(pct, -6, 0.5, -6)
			valueLabel.Text = tostring(value)
			if fire ~= false and callback then
				task.spawn(callback, value)
			end
		end

		Update(default, false)

		local function FromInput(inputPos)
			local rel = (inputPos.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
			rel = Clamp(rel, 0, 1)
			Update(min + rel * (max - min), true)
		end

		hitbox.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = true
				FromInput(input.Position)
			end
		end)

		SafeConnect(UserInputService.InputChanged, function(input)
			if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				FromInput(input.Position)
			end
		end)

		SafeConnect(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = false
			end
		end)

		local api = {}
		function api:Set(v)
			Update(v, true)
		end
		function api:Get()
			return value
		end

		table.insert(tab.Elements, slider)
		return api
	end

