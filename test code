        Size = UDim2.new(1, -100, 1, 0),
        Font = State.Theme.FontBold,
        TextSize = State.Theme.TitleSize,
        TextColor3 = Color3.new(1, 1, 1),
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = self.Title,
