			local drop = Instance.new("ImageLabel")
			drop.BackgroundTransparency = 1
			drop.Image = "rbxassetid://2851929490"
			drop.ImageColor3 = Color3.fromRGB(33, 34, 36)
			drop.ScaleType = Enum.ScaleType.Slice
