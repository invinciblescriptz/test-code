	listFrame.BackgroundColor3 = Library.Theme.Dropdown
	listFrame.BorderSizePixel = 0
	listFrame.Size = UDim2.new(1, -8, 0, 0)
	listFrame.Position = UDim2.fromOffset(4, 46)
	listFrame.Visible = false
	listFrame.ClipsDescendants = true
	listFrame.ZIndex = 20
	listFrame.Parent = frame
	makeCorner(listFrame, 4)
	makeStroke(listFrame, Library.Theme.Border, 1, 0.5)
	makeList(listFrame, 1)
	makePadding(listFrame, 3, 3, 3, 3)

	local function toggle(force)
		open = force ~= nil and force or not open
		listFrame.Visible = open
		arrow.Text = open and "▲" or "▼"
		if open then
			local h = math.min(#items * 24 + 6, 150)
			Util.Tween(listFrame, {Size = UDim2.new(1, -8, 0, h)}, 0.12)
			frame.Size = UDim2.new(1, 0, 0, 48 + h)
		else
			Util.Tween(listFrame, {Size = UDim2.new(1, -8, 0, 0)}, 0.1)
			frame.Size = UDim2.new(1, 0, 0, 48)
		end
	end

	main.MouseButton1Click:Connect(function()
		toggle()
	end)

	local function addItem(name)
		local itemBtn = Instance.new("TextButton")
		itemBtn.BackgroundColor3 = Library.Theme.BackgroundDark
		itemBtn.BackgroundTransparency = 1
		itemBtn.BorderSizePixel = 0
		itemBtn.Size = UDim2.new(1, 0, 0, 22)
		itemBtn.Font = Library.Theme.Font
		itemBtn.TextSize = 12
		itemBtn.TextColor3 = Library.Theme.Text
		itemBtn.TextXAlignment = Enum.TextXAlignment.Left
		itemBtn.Text = name
		itemBtn.AutoButtonColor = false
		itemBtn.ZIndex = 21
		itemBtn.Parent = listFrame
		makePadding(itemBtn, 6, 0, 6, 0)
		makeCorner(itemBtn, 3)

		itemBtn.MouseEnter:Connect(function()
			itemBtn.BackgroundTransparency = 0
			itemBtn.BackgroundColor3 = Library.Theme.Hover
		end)
		itemBtn.MouseLeave:Connect(function()
			itemBtn.BackgroundTransparency = 1
		end)
		itemBtn.MouseButton1Click:Connect(function()
			selected = name
			main.Text = name
			toggle(false)
			Util.SafeCallback(callback, name)
		end)

		local entry = {
			Name = name,
			Button = itemBtn,
			Remove = function()
				itemBtn:Destroy()
				for i, it in ipairs(items) do
					if it.Name == name then
						table.remove(items, i)
						break
					end
				end
				if open then
					local h = math.min(#items * 24 + 6, 150)
					listFrame.Size = UDim2.new(1, -8, 0, h)
					frame.Size = UDim2.new(1, 0, 0, 48 + h)
				end
			end,
		}
		table.insert(items, entry)
		return entry
	end

	local api = {}
	function api:Add(name) return addItem(tostring(name)) end
	function api:Set(name) selected = name; main.Text = name end
	function api:Get() return selected end
	function api:Clear()
		for _, it in ipairs(items) do it.Button:Destroy() end
		items = {}
		selected = nil
		main.Text = options.Placeholder or "Select..."
	end
	function api:GetItems()
		local t = {}
		for _, it in ipairs(items) do table.insert(t, it.Name) end
		return t
	end
	return api, frame
end

