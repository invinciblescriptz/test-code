function Elements.Button(parent, text, callback, options)
	options = options or {}
	callback = typeof(callback) == "function" and callback or function() end

	local btn = Instance.new("TextButton")
	btn.Name = "Button"
	btn.BackgroundColor3 = Library.Theme.BackgroundLight
	btn.BorderSizePixel = 0
	btn.Size = UDim2.new(1, 0, 0, options.Height or 28)
	btn.Font = Library.Theme.FontMedium
	btn.TextSize = 13
	btn.TextColor3 = Library.Theme.Text
	btn.Text = text or "Button"
	btn.AutoButtonColor = false
	btn.Parent = parent
	makeCorner(btn, 4)
	makeStroke(btn, Library.Theme.Border, 1, 0.6)

	btn.MouseEnter:Connect(function()
		Util.Tween(btn, {BackgroundColor3 = Library.Theme.Hover}, 0.1)
	end)
	btn.MouseLeave:Connect(function()
		Util.Tween(btn, {BackgroundColor3 = Library.Theme.BackgroundLight}, 0.1)
	end)
	btn.MouseButton1Down:Connect(function()
		Util.Tween(btn, {BackgroundColor3 = Library.Theme.Pressed}, 0.06)
	end)
	btn.MouseButton1Up:Connect(function()
		Util.Tween(btn, {BackgroundColor3 = Library.Theme.Hover}, 0.06)
	end)
	btn.MouseButton1Click:Connect(function()
		Util.SafeCallback(callback)
	end)

	local api = {}
	function api:SetText(t) btn.Text = tostring(t) end
	function api:SetCallback(fn) callback = fn end
	function api:Fire() Util.SafeCallback(callback) end
	return api, btn
end

