local WHITELISTED_USERNAMES = {
    "CoolBuilder123",
    "MyBestFriend45",
    "ProGamerX"
}

local KICK_REASON = "You are not whitelisted on this game."

local Players = game:GetService("Players")

local function isWhitelisted(player)
    local playerName = player.Name:lower()
    
    for _, whitelistedName in ipairs(WHITELISTED_USERNAMES) do
        if whitelistedName:lower() == playerName then
            return true
        end
    end
    return false
end

Players.PlayerAdded:Connect(function(player)
    if not isWhitelisted(player) then
        warn(player.Name .. " attempted to join but is not whitelisted.")
        
        -- Small delay so the kick message shows properly
        task.wait(0.5)
        
        player:Kick(KICK_REASON)
    else
        print(player.Name .. " is whitelisted and joined successfully.")
    end
end)

print("✅ Username Whitelist system loaded. " .. #WHITELISTED_USERNAMES .. " users whitelisted.")
