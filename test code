function Elements.Console(parent, options)
	options = options or {}
	local height = options.Y or options.Height or 180
	local source = options.Source or "Logs"
	local readonly = options.Readonly ~= false

	local frame = Instance.new("Frame")
	frame.Name = "Console"
	frame.BackgroundColor3 = Library.Theme.BackgroundDark
	frame.BorderSizePixel = 0
	frame.Size = UDim2.new(1, -4, 0, height)
	frame.Parent = parent
	makeCorner(frame, 5)
	makeStroke(frame, Library.Theme.Border, 1, 0.4)

	local scroll = Instance.new("ScrollingFrame")
	scroll.BackgroundTransparency = 1
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.ScrollBarThickness = 4
	scroll.ScrollBarImageColor3 = Library.Theme.Scrollbar
	scroll.BorderSizePixel = 0
	scroll.Parent = frame
	makePadding(scroll, 6, 6, 6, 6)

	local layout = makeList(scroll, 1)

	local lines = {}
	local maxLines = options.MaxLines or 200

	local luaKeywords = {
		["and"] = true, ["break"] = true, ["do"] = true, ["else"] = true,
		["elseif"] = true, ["end"] = true, ["false"] = true, ["for"] = true,
		["function"] = true, ["goto"] = true, ["if"] = true, ["in"] = true,
		["local"] = true, ["nil"] = true, ["not"] = true, ["or"] = true,
		["repeat"] = true, ["return"] = true, ["then"] = true, ["true"] = true,
		["until"] = true, ["while"] = true,
	}

	local function highlight(line)
		-- Very lightweight token colouring for demo purposes
		return line
	end

	local function addLine(text, color)
		text = tostring(text)
		local lbl = Instance.new("TextLabel")
		lbl.BackgroundTransparency = 1
		lbl.Size = UDim2.new(1, 0, 0, 16)
		lbl.Font = Enum.Font.Code
		lbl.TextSize = 12
		lbl.TextColor3 = color or Library.Theme.Text
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.Text = highlight(text)
		lbl.TextWrapped = false
		lbl.Parent = scroll
		table.insert(lines, lbl)

		if #lines > maxLines then
			local old = table.remove(lines, 1)
			if old then old:Destroy() end
		end

		scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
		scroll.CanvasPosition = Vector2.new(0, scroll.CanvasSize.Y.Offset)
	end

	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
	end)

	local api = {}
	function api:Log(msg)
		addLine(msg, Library.Theme.Text)
	end
	function api:Info(msg)
		addLine("[INFO] " .. tostring(msg), Library.Theme.Accent)
	end
	function api:Warn(msg)
		addLine("[WARN] " .. tostring(msg), Library.Theme.Warning)
	end
	function api:Error(msg)
		addLine("[ERROR] " .. tostring(msg), Library.Theme.Error)
	end
	function api:Success(msg)
		addLine("[OK] " .. tostring(msg), Library.Theme.Success)
	end
	function api:Clear()
		for _, l in ipairs(lines) do
			l:Destroy()
		end
		lines = {}
		scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	end
	function api:GetLines()
		local t = {}
		for _, l in ipairs(lines) do
			table.insert(t, l.Text)
		end
		return t
	end
	return api, frame
end

