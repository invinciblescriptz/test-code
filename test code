local ElementMeta = {}

-- Switch / Toggle object
local SwitchObject = {}
SwitchObject.__index = SwitchObject

function SwitchObject.new(track, knob, theme, callback)
    local self = setmetatable({}, SwitchObject)
    self.Value = false
    self.Track = track
    self.Knob = knob
    self.Theme = theme
    self.Callback = callback
    self.Enabled = true
    return self
end

function SwitchObject:Set(value, silent)
    if not self.Enabled then return end
    self.Value = not not value
    if self.Value then
        tween(self.Track, {BackgroundColor3 = self.Theme.ToggleOn}, 0.15)
        tween(self.Knob, {Position = UDim2.new(1, -18, 0.5, -8)}, 0.15)
    else
        tween(self.Track, {BackgroundColor3 = self.Theme.ToggleOff}, 0.15)
        tween(self.Knob, {Position = UDim2.new(0, 2, 0.5, -8)}, 0.15)
    end
    if not silent and self.Callback then
        task.spawn(self.Callback, self.Value)
    end
end

function SwitchObject:Get()
    return self.Value
end

function SwitchObject:Toggle()
    self:Set(not self.Value)
end

function SwitchObject:SetEnabled(state)
    self.Enabled = state
    self.Track.BackgroundTransparency = state and 0 or 0.5
end

-- Slider object
local SliderObject = {}
SliderObject.__index = SliderObject

function SliderObject.new(fill, knob, valueLabel, track, min, max, callback, theme)
    local self = setmetatable({}, SliderObject)
    self.Value = min
    self.Min = min
    self.Max = max
    self.Fill = fill
    self.Knob = knob
    self.ValueLabel = valueLabel
    self.Track = track
    self.Callback = callback
    self.Theme = theme
    self.Decimals = 0
    self.Enabled = true
    return self
end

function SliderObject:Set(value, silent)
    if not self.Enabled then return end
    value = clamp(value, self.Min, self.Max)
    self.Value = value
    local pct = (value - self.Min) / (self.Max - self.Min)
    self.Fill.Size = UDim2.new(pct, 0, 1, 0)
    self.Knob.Position = UDim2.new(pct, -7, 0.5, -7)
    self.ValueLabel.Text = tostring(round(value, self.Decimals))
    if not silent and self.Callback then
        task.spawn(self.Callback, value)
    end
end

function SliderObject:Get()
    return self.Value
end

function SliderObject:SetDecimals(n)
    self.Decimals = n or 0
end

-- Dropdown option object
local DropdownOption = {}
DropdownOption.__index = DropdownOption

function DropdownOption.new(button, parentDropdown, text)
    local self = setmetatable({}, DropdownOption)
    self.Button = button
    self.Parent = parentDropdown
    self.Text = text
    return self
end

function DropdownOption:Remove()
    if self.Button then
        self.Button:Destroy()
        self.Button = nil
        if self.Parent and self.Parent._options then
            for i, opt in ipairs(self.Parent._options) do
                if opt == self then
                    table.remove(self.Parent._options, i)
                    break
                end
            end
        end
    end
end

-- Dropdown object
local DropdownObject = {}
DropdownObject.__index = DropdownObject

function DropdownObject.new(container, button, arrow, listFrame, listScroll, listLayout, theme, callback)
    local self = setmetatable({}, DropdownObject)
    self.Container = container
    self.Button = button
    self.Arrow = arrow
    self.ListFrame = listFrame
    self.ListScroll = listScroll
    self.ListLayout = listLayout
    self.Theme = theme
    self.Callback = callback
    self.Open = false
    self._options = {}
    self.Selected = nil
    return self
end

function DropdownObject:Add(text)
    local optBtn = Instance.new("TextButton")
    optBtn.Size = UDim2.new(1, -4, 0, 26)
    optBtn.BackgroundColor3 = self.Theme.Background2
    optBtn.BorderSizePixel = 0
    optBtn.Font = DEFAULT_FONT
    optBtn.TextSize = 13
    optBtn.TextColor3 = self.Theme.Text
    optBtn.Text = text
    optBtn.TextXAlignment = Enum.TextXAlignment.Left
    optBtn.AutoButtonColor = false
    optBtn.ZIndex = 12
    optBtn.Parent = self.ListScroll
    createCorner(optBtn, 4)
    createPadding(optBtn, 0, 0, 8, 4)

    optBtn.MouseEnter:Connect(function()
        tweenColor(optBtn, "BackgroundColor3", self.Theme.Accent, 0.1)
    end)
    optBtn.MouseLeave:Connect(function()
        tweenColor(optBtn, "BackgroundColor3", self.Theme.Background2, 0.1)
    end)

    local option = DropdownOption.new(optBtn, self, text)
    table.insert(self._options, option)

    optBtn.MouseButton1Click:Connect(function()
        self.Selected = text
        self.Button.Text = text
        self:Close()
        if self.Callback then
            task.spawn(self.Callback, text)
        end
    end)

    return option
end

function DropdownObject:OpenList()
    if self.Open then return end
    self.Open = true
    self.Arrow.Text = "▲"
    self.ListFrame.Visible = true
    local height = math.min(140, #self._options * 28 + 8)
    tween(self.ListFrame, {Size = UDim2.new(1, 0, 0, height)}, 0.18)
    self.Container.Size = UDim2.new(1, -8, 0, 32 + height + 8)
end

function DropdownObject:Close()
    if not self.Open then return end
    self.Open = false
    self.Arrow.Text = "▼"
    tween(self.ListFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.15).Completed:Connect(function()
        self.ListFrame.Visible = false
    end)
    self.Container.Size = UDim2.new(1, -8, 0, 32)
end

function DropdownObject:Toggle()
    if self.Open then self:Close() else self:OpenList() end
end

