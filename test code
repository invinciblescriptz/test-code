-- RIPPLE
---------------------------------------------------------------------------
local function ripple(button, x, y, color)
    task.spawn(function()
        if not button or not button.Parent then return end
        button.ClipsDescendants = true
        local circle = Create("ImageLabel", {
            Name = "Ripple",
            BackgroundTransparency = 1,
            Image = "rbxassetid://266543268",
            ImageColor3 = color or Color3.new(1, 1, 1),
            ImageTransparency = 0.55,
            Parent = button,
            ZIndex = 80,
        })
        local absPos  = button.AbsolutePosition
        local absSize = button.AbsoluteSize
        local nx = (x or absPos.X) - absPos.X
        local ny = (y or absPos.Y) - absPos.Y
        circle.Position = UDim2.fromOffset(nx, ny)
        local size = math.max(absSize.X, absSize.Y) * 1.7
        circle:TweenSizeAndPosition(
            UDim2.fromOffset(size, size),
            UDim2.new(0.5, -size / 2, 0.5, -size / 2),
            Enum.EasingDirection.Out,
            Enum.EasingStyle.Quad,
            0.42,
            true
        )
        Tween(circle, {ImageTransparency = 1}, 0.42)
        task.wait(0.45)
        if circle and circle.Parent then
            circle:Destroy()
        end
    end)
end

