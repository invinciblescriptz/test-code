local library = {}
local windowCount = 0
local binding = false

-- Global toggle key
UIS.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == ui_options.toggle_key and not binding then
		imgui.Enabled = not imgui.Enabled
	end
end)

function library:FormatWindows()
	-- simple re-layout helper if needed
end

function library:AddWindow(title, options)
	options = typeof(options) == "table" and options or ui_options
	options.main_color = options.main_color or ui_options.main_color
	options.min_size = options.min_size or ui_options.min_size
	options.can_resize = options.can_resize ~= false
	options.tween_time = options.tween_time or ui_options.tween_time

	windowCount += 1
	local zBase = windowCount * 20

	local window = Prefabs.Window:Clone()
	window.Parent = Windows
	window.Title.Text = tostring(title or "Window")
	window.Size = UDim2.fromOffset(options.min_size.X, options.min_size.Y)
	window.ZIndex = zBase
	window.Draggable = true

	-- Apply theme color
	local function applyTheme(color)
		window.Bar.BackgroundColor3 = color
		window.TabSelection.Underline.BackgroundColor3 = color
	end
	applyTheme(options.main_color)

	local windowData = {}
	local open = true
	local dropdownOpen = false

	-- Resize
	do
		local resizer = window.Resizer
		local holding = false
		local entered = false

		resizer.MouseEnter:Connect(function()
			entered = true
			window.Draggable = false
		end)
		resizer.MouseLeave:Connect(function()
			entered = false
			window.Draggable = true
		end)

		UIS.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 and entered and options.can_resize then
				holding = true
				task.spawn(function()
					while holding do
						local m = getMouse()
						local x = math.max(options.min_size.X, m.X - window.AbsolutePosition.X)
						local y = math.max(options.min_size.Y, m.Y - window.AbsolutePosition.Y)
						tween(window, { Size = UDim2.fromOffset(x, y) }, 0.05)
						RunService.Heartbeat:Wait()
					end
				end)
			end
		end)
		UIS.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				holding = false
			end
		end)
	end

	-- Collapse
	do
		local toggleBtn = window.Bar.Toggle
		local oldHeight = window.AbsoluteSize.Y

		toggleBtn.MouseButton1Click:Connect(function()
			open = not open
			if open then
				tween(toggleBtn, { Rotation = 90 })
				tween(window, { Size = UDim2.fromOffset(window.AbsoluteSize.X, oldHeight) })
				window.Tabs.Visible = true
				window.TabSelection.Visible = window.TabSelection.TabButtons:FindFirstChildOfClass("TextButton") ~= nil
				window.Resizer.Active = true
			else
				oldHeight = window.AbsoluteSize.Y
				tween(toggleBtn, { Rotation = 0 })
				tween(window, { Size = UDim2.fromOffset(window.AbsoluteSize.X, 28) })
				window.Tabs.Visible = false
				window.TabSelection.Visible = false
				window.Resizer.Active = false
			end
		end)
	end

	-- Tabs
	function windowData:AddTab(name)
		name = tostring(name or "Tab")
		window.TabSelection.Visible = true

		local tabBtn = Instance.new("TextButton")
		tabBtn.Name = name
		tabBtn.BackgroundTransparency = 1
		tabBtn.Size = UDim2.fromOffset(80, 24)
		tabBtn.Font = Enum.Font.Gotham
		tabBtn.TextSize = 13
		tabBtn.Text = name
		tabBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
		tabBtn.AutoButtonColor = false
		tabBtn.Parent = window.TabSelection.TabButtons
		tabBtn.Size = UDim2.fromOffset(textWidth(tabBtn), 24)

		local tab = Prefabs.Tab:Clone()
		tab.Parent = window.Tabs
		tab.Visible = false

		local function show()
			if dropdownOpen then return end
			for _, child in window.Tabs:GetChildren() do
				if child:IsA("ScrollingFrame") then
					child.Visible = false
				end
			end
			for _, btn in window.TabSelection.TabButtons:GetChildren() do
				if btn:IsA("TextButton") then
					btn.TextColor3 = Color3.fromRGB(160, 160, 160)
				end
			end
			tab.Visible = true
			tabBtn.TextColor3 = Color3.new(1, 1, 1)
		end

		tabBtn.MouseButton1Click:Connect(show)

		-- Auto-select first tab
		if #window.Tabs:GetChildren() == 1 then
			show()
		end

		local tabData = {}

		----------------------------------------------------------------
		-- Elements
		----------------------------------------------------------------

		function tabData:AddLabel(text)
			local label = Prefabs.Label:Clone()
			label.Text = tostring(text or "Label")
			label.Size = UDim2.fromOffset(textWidth(label), 20)
			label.Parent = tab
			return label
		end

		function tabData:AddButton(text, callback)
			callback = typeof(callback) == "function" and callback or function() end
			local btn = Prefabs.Button:Clone()
			btn.Text = "  " .. tostring(text or "Button")
			btn.Size = UDim2.fromOffset(textWidth(btn) + 12, 26)
			btn.Parent = tab
			btn.Round.ImageColor3 = options.main_color

			btn.MouseButton1Click:Connect(function()
				ripple(btn, Mouse.X, Mouse.Y)
				task.spawn(callback)
			end)
			return btn
		end

		function tabData:AddSwitch(text, callback)
			callback = typeof(callback) == "function" and callback or function() end
			local sw = Prefabs.Switch:Clone()
			sw.Text = "  " .. tostring(text or "Switch")
			sw.Parent = tab

			local toggled = false
			local box = sw.Box
			local knob = box.Knob

			local function set(state)
				toggled = state and true or false
				tween(knob, {
					Position = toggled and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2)
				}, 0.15)
				box.BackgroundColor3 = toggled and options.main_color or Color3.fromRGB(40, 40, 45)
				task.spawn(callback, toggled)
			end

			sw.MouseButton1Click:Connect(function()
				set(not toggled)
			end)

			return { Set = set }, sw
		end

		function tabData:AddTextBox(placeholder, callback, opts)
			callback = typeof(callback) == "function" and callback or function() end
			opts = typeof(opts) == "table" and opts or { clear = true }

			local tb = Prefabs.TextBox:Clone()
			tb.PlaceholderText = tostring(placeholder or "Text...")
			tb.Parent = tab

			tb.FocusLost:Connect(function(enter)
				if enter and #tb.Text > 0 then
					task.spawn(callback, tb.Text)
					if opts.clear then
						tb.Text = ""
					end
				end
			end)
			return tb
		end

		function tabData:AddSlider(text, callback, opts)
			callback = typeof(callback) == "function" and callback or function() end
			opts = typeof(opts) == "table" and opts or {}
			local min = opts.min or 0
			local max = opts.max or 100
			local readonly = opts.readonly or false

			local slider = Prefabs.Slider:Clone()
			slider.Title.Text = tostring(text or "Slider")
			slider.Parent = tab

			local fill = slider.Track.Fill
			local valueLabel = slider.Value
			local holding = false
			local entered = false

			local function set(val)
				val = math.clamp(tonumber(val) or min, min, max)
				local pct = (val - min) / (max - min)
				tween(fill, { Size = UDim2.new(pct, 0, 1, 0) }, 0.08)
				valueLabel.Text = tostring(math.floor(val + 0.5))
				task.spawn(callback, val)
			end

			slider.MouseEnter:Connect(function()
				entered = true
				window.Draggable = false
			end)
			slider.MouseLeave:Connect(function()
				entered = false
				window.Draggable = true
			end)

			UIS.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 and entered and not readonly then
					holding = true
					task.spawn(function()
						while holding do
							local rel = (getMouse().X - slider.Track.AbsolutePosition.X) / slider.Track.AbsoluteSize.X
							rel = math.clamp(rel, 0, 1)
							local val = min + (max - min) * rel
							set(val)
							RunService.Heartbeat:Wait()
						end
					end)
				end
			end)
			UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					holding = false
				end
			end)

			set(min)
			return { Set = set }, slider
		end

		function tabData:AddKeybind(name, callback, opts)
			callback = typeof(callback) == "function" and callback or function() end
			opts = typeof(opts) == "table" and opts or {}
			local current = opts.standard or Enum.KeyCode.RightShift

			local kb = Prefabs.Keybind:Clone()
			kb.Title.Text = tostring(name or "Keybind")
			kb.Parent = tab
			kb.Size = UDim2.fromOffset(textWidth(kb.Title) + 100, 26)

			local short = {
				RightControl = "RCtrl", LeftControl = "LCtrl",
				LeftShift = "LShift", RightShift = "RShift",
				MouseButton1 = "M1", MouseButton2 = "M2",
			}

			local function setKey(key)
				current = key
				kb.Input.Text = short[key.Name] or key.Name
			end
			setKey(current)

			UIS.InputBegan:Connect(function(input, gpe)
				if binding or gpe then return end
				if input.KeyCode == current then
					task.spawn(callback, current)
				end
			end)

			kb.Input.MouseButton1Click:Connect(function()
				if binding then return end
				binding = true
				kb.Input.Text = "..."
				local input = UIS.InputBegan:Wait()
				if input.KeyCode ~= Enum.KeyCode.Unknown then
					setKey(input.KeyCode)
				end
				binding = false
			end)

			return { SetKeybind = setKey }, kb
		end

		function tabData:AddDropdown(name, callback)
			callback = typeof(callback) == "function" and callback or function() end

			local dd = Prefabs.Dropdown:Clone()
			dd.Text = "  " .. tostring(name or "Dropdown")
			dd.Parent = tab

			local box = dd.Box
			local objects = box.Objects
			local open = false

			local function toggle()
				open = not open
				dropdownOpen = open
				box.Visible = open
				if open then
					local count = math.min(#objects:GetChildren() - 1, 8)
					tween(box, { Size = UDim2.new(1, 0, 0, count * 24 + 4) })
					tween(dd.Indicator, { Rotation = 90 })
				else
					tween(box, { Size = UDim2.new(1, 0, 0, 0) })
					tween(dd.Indicator, { Rotation = -90 })
				end
			end

			dd.MouseButton1Click:Connect(toggle)

			local data = {}
			function data:Add(itemName)
				itemName = tostring(itemName or "Item")
				local item = Prefabs.DropdownButton:Clone()
				item.Text = "  " .. itemName
				item.Parent = objects

				item.MouseEnter:Connect(function()
					item.BackgroundColor3 = options.main_color
				end)
				item.MouseLeave:Connect(function()
					item.BackgroundColor3 = Color3.fromRGB(28, 29, 32)
				end)

				item.MouseButton1Click:Connect(function()
					dd.Text = "  [ " .. itemName .. " ]"
					toggle()
					task.spawn(callback, itemName)
				end)

				return item
			end

			return data, dd
		end

		function tabData:AddColorPicker(callback)
			callback = typeof(callback) == "function" and callback or function() end
			local cp = Prefabs.ColorPicker:Clone()
			cp.Parent = tab

			local h, s, v = 0, 1, 1
			local function update()
				local color = Color3.fromHSV(h, s, v)
				cp.Sample.BackgroundColor3 = color
				cp.Saturation.ImageColor3 = Color3.fromHSV(h, 1, 1)
				task.spawn(callback, color)
			end
			update()

			-- Simple click handling for palette / saturation
			local function bind(img, isSat)
				local holding = false
				img.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						holding = true
						window.Draggable = false
					end
				end)
				img.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						holding = false
						window.Draggable = true
					end
				end)
				RunService.Heartbeat:Connect(function()
					if not holding then return end
					local rel = getMouse() - img.AbsolutePosition
					if isSat then
						v = 1 - math.clamp(rel.Y / img.AbsoluteSize.Y, 0, 1)
					else
						h = math.clamp(rel.X / img.AbsoluteSize.X, 0, 1)
						s = 1 - math.clamp(rel.Y / img.AbsoluteSize.Y, 0, 1)
					end
					update()
				end)
			end
			bind(cp.Palette, false)
			bind(cp.Saturation, true)

			return {
				Set = function(_, color)
					if typeof(color) == "Color3" then
						h, s, v = rgbToHsv(color.R * 255, color.G * 255, color.B * 255)
						update()
					end
				end
			}, cp
		end

		function tabData:AddConsole(opts)
			opts = typeof(opts) == "table" and opts or {}
			local height = opts.y or 180
			local readonly = opts.readonly ~= false

			local console = Prefabs.Console:Clone()
			console.Size = UDim2.new(1, 0, 0, height)
			console.Parent = tab

			local source = console.Scroll.Source
			local lines = console.Scroll.Lines
			source.TextEditable = not readonly

			local function refreshLines()
				local count = 1
				for _ in source.Text:gmatch("\n") do
					count += 1
				end
				local t = ""
				for i = 1, count do
					t ..= i .. "\n"
				end
				lines.Text = t
				console.Scroll.CanvasSize = UDim2.fromOffset(0, count * 16)
			end

			source:GetPropertyChangedSignal("Text"):Connect(refreshLines)
			refreshLines()

			return {
				Set = function(_, code) source.Text = tostring(code) end,
				Get = function() return source.Text end,
				Log = function(_, msg)
					source.Text ..= "[*] " .. tostring(msg) .. "\n"
				end,
			}, console
		end

		function tabData:AddHorizontalAlignment()
			local ha = Prefabs.HorizontalAlignment:Clone()
			ha.Parent = tab
			local data = {}
			function data:AddButton(...)
				local btn = tabData:AddButton(...)
				btn.Parent = ha
				return btn
			end
			return data, ha
		end

		function tabData:AddFolder(name)
			local folder = Prefabs.Folder:Clone()
			folder.Button.Text = "     " .. tostring(name or "Folder")
			folder.Parent = tab
			folder.Button.Round.ImageColor3 = options.main_color

			local open = false
			local objects = folder.Objects

			folder.Button.MouseButton1Click:Connect(function()
				open = not open
				objects.Visible = open
				tween(folder.Button.Arrow, { Rotation = open and 90 or 0 })
				-- auto size
				local h = 26
				if open then
					for _, child in objects:GetChildren() do
						if not child:IsA("UIListLayout") then
							h += child.AbsoluteSize.Y + 5
						end
					end
				end
				tween(folder, { Size = UDim2.new(1, 0, 0, h) })
			end)

			-- proxy methods
			local folderData = {}
			for k, v in tabData do
				folderData[k] = function(_, ...)
					local res = { v(...) }
					local obj = res[2] or res[1]
					if typeof(obj) == "Instance" then
						obj.Parent = objects
					end
					return table.unpack(res)
				end
			end
			return folderData, folder
		end

		return tabData, tab
	end

	return windowData, window
end

return library
