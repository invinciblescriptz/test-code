    self.Tooltip.Visible = false
end

function TooltipManager:Attach(object, text)
    object.MouseEnter:Connect(function()
        local pos = UIS:GetMouseLocation()
        self:Show(text, pos.X, pos.Y)
    end)
    object.MouseLeave:Connect(function()
        self:Hide()
    end)
    object.MouseMoved:Connect(function()
        if self.Tooltip.Visible then
            local pos = UIS:GetMouseLocation()
            self.Tooltip.Position = UDim2.new(0, pos.X + 12, 0, pos.Y + 12)
        end
    end)
end

