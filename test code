	local Content = Create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, DefaultOptions.title_bar_height),
		Size = UDim2.new(1, 0, 1, -DefaultOptions.title_bar_height),
		ClipsDescendants = true,
		ZIndex = zBase + 1,
		Parent = Window,
	})

	-- Resize handle
	local Resizer = Create("Frame", {
		Name = "Resizer",
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.fromOffset(16, 16),
		ZIndex = zBase + 10,
		Visible = canResize,
		Parent = Window,
	})

	if canResize then
		local resizing = false
		local startSize, startMouse

		Resizer.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				resizing = true
				startSize = Window.AbsoluteSize
				startMouse = UserInputService:GetMouseLocation()
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				resizing = false
			end
		end)

		RunService.RenderStepped:Connect(function()
			if resizing then
				local mouse = UserInputService:GetMouseLocation()
				local newX = math.max(minSize.X, startSize.X + (mouse.X - startMouse.X))
				local newY = math.max(minSize.Y, startSize.Y + (mouse.Y - startMouse.Y))
				Window.Size = UDim2.fromOffset(newX, newY)
			end
		end)
	end

