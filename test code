function TabObject:AddSearchBox(placeholder)
    local theme = self.Theme
    local cont, box = Prefabs.CreateTextBox(placeholder or "Search...", theme)
    addElementToContainer(self.Content, cont)

    box:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(box.Text)
        for _, child in ipairs(self.Content:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextButton") or child:IsA("TextLabel") then
                if child.Name == "TextBox" or child == cont then
                    -- keep search box visible
                else
                    local textContent = ""
                    for _, desc in ipairs(child:GetDescendants()) do
                        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                            textContent = textContent .. " " .. string.lower(desc.Text)
                        end
                    end
                    if query == "" or string.find(textContent, query, 1, true) then
                        child.Visible = true
                    else
                        child.Visible = false
                    end
                end
            end
        end
    end)

    return box
end

