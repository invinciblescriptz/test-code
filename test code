local function safeCall(fn, ...)
    local ok, result = pcall(fn, ...)
    if not ok then
        warn("[EleriumUI] Error:", result)
    end
    return ok, result
end

local function debounce(fn, delay)
    local last = 0
    return function(...)
        local now = tick()
        if now - last >= (delay or 0.15) then
            last = now
            return fn(...)
        end
    end
end

local function throttle(fn, interval)
    local last = 0
    local pending = nil
    return function(...)
        local now = tick()
        if now - last >= interval then
            last = now
            return fn(...)
        else
            pending = {...}
            task.delay(interval - (now - last), function()
                if pending then
                    last = tick()
                    fn(unpack(pending))
                    pending = nil
                end
            end)
        end
    end
end

-- Simple signal / event implementation
local Signal = {}
Signal.__index = Signal

function Signal.new()
    return setmetatable({_handlers = {}}, Signal)
end

function Signal:Connect(fn)
    local id = generateId()
    self._handlers[id] = fn
    return {
        Disconnect = function()
            self._handlers[id] = nil
        end,
    }
end

function Signal:Fire(...)
    for _, fn in pairs(self._handlers) do
        task.spawn(fn, ...)
    end
end

function Signal:Destroy()
    self._handlers = {}
end

Library.Signal = Signal

-- Simple state container
local State = {}
State.__index = State

function State.new(initial)
    local self = setmetatable({
        _value = initial,
        _changed = Signal.new(),
    }, State)
    return self
end

function State:Get()
    return self._value
end

function State:Set(value)
    if self._value ~= value then
        self._value = value
        self._changed:Fire(value)
    end
end

function State:OnChanged(fn)
    return self._changed:Connect(fn)
end

Library.State = State

