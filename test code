				btn.TextSize = 14
				btn.TextColor3 = Color3.fromRGB(200, 200, 200)
				btn.Text = "  " .. name
				btn.TextXAlignment = Enum.TextXAlignment.Left
				btn.ZIndex = zoff + 12
				btn.Parent = list

				btn.MouseButton1Click:Connect(function()
					selected = name
					main.Text = "      " .. name
					toggle()
					pcall(callback, name)
				end)

				table.insert(items, {Name = name, Button = btn})
				return {
					Remove = function()
						btn:Destroy()
						for i, v in ipairs(items) do
							if v.Name == name then
								table.remove(items, i)
								break
							end
						end
					end
				}
			end

			return dropdown_data
		end

