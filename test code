function Tab:AddSlider(text, callback, options)
	options = options or {}
	local min = options.min or 0
	local max = options.max or 100
	local default = options.default or min
	local readonly = options.readonly or false
	callback = callback or function() end

	local value = default
	local frame = createElementBase(self, 42)

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, -60, 0, 18)
	label.Position = UDim2.fromOffset(10, 2)
	label.Font = self.Window.Theme.font
	label.Text = text or "Slider"
	label.TextColor3 = self.Window.Theme.text_color
	label.TextSize = self.Window.Theme.font_size
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.ZIndex = 13
	label.Parent = frame

	local valueLabel = Instance.new("TextLabel")
	valueLabel.BackgroundTransparency = 1
	valueLabel.Size = UDim2.fromOffset(50, 18)
	valueLabel.Position = UDim2.new(1, -55, 0, 2)
	valueLabel.Font = self.Window.Theme.font
	valueLabel.Text = tostring(round(value, 1))
	valueLabel.TextColor3 = self.Window.Theme.dim_text
	valueLabel.TextSize = self.Window.Theme.font_size
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.ZIndex = 13
	valueLabel.Parent = frame

	local track = Instance.new("Frame")
	track.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
	track.BorderSizePixel = 0
	track.Size = UDim2.new(1, -20, 0, 6)
	track.Position = UDim2.fromOffset(10, 28)
	track.ZIndex = 13
	track.Parent = frame
	makeCorner(track, 3)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = self.Window.Theme.main_color
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale((value - min) / (max - min), 1)
	fill.ZIndex = 14
	fill.Parent = track
	makeCorner(fill, 3)

	local knob = Instance.new("Frame")
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.Size = UDim2.fromOffset(12, 12)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.fromScale((value - min) / (max - min), 0.5)
	knob.ZIndex = 15
	knob.Parent = track
	makeCorner(knob, 6)

	local function setValue(v, fire)
		value = clamp(v, min, max)
		local pct = (value - min) / (max - min)
		fill.Size = UDim2.fromScale(pct, 1)
		knob.Position = UDim2.fromScale(pct, 0.5)
		valueLabel.Text = tostring(round(value, 1))
		if fire ~= false then
			task.spawn(callback, value)
		end
	end

	if not readonly then
		local sliding = false
		track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = true
				local rel = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
				setValue(min + rel * (max - min))
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = false
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local rel = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
				setValue(min + clamp(rel, 0, 1) * (max - min))
			end
		end)
	end

	local obj = {
		Frame = frame,
		Get = function() return value end,
		Set = function(_, v)
			setValue(v, true)
		end,
		SetSilent = function(_, v)
			setValue(v, false)
		end
	}
	return self:_addElement(obj)
end

