function Elements.Spinner(parent, options)
	options = options or {}
	local size = options.Size or 24

	local frame = Instance.new("Frame")
	frame.Name = "Spinner"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromOffset(size, size)
	frame.Parent = parent

	local ring = Instance.new("ImageLabel")
	ring.BackgroundTransparency = 1
	ring.Size = UDim2.fromScale(1, 1)
	ring.Image = "rbxassetid://4965945816"
	ring.ImageColor3 = options.Color or Library.Theme.MainColor
	ring.Parent = frame

	local spinning = true
	task.spawn(function()
		while spinning and ring and ring.Parent do
			ring.Rotation = (ring.Rotation + 6) % 360
			task.wait(0.03)
		end
	end)

	local api = {}
	function api:Stop()
		spinning = false
	end
	function api:Destroy()
		spinning = false
		frame:Destroy()
	end
	return api, frame
end

