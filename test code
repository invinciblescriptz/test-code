function Library:FormatWindows()
	local count = #self.Windows
	if count == 0 then return end
	local spacing = 20
	local startX = 40
	for i, win in ipairs(self.Windows) do
		win.Main.Position = UDim2.fromOffset(startX + (i - 1) * (win.Theme.min_size.X + spacing), 80)
		win.Main.AnchorPoint = Vector2.new(0, 0)
	end
end

function Library:SetTheme(partial)
	for k, v in pairs(partial) do
		self.Theme[k] = v
	end
end

function Library:Toggle()
	self.Open = not self.Open
	ScreenGui.Enabled = self.Open
end

function Library:Destroy()
	ScreenGui:Destroy()
	for _, c in ipairs(self.Connections) do
		c:Disconnect()
	end
	self.Windows = {}
end

-- Global toggle key
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Library.Theme.toggle_key then
