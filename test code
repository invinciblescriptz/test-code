function Library:CreateKeybindList()
	local listFrame = Create("Frame", {
		Name = "KeybindList",
		BackgroundColor3 = Color3.fromRGB(22, 22, 22),
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 180, 0, 30),
		Position = UDim2.new(0, 12, 0.5, -50),
		ZIndex = 70,
		Parent = EleriumUI,
	})
	Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = listFrame })
	local layout = Create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 2),
		Parent = listFrame,
	})
	Create("UIPadding", {
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
		Parent = listFrame,
	})

	local api = {}
	function api:Add(name, key)
		local row = Create("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 18),
			Font = ui_options.font,
			Text = name .. "  [" .. (typeof(key) == "EnumItem" and key.Name or tostring(key)) .. "]",
			TextColor3 = Color3.fromRGB(200, 200, 200),
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = listFrame,
		})
		listFrame.Size = UDim2.new(0, 180, 0, layout.AbsoluteContentSize.Y + 12)
		return row
	end
	function api:Clear()
		for _, c in ipairs(listFrame:GetChildren()) do
			if c:IsA("TextLabel") then c:Destroy() end
		end
		listFrame.Size = UDim2.new(0, 180, 0, 30)
	end
	function api:Destroy()
		listFrame:Destroy()
	end
	MakeDraggable(listFrame)
	return api
end

-- Final return
return setmetatable(Library, {
	__index = Library,
	__call = function(self)
		return self
	end,
})
