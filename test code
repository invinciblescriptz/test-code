			layout.Parent = list

			local function toggle()
				open = not open
				drop.Visible = open
				arrow.Rotation = open and 0 or -90
				if open then
					local h = math.min(#items * 20, 120)
					drop.Size = UDim2.new(1, 0, 0, h)
					list.CanvasSize = UDim2.new(0, 0, 0, #items * 20)
				else
					drop.Size = UDim2.new(1, 0, 0, 0)
				end
			end

			main.MouseButton1Click:Connect(toggle)

			local dropdown_data = {}

			function dropdown_data:Add(name)
				local btn = Instance.new("TextButton")
				btn.BackgroundColor3 = Color3.fromRGB(33, 34, 36)
				btn.BorderSizePixel = 0
				btn.Size = UDim2.new(1, 0, 0, 20)
