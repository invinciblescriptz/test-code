-- Features: Auto Train All Stats, Teleports, Auto Farm, Anti-AFK, ESP

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

-- Remotes (adjust if game updates)
local Remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
local TrainRemote = Remotes and Remotes:FindFirstChild("RemoteEvent") or nil

-- Settings
local autoTrainEnabled = {}
local selectedStats = {"Strength", "Durability", "Chakra", "Sword", "Agility", "Speed"}
local trainDelay = 0.1
local antiAFK = true

-- Stat IDs
local STAT_ID = {
    Strength = 1, Durability = 2, Chakra = 3,
    Sword = 4, Agility = 5, Speed = 6
}

-- Training Spots (common high-level areas)
local TrainingSpots = {
    Strength = {"Workspace.Map.TrainingAreas.Meteor", "Workspace.Map.TrainingAreas.Arena.Part"},
    Durability = {"Workspace.Map.TrainingAreas.Pirate ship.Model", "Workspace.Map.TrainingAreas.BlackFire.Fire"},
    Chakra = {"Workspace.Map.TrainingAreas.Tree1.ObjectRoot", "Workspace.Map.TrainingAreas.Fox.Fox"},
    Agility = {"Workspace.Map.TrainingAreas.Trampoline.Bouncy"},
    Speed = {"Workspace.Map.TrainingAreas.Treadmills"},
    Sword = {"Workspace.Map.TrainingAreas.ExcaliburRocks.Model"}
}

local function getStatValue(statName)
    local statsFolder = player:FindFirstChild("Stats")
    if not statsFolder then return 0 end
    local id = STAT_ID[statName]
    local valObj = statsFolder:FindFirstChild(tostring(id))
    return valObj and valObj.Value or 0
end

local function teleportTo(partPath)
    local target = Workspace
    for _, folder in ipairs(partPath:split(".")) do
        target = target:FindFirstChild(folder)
        if not target then return false end
    end
    if target and target:IsA("BasePart") or target:FindFirstChildWhichIsA("BasePart") then
        local part = target:IsA("BasePart") and target or target:FindFirstChildWhichIsA("BasePart")
        hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
        return true
    end
    return false
end

-- Auto Train Loop
spawn(function()
    while true do
        if TrainRemote then
            for statName, enabled in pairs(autoTrainEnabled) do
                if enabled then
                    local id = STAT_ID[statName]
                    if id then
                        TrainRemote:FireServer("Train", id)
                    end
                end
            end
        end
        task.wait(trainDelay)
    end
end)

-- Anti-AFK
if antiAFK then
    spawn(function()
        while true do
            game:GetService("VirtualUser"):Button1Down(Vector2.new(0,0))
            game:GetService("VirtualUser"):Button1Up(Vector2.new(0,0))
            task.wait(60)
        end
    end)
end

