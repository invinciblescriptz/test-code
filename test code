    local last = tick()
    local frames = 0
    RunService.RenderStepped:Connect(function()
        frames = frames + 1
        if tick() - last >= 1 then
            fpsLabel.Text = tostring(frames) .. " FPS"
            frames = 0
            last = tick()
        end
    end)

    return {
        SetText = function(_, t) label.Text = t end,
        Destroy = function() screenGui:Destroy() end,
    }
end

