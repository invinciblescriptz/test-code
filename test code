-- ─── LABEL ───────────────────────────────────────────────────────────────────

function Elements.Label(parent, text, options)
	options = options or {}
	local frame = Instance.new("Frame")
	frame.Name = "Label"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.new(1, 0, 0, options.Height or 22)
	frame.Parent = parent

	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.Font = options.Bold and Library.Theme.FontBold or Library.Theme.Font
	lbl.TextSize = options.TextSize or 13
	lbl.TextColor3 = options.Color or Library.Theme.TextDim
	lbl.TextXAlignment = options.Align or Enum.TextXAlignment.Left
	lbl.Text = text or ""
	lbl.TextWrapped = options.Wrapped or false
	lbl.Parent = frame
	makePadding(lbl, 6, 0, 6, 0)

