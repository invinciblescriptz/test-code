-- Notifications
local function Notify(title, msg)
    Rayfield:Notify({Title = title, Content = msg, Duration = 4, Image = 4483362458})
end

-- Main Loop
task.spawn(function()
    while task.wait(0.3) do
        pcall(function()
            Character = LocalPlayer.Character
            if not Character then return end
            
            local Root = Character:FindFirstChild("HumanoidRootPart")
            local Hum = Character:FindFirstChild("Humanoid")
            
            if Hum then
                if getgenv().MLConfig.GodMode then
                    Hum.Health = 9e9
                    Hum.MaxHealth = 9e9
                end
                Hum.WalkSpeed = getgenv().MLConfig.WalkSpeed
            end
            
            -- Auto Train Logic (Muscle Legends specific patterns)
            if getgenv().MLConfig.AutoLift or getgenv().MLConfig.AutoPushups or getgenv().MLConfig.AutoSitups or getgenv().MLConfig.AutoPunch then
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") or obj.Name:find("Train") or obj.Name:find("Lift") or obj.Name:find("Push") then
                        if Root and (Root.Position - obj.Parent.Position).Magnitude < 15 then
                            fireproximityprompt(obj)
                        end
                    end
                end
                
                -- Remote fallback
                local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:FindFirstChild("Events")
                if remotes then
                    if remotes:FindFirstChild("Train") then
                        remotes.Train:FireServer("lift") -- common names
                    end
                end
            end
            
            -- Kill Aura
            if getgenv().MLConfig.KillAura then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = (Root.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                        if dist < getgenv().MLConfig.KillAuraRange then
                            plr.Character.Humanoid.Health = 0
                        end
                    end
                end
            end
            
            -- Auto Rebirth
            if getgenv().MLConfig.AutoRebirth then
                local strength = LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Strength")
                if strength and strength.Value >= getgenv().MLConfig.RebirthAt then
                    -- Rebirth remote (common in game)
                    if ReplicatedStorage:FindFirstChild("RebirthEvent") then
                        ReplicatedStorage.RebirthEvent:FireServer()
                    end
                    Notify("Rebirth", "Rebirthing at " .. strength.Value .. " strength!")
                end
            end
            
            -- Anti AFK
            if getgenv().MLConfig.AntiAFK then
                for _, conn in pairs(getconnections(LocalPlayer.Idled)) do
                    conn:Disable()
                end
            end
        end)
    end
end)

Notify("Success!", "Muscle Legends Script Loaded! Toggle features in the GUI.")
