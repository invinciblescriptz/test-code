-- Smooth fade for windows
function Library:FadeWindow(window, visible, duration)
	duration = duration or 0.25
	if not window or not window.Frame then return end
	local frame = window.Frame
	if visible then
		frame.Visible = true
		frame.ImageTransparency = 1
		local bar = frame:FindFirstChild("Bar")
		local body = frame:FindFirstChild("Body")
		if bar then bar.BackgroundTransparency = 1 end
		if body then body.BackgroundTransparency = 1 end
		Tween(frame, { ImageTransparency = 0 }, duration)
		if bar then Tween(bar, { BackgroundTransparency = 0 }, duration) end
		if body then Tween(body, { BackgroundTransparency = ui_options.background_transparency }, duration) end
		window.Visible = true
	else
		Tween(frame, { ImageTransparency = 1 }, duration)
		local bar = frame:FindFirstChild("Bar")
		local body = frame:FindFirstChild("Body")
		if bar then Tween(bar, { BackgroundTransparency = 1 }, duration) end
		if body then Tween(body, { BackgroundTransparency = 1 }, duration) end
		task.delay(duration, function()
			frame.Visible = false
			window.Visible = false
		end)
	end
end

-- Particle effect on window open (classic Elerium flair)
function Library:PlayOpenEffect(window)
	if not window or not window.Frame then return end
	local frame = window.Frame
	for i = 1, 12 do
		local p = Create("Frame", {
			BackgroundColor3 = window.MainColor or ui_options.main_color,
			BorderSizePixel = 0,
			Size = UDim2.new(0, 4, 0, 4),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			ZIndex = 60,
			Parent = frame,
		})
		Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = p })
		local angle = (i / 12) * math.pi * 2
		local dist = math.random(40, 90)
		local target = UDim2.new(0.5, math.cos(angle) * dist, 0.5, math.sin(angle) * dist)
		Tween(p, {
			Position = target,
			BackgroundTransparency = 1,
			Size = UDim2.new(0, 1, 0, 1),
		}, 0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.delay(0.5, function()
			p:Destroy()
		end)
	end
end

