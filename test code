local function createTab(window, title, tabButtonParent, contentParent)
	local tabBtn = Instance.new("TextButton")
	tabBtn.Name = title
	tabBtn.BackgroundColor3 = Library.Theme.Background
	tabBtn.BackgroundTransparency = 1
	tabBtn.BorderSizePixel = 0
	tabBtn.Size = UDim2.fromOffset(0, 26)
	tabBtn.AutomaticSize = Enum.AutomaticSize.X
	tabBtn.Font = Library.Theme.FontMedium
	tabBtn.TextSize = 13
	tabBtn.TextColor3 = Library.Theme.TextDim
	tabBtn.Text = "  " .. title .. "  "
	tabBtn.AutoButtonColor = false
	tabBtn.Parent = tabButtonParent
	makeCorner(tabBtn, 3)

	local indicator = Instance.new("Frame")
	indicator.Name = "Indicator"
	indicator.BackgroundColor3 = Library.Theme.MainColor
	indicator.BorderSizePixel = 0
	indicator.Size = UDim2.new(1, 0, 0, 2)
	indicator.Position = UDim2.new(0, 0, 1, -2)
	indicator.Visible = false
	indicator.Parent = tabBtn

	local page = Instance.new("ScrollingFrame")
	page.Name = title
	page.BackgroundTransparency = 1
	page.Size = UDim2.fromScale(1, 1)
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.ScrollBarThickness = 3
	page.ScrollBarImageColor3 = Library.Theme.Scrollbar
	page.BorderSizePixel = 0
	page.Visible = false
	page.Parent = contentParent
	makePadding(page, 5, 5, 5, 5)

	local pageLayout = makeList(page, 4)
	pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		page.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 12)
	end)

	local tabApi = {
		_button = tabBtn,
		_page = page,
		_indicator = indicator,
	}

	function tabApi:Show()
		for _, child in ipairs(contentParent:GetChildren()) do
			if child:IsA("ScrollingFrame") then
				child.Visible = false
			end
		end
		for _, child in ipairs(tabButtonParent:GetChildren()) do
			if child:IsA("TextButton") then
				child.TextColor3 = Library.Theme.TextDim
				local ind = child:FindFirstChild("Indicator")
				if ind then ind.Visible = false end
			end
		end
		page.Visible = true
		tabBtn.TextColor3 = Library.Theme.Text
		indicator.Visible = true
	end

	tabBtn.MouseButton1Click:Connect(function()
		tabApi:Show()
	end)

	tabBtn.MouseEnter:Connect(function()
		if not page.Visible then
			Util.Tween(tabBtn, {BackgroundTransparency = 0.6}, 0.1)
		end
	end)
	tabBtn.MouseLeave:Connect(function()
		Util.Tween(tabBtn, {BackgroundTransparency = 1}, 0.1)
	end)

	function tabApi:AddLabel(t, opts) return Elements.Label(page, t, opts) end
	function tabApi:AddButton(t, cb, opts) return Elements.Button(page, t, cb, opts) end
	function tabApi:AddSwitch(t, cb, opts) return Elements.Switch(page, t, cb, opts) end
	function tabApi:AddSlider(t, cb, opts) return Elements.Slider(page, t, cb, opts) end
	function tabApi:AddTextBox(t, cb, opts) return Elements.TextBox(page, t, cb, opts) end
	function tabApi:AddDropdown(t, cb, opts) return Elements.Dropdown(page, t, cb, opts) end
	function tabApi:AddCheckbox(t, cb, opts) return Elements.Checkbox(page, t, cb, opts) end
	function tabApi:AddParagraph(t, opts) return Elements.Paragraph(page, t, opts) end
	function tabApi:AddSeparator(opts) return Elements.Separator(page, opts) end
	function tabApi:AddFolder(t) return createFolder(page, t) end

	return tabApi
end

