-- CONFIG SYSTEM
----------------------------------------------------------------
local ConfigSystem = {}

function ConfigSystem.GetPath()
    return State.Theme.ConfigFolder
end

function ConfigSystem.Save(name)
    name = name or "default"
    local data = {}
    for flag, value in pairs(State.Flags) do
        if typeof(value) == "Color3" then
            data[flag] = { Type = "Color3", R = value.R, G = value.G, B = value.B }
        elseif typeof(value) == "EnumItem" then
            data[flag] = { Type = "Enum", EnumType = tostring(value.EnumType), Name = value.Name }
        else
            data[flag] = value
        end
    end
    local success, encoded = pcall(HttpService.JSONEncode, HttpService, data)
    if success then
        if writefile then
            writefile(ConfigSystem.GetPath() .. "/" .. name .. ".json", encoded)
            Notification.Show({ Title = "Config", Content = "Saved: " .. name, Type = "Success" })
            return true
        end
    end
    return false
end

function ConfigSystem.Load(name)
    name = name or "default"
    if not isfile or not isfile(ConfigSystem.GetPath() .. "/" .. name .. ".json") then
        return false
    end
    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile(ConfigSystem.GetPath() .. "/" .. name .. ".json"))
    end)
    if not success then return false end

    for flag, value in pairs(data) do
        if typeof(value) == "table" and value.Type == "Color3" then
            State.Flags[flag] = Color3.new(value.R, value.G, value.B)
        elseif typeof(value) == "table" and value.Type == "Enum" then
            State.Flags[flag] = Enum[value.EnumType][value.Name]
        else
            State.Flags[flag] = value
        end
    end
    Notification.Show({ Title = "Config", Content = "Loaded: " .. name, Type = "Success" })
    return true
end

function ConfigSystem.SetFlag(flag, value)
    State.Flags[flag] = value
    if State.Theme.AutoSaveConfig then
        ConfigSystem.Save()
    end
end

function ConfigSystem.GetFlag(flag, default)
    return State.Flags[flag] ~= nil and State.Flags[flag] or default
end

