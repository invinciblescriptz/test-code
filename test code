Library.CurrentTheme = Library.Themes.Default

function Library:SetTheme(themeName)
    if type(themeName) == "string" and self.Themes[themeName] then
        self.CurrentTheme = self.Themes[themeName]
    elseif type(themeName) == "table" then
        self.CurrentTheme = themeName
    end
    -- Theme change event can be fired here for live updates
end

function Library:GetTheme()
    return self.CurrentTheme
end

function Library:CreateCustomTheme(name, colorTable)
    self.Themes[name] = colorTable
end

