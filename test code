---------------------------------------------------------------------------
-- UTILITY FUNCTIONS
---------------------------------------------------------------------------
local function deepCopy(t)
    if type(t) ~= "table" then return t end
    local n = {}
    for k, v in pairs(t) do
        n[k] = deepCopy(v)
    end
    return n
end

local function Tween(obj, props, time, style, dir)
    time  = time  or ui_options.tween_time
    style = style or Enum.EasingStyle.Quad
    dir   = dir   or Enum.EasingDirection.Out
    local tw = TweenService:Create(obj, TweenInfo.new(time, style, dir), props)
    tw:Play()
    return tw
end

local function Create(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    return inst
end

local function Roundify(parent, radius)
    radius = radius or ui_options.corner_radius
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = parent
    return c
end

local function Stroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or ui_options.border
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.4
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function Padding(parent, t, r, b, l)
    local p = Instance.new("UIPadding")
    p.PaddingTop    = UDim.new(0, t or 0)
    p.PaddingRight  = UDim.new(0, r or 0)
    p.PaddingBottom = UDim.new(0, b or 0)
    p.PaddingLeft   = UDim.new(0, l or 0)
    p.Parent = parent
    return p
end

local function ListLayout(parent, dir, pad, hAlign, vAlign)
    local l = Instance.new("UIListLayout")
    l.FillDirection       = dir or Enum.FillDirection.Vertical
    l.Padding             = UDim.new(0, pad or 6)
    l.SortOrder           = Enum.SortOrder.LayoutOrder
    l.HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left
    l.VerticalAlignment   = vAlign or Enum.VerticalAlignment.Top
    l.Parent = parent
    return l
end

local function GridLayout(parent, cellSize, pad)
    local g = Instance.new("UIGridLayout")
    g.CellSize = cellSize or UDim2.new(0, 80, 0, 28)
    g.CellPadding = UDim2.new(0, pad or 6, 0, pad or 6)
    g.SortOrder = Enum.SortOrder.LayoutOrder
    g.Parent = parent
    return g
end

local function hasprop(object, prop)
    local ok, _ = pcall(function() return object[tostring(prop)] end)
    return ok
end

local function gNameLen(obj)
    return obj.TextBounds.X + 20
end

local function gMouse()
    local loc = UIS:GetMouseLocation()
    local inset = GuiService:GetGuiInset()
    return Vector2.new(loc.X, loc.Y - inset.Y)
end

local function rgbtohsv(r, g, b)
    r, g, b = r / 255, g / 255, b / 255
    local max, min = math.max(r, g, b), math.min(r, g, b)
    local h, s, v = 0, 0, max
    local d = max - min
    s = max == 0 and 0 or d / max
    if max ~= min then
        if max == r then
            h = (g - b) / d + (g < b and 6 or 0)
        elseif max == g then
            h = (b - r) / d + 2
        else
            h = (r - g) / d + 4
        end
        h = h / 6
    end
    return h, s, v
end

local function ColorToHex(c)
    return string.format("#%02X%02X%02X",
        math.floor(c.R * 255 + 0.5),
        math.floor(c.G * 255 + 0.5),
        math.floor(c.B * 255 + 0.5))
end

local function HexToColor(hex)
    hex = tostring(hex or ""):gsub("#", "")
    if #hex ~= 6 then return Color3.new(1, 1, 1) end
    local r = tonumber(hex:sub(1, 2), 16) or 255
    local g = tonumber(hex:sub(3, 4), 16) or 255
    local b = tonumber(hex:sub(5, 6), 16) or 255
    return Color3.fromRGB(r, g, b)
end

local function clamp(n, a, b)
    return math.max(a, math.min(b, n))
end

local function lerp(a, b, t)
    return a + (b - a) * t
end

local function round(n, places)
    places = places or 0
    local m = 10 ^ places
    return math.floor(n * m + 0.5) / m
end

local function makeShadow(parent, offset, transparency)
    if not ui_options.shadow then return end
    offset = offset or ui_options.shadow_offset
    transparency = transparency or ui_options.shadow_transparency
    local shadow = Create("ImageLabel", {
        Name = "Shadow",
        BackgroundTransparency = 1,
        Image = "rbxassetid://6014261993",
        ImageColor3 = Color3.new(0, 0, 0),
        ImageTransparency = transparency,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(49, 49, 450, 450),
        Size = UDim2.new(1, offset.X * 2 + 20, 1, offset.Y * 2 + 20),
        Position = UDim2.new(0, -offset.X - 10, 0, -offset.Y - 6),
        ZIndex = parent.ZIndex - 1,
        Parent = parent,
    })
    return shadow
end

local function safeCallback(fn, ...)
    if typeof(fn) ~= "function" then return end
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[IMGUI] Callback error:", err)
    end
end

local function getTextSize(text, size, font, frameSize)
    return TextService:GetTextSize(
        tostring(text),
        size or 13,
        font or ui_options.font,
        frameSize or Vector2.new(1000, 100)
    )
end

