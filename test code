function TabObject:Show()
    for _, tab in pairs(self.Window.Tabs) do
        tab.Content.Visible = false
        tab.Visible = false
        if tab.Button then
            tab.Button.BackgroundColor3 = self.Theme.TabInactive
            tab.Button.TextColor3 = self.Theme.TextDark
        end
    end
    self.Content.Visible = true
    self.Visible = true
    if self.Button then
        self.Button.BackgroundColor3 = self.Theme.TabActive
        self.Button.TextColor3 = self.Theme.Text
    end
    self.Window.ActiveTab = self
end

-- Generic element adder used by both Tab and Folder
local function addElementToContainer(container, element, layoutOrder)
    element.LayoutOrder = layoutOrder or (#container:GetChildren())
    element.Parent = container
end

function TabObject:AddLabel(text)
