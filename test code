                Size = UDim2.fromOffset(80, 16),
                Font = State.Theme.Font,
                TextSize = 11,
                TextColor3 = State.Theme.SubTextColor,
                Text = tostring(text),
                Parent = container
            })
        end
        return container
    end

    function TabAPI:AddSpacer(height)
        local spacer = Utility.Create("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, height or 10),
            Parent = tab.Frame
        })
        return spacer
    end

    function TabAPI:AddFolder(name, defaultOpen)
        local open = defaultOpen or false
        local container = Utility.Create("Frame", {
            BackgroundColor3 = Color3.fromRGB(28, 29, 33),
            Size = UDim2.new(1, 0, 0, 30),
            ClipsDescendants = true,
            Parent = tab.Frame
        })
        Utility.AddCorner(container, 6)

        local header = Utility.Create("TextButton", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 30),
            Font = State.Theme.Font,
            TextSize = State.Theme.TextSize,
            TextColor3 = State.Theme.TextColor,
            Text = "  " .. tostring(name or "Folder"),
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            Parent = container
        })

        local arrow = Utility.Create("ImageLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(8, 7),
            Size = UDim2.fromOffset(16, 16),
            Image = "rbxassetid://6031091004",
            ImageColor3 = State.Theme.SubTextColor,
            Rotation = open and 90 or 0,
            Parent = header
        })

        local content = Utility.Create("Frame", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(8, 34),
            Size = UDim2.new(1, -16, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Visible = open,
            Parent = container
        })
        Utility.AddListLayout(content, Enum.FillDirection.Vertical, 6)

        local function Toggle()
            open = not open
            content.Visible = open
            Utility.Tween(arrow, { Rotation = open and 90 or 0 })
            local targetHeight = open and (34 + content.AbsoluteSize.Y + 8) or 30
            Utility.Tween(container, { Size = UDim2.new(1, 0, 0, targetHeight) })
        end
        header.MouseButton1Click:Connect(Toggle)

        -- Proxy API so you can do folder:AddButton(...) etc.
        local folderAPI = {}
        for k, v in pairs(TabAPI) do
            folderAPI[k] = function(_, ...)
                local oldParent = tab.Frame
                tab.Frame = content
                local results = { v(...) }
                tab.Frame = oldParent
                if open then
                    task.defer(function()
                        local h = 34 + content.AbsoluteSize.Y + 8
                        container.Size = UDim2.new(1, 0, 0, h)
                    end)
                end
                return table.unpack(results)
            end
        end
        return folderAPI, container
    end

    function TabAPI:AddConsole(options)
        options = options or {}
        local height = options.Height or 160

        local container = Utility.Create("Frame", {
            BackgroundColor3 = Color3.fromRGB(18, 19, 22),
            Size = UDim2.new(1, 0, 0, height),
            Parent = tab.Frame
        })
        Utility.AddCorner(container, 6)
        Utility.AddStroke(container, State.Theme.BorderColor)

        local scroll = Utility.Create("ScrollingFrame", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 4,
            Parent = container
        })

        local lines = Utility.Create("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(30, 1000),
            Font = State.Theme.FontMono,
            TextSize = 13,
            TextColor3 = Color3.fromRGB(100, 100, 100),
            TextYAlignment = Enum.TextYAlignment.Top,
            Text = "1",
            Parent = scroll
        })

        local source = Utility.Create("TextBox", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(34, 0),
            Size = UDim2.new(1, -40, 0, 1000),
            Font = State.Theme.FontMono,
            TextSize = 13,
            TextColor3 = Color3.new(1, 1, 1),
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            MultiLine = true,
            ClearTextOnFocus = false,
            TextEditable = not (options.ReadOnly == true),
            Text = "",
            Parent = scroll
        })

        local function UpdateLines()
            local count = 1
            for _ in source.Text:gmatch("\n") do count += 1 end
            local str = ""
            for i = 1, count do str ..= i .. "\n" end
            lines.Text = str
            scroll.CanvasSize = UDim2.fromOffset(0, count * 16 + 10)
        end
        source:GetPropertyChangedSignal("Text"):Connect(UpdateLines)

        local api = {
            Set = function(_, text) source.Text = tostring(text) end,
            Get = function() return source.Text end,
            Log = function(_, msg)
                source.Text ..= os.date("[%H:%M:%S] ") .. tostring(msg) .. "\n"
            end,
            Clear = function() source.Text = "" end
        }
        return api, container
    end

    function TabAPI:AddImage(imageId, size)
        local img = Utility.Create("ImageLabel", {
            BackgroundTransparency = 1,
            Size = size or UDim2.fromOffset(100, 100),
            Image = typeof(imageId) == "string" and imageId or ("rbxassetid://" .. tostring(imageId)),
            ScaleType = Enum.ScaleType.Fit,
            Parent = tab.Frame
        })
        Utility.AddCorner(img, 6)
        return img
    end

    -- Expose more if needed
    tab.API = TabAPI
    return TabAPI, tab
end

