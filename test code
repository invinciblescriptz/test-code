function TabObject:AddThemeSwitcher()
    local theme = self.Theme
    local names = {}
    for name in pairs(Library.Themes) do
        table.insert(names, name)
    end
    table.sort(names)

    local dropdown = self:AddDropdown("Theme", function(selected)
        Library:SetTheme(selected)
        Library:Notify("Theme", "Switched to " .. selected, 2, "success")
    end)

    for _, name in ipairs(names) do
        dropdown:Add(name)
    end

    return dropdown
end

