		}, 0.12)
		Util.Tween(knob, {
			Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.fromOffset(2, 2)
		}, 0.12)
		if fire ~= false then
			Util.SafeCallback(callback, state)
		end
