-- Whitelist Script for Roblox (ServerScript - Put in ServerScriptService)
-- Kicks non-whitelisted players with "L skid"

local WHITELISTED_IDS = {
    123456789,  -- Replace with your UserId
    -- Add more UserIds here, example:
    -- 987654321,
    -- 111222333,
}

local KICK_MESSAGE = "L skid"

local Players = game:GetService("Players")

local function isWhitelisted(userId)
    for _, id in ipairs(WHITELISTED_IDS) do
        if id == userId then
            return true
        end
    end
    return false
end

Players.PlayerAdded:Connect(function(player)
    if not isWhitelisted(player.UserId) then
        wait(1) -- Small delay to let the player load a bit
        player:Kick(KICK_MESSAGE)
        print("Kicked non-whitelisted player: " .. player.Name .. " (" .. player.UserId .. ")")
    else
        print("Whitelisted player joined: " .. player.Name)
    end
end)

print("Whitelist script loaded. " .. #WHITELISTED_IDS .. " players whitelisted.")
