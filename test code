local function CreateDivider(parent, zBase)
	local div = Create("Frame", {
		BackgroundColor3 = Theme.Border,
		Size = UDim2.new(1, 0, 0, 1),
		BorderSizePixel = 0,
		ZIndex = zBase + 3,
		Parent = parent,
	})
	return div
end

local function CreateSpacer(parent, zBase, height)
	return Create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height or 12),
		ZIndex = zBase + 3,
		Parent = parent,
	})
end

