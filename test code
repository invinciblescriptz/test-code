-- // Elirium UI Library - One Chunk Edition
-- Futuristic neon cyber UI for Roblox

local Elirium = {}
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = {
	Background = Color3.fromRGB(15, 15, 25),
	Dark = Color3.fromRGB(10, 10, 20),
	Primary = Color3.fromRGB(0, 255, 200),
	Secondary = Color3.fromRGB(180, 50, 255),
	Accent = Color3.fromRGB(255, 80, 150),
	Text = Color3.fromRGB(240, 240, 255),
	TextSecondary = Color3.fromRGB(180, 180, 220)
}

local TweenFast = TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

local function ApplyNeon(frame, color)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame
	
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.5
	stroke.Color = color or Theme.Primary
	stroke.Transparency = 0.3
	stroke.Parent = frame
	
	local glow = stroke:Clone()
	glow.Thickness = 4
	glow.Transparency = 0.85
	glow.Parent = frame
end

-- Create Main Window
function Elirium:CreateWindow(title)
	local playerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "EliriumUI"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui
	
	local main = Instance.new("Frame")
	main.Size = UDim2.new(0, 440, 0, 340)
	main.Position = UDim2.new(0.5, -220, 0.5, -170)
	main.BackgroundColor3 = Theme.Background
	main.BorderSizePixel = 0
	main.Parent = screenGui
	ApplyNeon(main, Theme.Primary)
	
	-- Title Bar
	local titleBar = Instance.new("Frame")
	titleBar.Size = UDim2.new(1, 0, 0, 42)
	titleBar.BackgroundColor3 = Theme.Dark
	titleBar.BorderSizePixel = 0
	titleBar.Parent = main
	
	Instance.new("UICorner", titleBar).CornerRadius = UDim.new(0, 8)
	
	local titleText = Instance.new("TextLabel")
	titleText.Size = UDim2.new(1, -90, 1, 0)
	titleText.BackgroundTransparency = 1
	titleText.Text = title or "ELIRIUM"
	titleText.TextColor3 = Theme.Text
	titleText.Font = Enum.Font.GothamBold
	titleText.TextSize = 17
	titleText.Parent = titleBar
	
	-- Close Button
	local close = Instance.new("TextButton")
	close.Size = UDim2.new(0, 32, 0, 32)
	close.Position = UDim2.new(1, -38, 0, 5)
	close.BackgroundTransparency = 1
	close.Text = "✕"
	close.TextColor3 = Theme.Accent
	close.Font = Enum.Font.GothamBold
	close.TextSize = 20
	close.Parent = titleBar
	ApplyNeon(close, Theme.Accent)
	
	close.MouseButton1Click:Connect(function()
		screenGui:Destroy()
	end)
	
	-- Dragging
	local dragging, dragInput, dragStart, startPos
	titleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
		end
	end)
	
	titleBar.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			dragInput = input
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input == dragInput then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	
	-- Content Area
	local content = Instance.new("Frame")
	content.Name = "Content"
	content.Size = UDim2.new(1, -24, 1, -66)
	content.Position = UDim2.new(0, 12, 0, 54)
	content.BackgroundTransparency = 1
	content.Parent = main
	
	return {
		Content = content,
		Main = main,
		ScreenGui = screenGui
	}
end

-- Button
function Elirium:CreateButton(parent, text, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 48)
	btn.BackgroundColor3 = Theme.Dark
	btn.Text = text or "Button"
	btn.TextColor3 = Theme.Text
	btn.Font = Enum.Font.GothamSemibold
	btn.TextSize = 16
	btn.Parent = parent
	ApplyNeon(btn, Theme.Primary)
	
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenFast, {BackgroundColor3 = Theme.Primary, TextColor3 = Theme.Background}):Play()
	end)
	
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenFast, {BackgroundColor3 = Theme.Dark, TextColor3 = Theme.Text}):Play()
	end)
	
	btn.MouseButton1Click:Connect(function()
		if callback then callback() end
	end)
	
	return btn
end

-- Toggle
function Elirium:CreateToggle(parent, text, default, callback)
	local toggle = {State = default or false}
	
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 0, 45)
	frame.BackgroundTransparency = 1
	frame.Parent = parent
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.65, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = text or "Toggle"
	label.TextColor3 = Theme.Text
	label.Font = Enum.Font.GothamSemibold
	label.TextSize = 15
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame
	
	local switch = Instance.new("Frame")
	switch.Size = UDim2.new(0, 52, 0, 26)
	switch.Position = UDim2.new(1, -62, 0.5, -13)
	switch.BackgroundColor3 = Theme.Dark
	switch.Parent = frame
	ApplyNeon(switch, Theme.Secondary)
	
	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 22, 0, 22)
	knob.Position = UDim2.new(0, 2, 0.5, -11)
	knob.BackgroundColor3 = Theme.TextSecondary
	knob.Parent = switch
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)
	
	local function update()
		if toggle.State then
			TweenService:Create(switch, TweenFast, {BackgroundColor3 = Theme.Primary}):Play()
			TweenService:Create(knob, TweenFast, {Position = UDim2.new(1, -24, 0.5, -11)}):Play()
		else
			TweenService:Create(switch, TweenFast, {BackgroundColor3 = Theme.Dark}):Play()
			TweenService:Create(knob, TweenFast, {Position = UDim2.new(0, 2, 0.5, -11)}):Play()
		end
	end
	
	frame.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 then
			toggle.State = not toggle.State
			update()
			if callback then callback(toggle.State) end
		end
	end)
	
	update()
	return toggle
end

-- Slider
function Elirium:CreateSlider(parent, text, min, max, default, callback)
	local slider = {Value = default or min}
	
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 0, 65)
	frame.BackgroundTransparency = 1
	frame.Parent = parent
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 22)
	label.BackgroundTransparency = 1
	label.Text = text .. ": " .. math.floor(slider.Value)
	label.TextColor3 = Theme.Text
	label.Font = Enum.Font.GothamSemibold
	label.TextSize = 14
	label.Parent = frame
	
	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, 0, 0, 10)
	bar.Position = UDim2.new(0, 0, 0, 38)
	bar.BackgroundColor3 = Theme.Dark
	bar.Parent = frame
	ApplyNeon(bar, Theme.Primary)
	
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0.5, 0, 1, 0)
	fill.BackgroundColor3 = Theme.Primary
	fill.Parent = bar
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)
	
	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 18, 0, 18)
	knob.BackgroundColor3 = Theme.Text
	knob.Parent = bar
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)
	
	local function update(val)
		val = math.clamp(val, min, max)
		slider.Value = val
		local percent = (val - min) / (max - min)
		fill.Size = UDim2.new(percent, 0, 1, 0)
		knob.Position = UDim2.new(percent, -9, 0.5, -9)
		label.Text = text .. ": " .. math.floor(val)
		if callback then callback(val) end
	end
	
	local dragging = false
	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			local pos = UserInputService:GetMouseLocation()
			local percent = math.clamp((pos.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
			update(min + percent * (max - min))
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local pos = UserInputService:GetMouseLocation()
			local percent = math.clamp((pos.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
			update(min + percent * (max - min))
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
	
	update(default or min)
	return slider
end

-- Label
function Elirium:CreateLabel(parent, text)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 0, 28)
	lbl.BackgroundTransparency = 1
	lbl.Text = text or ""
	lbl.TextColor3 = Theme.TextSecondary
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 14
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = parent
	return lbl
end

