				listening = false
				if callback then
					task.spawn(callback, currentKey)
				end
			elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
				currentKey = input.UserInputType
				btn.Text = input.UserInputType.Name
				btn.TextColor3 = Color3.fromRGB(200, 200, 200)
				listening = false
				if callback then
					task.spawn(callback, currentKey)
				end
			end
		end)

		-- Fire on key press
		SafeConnect(UserInputService.InputBegan, function(input, gp)
			if gp or listening then return end
			if currentKey and (input.KeyCode == currentKey or input.UserInputType == currentKey) then
				if callback then
					task.spawn(callback, currentKey)
				end
			end
		end)

		local api = {}
		function api:Set(key)
			currentKey = key
			btn.Text = typeof(key) == "EnumItem" and key.Name or tostring(key)
		end
		function api:Get()
			return currentKey
		end

		table.insert(tab.Elements, kb)
		return api
	end

	function tab:AddSeparator()
		local sep = SeparatorPrefab:Clone()
		sep.Visible = true
		sep.Parent = page
		table.insert(tab.Elements, sep)
		return sep
	end

	function tab:AddConsole(opts)
		opts = opts or {}
		local height = opts.y or 160
		local readonly = opts.readonly
		if readonly == nil then readonly = true end

		local console = ConsolePrefab:Clone()
		console.Visible = true
		console.Size = UDim2.new(1, 0, 0, height)
		console.Parent = page

		local scroll = console:FindFirstChild("Scroll")

		local api = {}
		function api:Log(msg, color)
			local line = Create("TextLabel", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 16),
				Font = Enum.Font.Code,
				Text = tostring(msg),
				TextColor3 = color or Color3.fromRGB(200, 200, 200),
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextWrapped = true,
				Parent = scroll,
			})
			-- Auto scroll
			task.defer(function()
				scroll.CanvasPosition = Vector2.new(0, scroll.AbsoluteCanvasSize.Y)
			end)
			return line
		end
		function api:Clear()
			for _, c in ipairs(scroll:GetChildren()) do
				if c:IsA("TextLabel") then
					c:Destroy()
				end
			end
		end

		table.insert(tab.Elements, console)
		return api
	end

	table.insert(self.Tabs, tab)

	-- Auto-show first tab
	if #self.Tabs == 1 then
		self:ShowTab(tab)
	end

	return tab
end

function Window:ShowTab(tab)
	for _, t in ipairs(self.Tabs) do
		t.Page.Visible = false
		t.Button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		t.Button.TextColor3 = Color3.fromRGB(180, 180, 180)
		if t.Indicator then
			t.Indicator.Visible = false
		end
	end
	tab.Page.Visible = true
	tab.Button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	tab.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
	if tab.Indicator then
		tab.Indicator.BackgroundColor3 = self.MainColor
		tab.Indicator.Visible = true
	end
	self.CurrentTab = tab
end

function Window:Destroy()
	if self.Frame then
		self.Frame:Destroy()
	end
end

-- Global helpers
function Library:SetMainColor(color)
	ui_options.main_color = color
	for _, win in ipairs(self.Windows) do
		win.MainColor = color
		if win.Frame and win.Frame:FindFirstChild("Bar") then
			win.Frame.Bar.BackgroundColor3 = color
