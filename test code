----------------------------------------------------------------
-- Utility
----------------------------------------------------------------

local function tween(obj, props, duration)
	duration = duration or ui_options.tween_time
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

local function hasProp(obj, prop)
	local ok, _ = pcall(function()
		return obj[prop]
	end)
	return ok
end

local function textWidth(label)
	return label.TextBounds.X + 16
end

local function getMouse()
	local loc = UIS:GetMouseLocation()
	return Vector2.new(loc.X, loc.Y - 36) -- account for topbar
end

local function ripple(button, x, y)
	task.spawn(function()
		button.ClipsDescendants = true
		local circle = Prefabs.Circle:Clone()
		circle.Parent = button
		circle.ZIndex = 100

		local rel = Vector2.new(x, y) - button.AbsolutePosition
		circle.Position = UDim2.fromOffset(rel.X, rel.Y)

		local size = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 1.6
		circle:TweenSizeAndPosition(
			UDim2.fromOffset(size, size),
			UDim2.new(0.5, -size / 2, 0.5, -size / 2),
			Enum.EasingDirection.Out,
			Enum.EasingStyle.Quad,
			0.45,
			true
		)
		tween(circle, { ImageTransparency = 1 }, 0.45)
		task.wait(0.5)
		circle:Destroy()
	end)
end

local function rgbToHsv(r, g, b)
	r, g, b = r / 255, g / 255, b / 255
	local max, min = math.max(r, g, b), math.min(r, g, b)
	local h, s, v = 0, 0, max
	local d = max - min

	s = max == 0 and 0 or d / max

	if max ~= min then
		if max == r then
			h = (g - b) / d + (g < b and 6 or 0)
		elseif max == g then
			h = (b - r) / d + 2
		else
			h = (r - g) / d + 4
		end
		h /= 6
	end
	return h, s, v
end

