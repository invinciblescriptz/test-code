-- Drag helper for any gui object
function Library.Utils.MakeDraggable(gui, handle)
	handle = handle or gui
	local dragging, startPos, dragStart
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = gui.Position
		end
	end)
	handle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
end

-- Simple acrylic / blur simulation via transparency layers
function Library.Utils.AddAcrylic(frame, transparency)
	transparency = transparency or 0.3
	frame.BackgroundTransparency = transparency
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 40, 50)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 20, 30))
	}
	gradient.Parent = frame
end

-- Rainbow cycle for accent
function Library.Utils.Rainbow(speed)
	speed = speed or 1
	local h = 0
	return RunService.RenderStepped:Connect(function(dt)
		h = (h + dt * speed * 0.1) % 1
		Library.Theme.main_color = Color3.fromHSV(h, 0.7, 0.9)
	end)
end

-- Watermark
function Library.Utils.CreateWatermark(text)
	local wm = Instance.new("TextLabel")
	wm.BackgroundColor3 = Library.Theme.secondary_background
	wm.BackgroundTransparency = 0.3
	wm.Size = UDim2.fromOffset(0, 24)
	wm.AutomaticSize = Enum.AutomaticSize.X
	wm.Position = UDim2.fromOffset(15, 15)
	wm.Font = Library.Theme.font
	wm.Text = "  " .. (text or "Elerium UI") .. "  "
	wm.TextColor3 = Library.Theme.text_color
	wm.TextSize = 13
	wm.ZIndex = 5
	wm.Parent = ScreenGui
	makeCorner(wm, 4)
	makeStroke(wm, Library.Theme.main_color, 1, 0.5)
	return wm
end

-- FPS Counter
function Library.Utils.CreateFPSCounter()
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromOffset(100, 20)
	label.Position = UDim2.new(1, -110, 0, 10)
	label.Font = Enum.Font.Code
	label.Text = "FPS: --"
	label.TextColor3 = Library.Theme.text_color
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Right
	label.ZIndex = 5
	label.Parent = ScreenGui

	local frames = 0
	local last = tick()
	RunService.RenderStepped:Connect(function()
		frames = frames + 1
		if tick() - last >= 1 then
			label.Text = "FPS: " .. frames
			frames = 0
			last = tick()
		end
	end)
	return label
end

-- Config save / load helpers (using HttpService JSON)
function Library.Utils.SaveConfig(name, data)
	if writefile then
		writefile(name .. ".json", HttpService:JSONEncode(data))
		return true
	end
	return false
end

function Library.Utils.LoadConfig(name)
	if isfile and isfile(name .. ".json") and readfile then
		local ok, data = pcall(function()
			return HttpService:JSONDecode(readfile(name .. ".json"))
		end)
		if ok then return data end
	end
	return nil
end

