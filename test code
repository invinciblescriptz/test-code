        function tab_data:AddColorPicker(callback, opts)
            callback = typeof(callback) == "function" and callback or function() end
            opts = typeof(opts) == "table" and opts or {}
            local default = opts.default or Color3.fromRGB(255, 0, 0)

            local cp = ColorPickerPrefab:Clone()
            cp.Parent = tabFrame

            local h, s, v = rgbtohsv(default.R * 255, default.G * 255, default.B * 255)
            local draggingPalette = false
            local draggingSat = false

            local function update(silent)
                local col = Color3.fromHSV(h, s, v)
                cp.Sample.BackgroundColor3 = col
                cp.Saturation.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                cp.Hex.Text = ColorToHex(col)
                cp.R.Text = tostring(math.floor(col.R * 255 + 0.5))
                cp.G.Text = tostring(math.floor(col.G * 255 + 0.5))
                cp.B.Text = tostring(math.floor(col.B * 255 + 0.5))
                cp.Palette.Indicator.Position = UDim2.fromOffset(
                    clamp(h * 120 - 5, 0, 110),
                    clamp((1 - s) * 120 - 5, 0, 110)
                )
                cp.Saturation.Indicator.Position = UDim2.new(0, -3, 0, clamp((1 - v) * 120, 0, 116))
                if not silent then
                    safeCallback(callback, col)
                end
            end

            cp.Palette.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingPalette = true
                    checks.color_picking = true
                end
            end)
            cp.Saturation.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingSat = true
                    checks.color_picking = true
                end
            end)
            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    draggingPalette = false
                    draggingSat = false
                    checks.color_picking = false
                end
            end)
            RS.RenderStepped:Connect(function()
                if draggingPalette and cp.Parent then
                    local rel = gMouse() - cp.Palette.AbsolutePosition
                    h = clamp(rel.X / 120, 0, 1)
                    s = clamp(1 - (rel.Y / 120), 0, 1)
                    update()
                elseif draggingSat and cp.Parent then
                    local rel = gMouse() - cp.Saturation.AbsolutePosition
                    v = clamp(1 - (rel.Y / 120), 0, 1)
                    update()
                end
            end)

            cp.Hex.FocusLost:Connect(function()
                local col = HexToColor(cp.Hex.Text)
                h, s, v = rgbtohsv(col.R * 255, col.G * 255, col.B * 255)
                update()
            end)

            local function applyRGB()
                local r = tonumber(cp.R.Text) or 0
                local g = tonumber(cp.G.Text) or 0
                local b = tonumber(cp.B.Text) or 0
                r, g, b = clamp(r, 0, 255), clamp(g, 0, 255), clamp(b, 0, 255)
                h, s, v = rgbtohsv(r, g, b)
                update()
            end
            cp.R.FocusLost:Connect(applyRGB)
            cp.G.FocusLost:Connect(applyRGB)
            cp.B.FocusLost:Connect(applyRGB)

            update(true)

            local data = {}
            function data:Set(col, silent)
                if typeof(col) == "Color3" then
                    h, s, v = rgbtohsv(col.R * 255, col.G * 255, col.B * 255)
                    update(silent)
                end
            end
            function data:Get()
                return Color3.fromHSV(h, s, v)
            end
            return data, cp
        end

        function tab_data:AddConsole(opts)
            opts = typeof(opts) == "table" and opts or {}
            local height   = opts.y or 180
            local readonly = opts.readonly ~= false

            local cons = ConsolePrefab:Clone()
            cons.Size = UDim2.new(1, 0, 0, height)
            cons.Parent = tabFrame
            cons.Scroll.Source.TextEditable = not readonly

            local source = cons.Scroll.Source
            local lines  = cons.Scroll.Lines

            local function updateLines()
                local text = source.Text
                local count = 1
                for _ in text:gmatch("\n") do
                    count += 1
                end
                local buf = {}
                for i = 1, count do
                    table.insert(buf, tostring(i))
                end
                lines.Text = table.concat(buf, "\n")
                local h = math.max(count * 16, 100)
                source.Size = UDim2.new(1, -40, 0, h)
                lines.Size  = UDim2.fromOffset(36, h)
                cons.Scroll.CanvasSize = UDim2.fromOffset(0, h + 8)
            end

            source:GetPropertyChangedSignal("Text"):Connect(updateLines)
            updateLines()

            local data = {}
            function data:Set(code)
                source.Text = tostring(code or "")
            end
            function data:Get()
                return source.Text
            end
            function data:Log(msg)
                source.Text = source.Text .. "[*] " .. tostring(msg) .. "\n"
            end
            function data:Clear()
                source.Text = ""
            end
            function data:Append(msg)
                source.Text = source.Text .. tostring(msg)
            end
            return data, cons
        end

        function tab_data:AddHorizontal()
            local ha = HorizontalPrefab:Clone()
            ha.Parent = tabFrame
