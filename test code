-- ============================================================

local ConfigSystem = {}
ConfigSystem.__index = ConfigSystem

function ConfigSystem.new(name)
	local self = setmetatable({}, ConfigSystem)
	self.Name = name or "EleriumConfig"
	self.Data = {}
	self.Path = "EleriumConfigs/" .. self.Name .. ".json"
	return self
end

function ConfigSystem:Set(key, value)
	self.Data[key] = value
end

function ConfigSystem:Get(key, default)
	if self.Data[key] ~= nil then
		return self.Data[key]
	end
	return default
end

function ConfigSystem:Save()
	if writefile then
		local success, encoded = pcall(function()
			return HttpService:JSONEncode(self.Data)
		end)
		if success then
			pcall(function()
				if not isfolder("EleriumConfigs") then
					makefolder("EleriumConfigs")
				end
				writefile(self.Path, encoded)
			end)
		end
	end
end

function ConfigSystem:Load()
	if readfile and isfile and isfile(self.Path) then
		local success, data = pcall(function()
			return HttpService:JSONDecode(readfile(self.Path))
		end)
		if success and type(data) == "table" then
			self.Data = data
			return true
		end
	end
	return false
end

function ConfigSystem:Delete()
	if delfile and isfile and isfile(self.Path) then
		pcall(delfile, self.Path)
	end
	self.Data = {}
end

library.Config = ConfigSystem

