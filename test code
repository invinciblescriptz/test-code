local Tab = {}
Tab.__index = Tab

function Tab.new(window, name)
	local self = setmetatable({}, Tab)
	self.Window = window
	self.Name = name or "Tab"
	self.Elements = {}
	self.Visible = false

	-- Tab Button
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.BackgroundColor3 = window.Theme.secondary_background
	btn.BackgroundTransparency = 0
	btn.BorderSizePixel = 0
	btn.Size = UDim2.fromOffset(0, 26)
	btn.AutomaticSize = Enum.AutomaticSize.X
	btn.Font = window.Theme.font
	btn.Text = "  " .. name .. "  "
	btn.TextColor3 = window.Theme.dim_text
	btn.TextSize = window.Theme.font_size
	btn.ZIndex = 12
	btn.Parent = window.TabBar
	makeCorner(btn, 4)

	self.Button = btn

	-- Content Scroller
	local scroller = Instance.new("ScrollingFrame")
	scroller.Name = name .. "_Content"
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.Size = UDim2.fromScale(1, 1)
	scroller.CanvasSize = UDim2.fromOffset(0, 0)
	scroller.ScrollBarThickness = 3
	scroller.ScrollBarImageColor3 = window.Theme.main_color
	scroller.Visible = false
	scroller.ZIndex = 11
	scroller.Parent = window.Content
	makePadding(scroller, 8, 8, 8, 8)

	local list = makeList(scroller, 6)
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center

	self.Scroller = scroller
	self.List = list

	-- Auto canvas size
	list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		scroller.CanvasSize = UDim2.fromOffset(0, list.AbsoluteContentSize.Y + 16)
	end)

	btn.MouseButton1Click:Connect(function()
		self:Show()
	end)

	return self
end

function Tab:Show()
	for _, t in ipairs(self.Window.Tabs) do
		t.Visible = false
		t.Scroller.Visible = false
		t.Button.BackgroundColor3 = self.Window.Theme.secondary_background
		t.Button.TextColor3 = self.Window.Theme.dim_text
	end
	self.Visible = true
	self.Scroller.Visible = true
	self.Button.BackgroundColor3 = self.Window.Theme.main_color
	self.Button.TextColor3 = self.Window.Theme.text_color
	self.Window.CurrentTab = self
end

function Tab:_addElement(element)
	table.insert(self.Elements, element)
	return element
end

