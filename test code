local NotificationHolder = Create("Frame", {
    Name = "Notifications",
    BackgroundTransparency = 1,
    AnchorPoint = Vector2.new(1, 0),
    Position = UDim2.new(1, -16, 0, 16),
    Size = UDim2.new(0, 310, 1, -32),
    Parent = imgui,
})
ListLayout(NotificationHolder, Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Right)

local function Notify(title, message, duration, notifType)
    duration  = duration or ui_options.notification_duration
    notifType = notifType or "info"

    if notification_count >= ui_options.max_notifications then
        local oldest = NotificationHolder:GetChildren()[1]
        if oldest and oldest:IsA("Frame") then
            oldest:Destroy()
            notification_count -= 1
        end
    end

    local colors = {
        info    = ui_options.main_color,
        success = ui_options.success,
        warning = ui_options.warning,
        error   = ui_options.error,
    }
    local accent = colors[notifType] or ui_options.main_color

    local card = Create("Frame", {
        BackgroundColor3 = ui_options.secondary,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(300, 0),
        ClipsDescendants = true,
        Parent = NotificationHolder,
    })
    Roundify(card, 8)
    Stroke(card, accent, 1.5, 0.15)

    local accentBar = Create("Frame", {
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 4, 1, 0),
        Parent = card,
    })
    Roundify(accentBar, 2)

    local titleLbl = Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(16, 10),
        Size = UDim2.new(1, -44, 0, 18),
        Font = ui_options.font_bold,
        Text = tostring(title),
        TextColor3 = ui_options.text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })

    local msgLbl = Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(16, 30),
        Size = UDim2.new(1, -28, 0, 42),
        Font = ui_options.font,
        Text = tostring(message),
        TextColor3 = ui_options.text_dim,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        Parent = card,
    })

    local closeBtn = Create("TextButton", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -28, 0, 6),
        Size = UDim2.fromOffset(22, 22),
        Font = ui_options.font_bold,
        Text = "×",
        TextColor3 = ui_options.text_dim,
        TextSize = 16,
        Parent = card,
    })

    notification_count += 1
    Tween(card, {Size = UDim2.fromOffset(300, 76)}, 0.28, Enum.EasingStyle.Back)

    local function destroy()
        Tween(card, {Size = UDim2.fromOffset(300, 0), BackgroundTransparency = 1}, 0.2)
        task.wait(0.22)
        if card and card.Parent then
            card:Destroy()
            notification_count = math.max(0, notification_count - 1)
        end
    end

    closeBtn.MouseButton1Click:Connect(destroy)
    task.spawn(function()
        task.wait(duration)
        if card and card.Parent then
            destroy()
        end
    end)

    return card
end

