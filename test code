-- UTILITY FUNCTIONS
--------------------------------------------------------------------------------

local Utility = {}

function Utility.Create(className, properties)
    local instance = Instance.new(className)
    if properties then
        for property, value in pairs(properties) do
            if property ~= "Parent" then
                instance[property] = value
            end
        end
        if properties.Parent then
            instance.Parent = properties.Parent
        end
    end
    return instance
end

function Utility.Tween(object, properties, duration, style, direction)
    duration = duration or 0.2
    style = style or Enum.EasingStyle.Quad
    direction = direction or Enum.EasingDirection.Out
    local tweenInfo = TweenInfo.new(duration, style, direction)
    local tween = TweenService:Create(object, tweenInfo, properties)
    tween:Play()
    return tween
end

function Utility.DeepCopy(original)
    local copy
    if type(original) == "table" then
        copy = {}
        for key, value in next, original, nil do
            copy[Utility.DeepCopy(key)] = Utility.DeepCopy(value)
        end
        setmetatable(copy, Utility.DeepCopy(getmetatable(original)))
    else
        copy = original
    end
    return copy
end

function Utility.Round(number, decimalPlaces)
    local mult = 10 ^ (decimalPlaces or 0)
    return math.floor(number * mult + 0.5) / mult
end

function Utility.Clamp(value, min, max)
    return math.max(min, math.min(max, value))
end

function Utility.Lerp(a, b, t)
    return a + (b - a) * t
end

function Utility.Color3ToHex(color)
    local r = math.floor(color.R * 255)
    local g = math.floor(color.G * 255)
    local b = math.floor(color.B * 255)
    return string.format("#%02X%02X%02X", r, g, b)
end

function Utility.HexToColor3(hex)
    hex = hex:gsub("#", "")
    local r = tonumber(hex:sub(1, 2), 16) / 255
    local g = tonumber(hex:sub(3, 4), 16) / 255
    local b = tonumber(hex:sub(5, 6), 16) / 255
    return Color3.new(r, g, b)
end

function Utility.GetTextSize(text, fontSize, font, frameSize)
    return TextService:GetTextSize(text, fontSize, font, frameSize or Vector2.new(10000, 10000))
end

function Utility.IsMobile()
    return UIS.TouchEnabled and not UIS.KeyboardEnabled
end

function Utility.SafeCall(func, ...)
    local success, result = pcall(func, ...)
    if not success then
        warn("[CustomUI] Error:", result)
    end
    return success, result
end

function Utility.GenerateId()
    return HttpService:GenerateGUID(false):gsub("-", ""):sub(1, 12)
end

function Utility.TableLength(t)
    local count = 0
    for _ in pairs(t) do
        count = count + 1
    end
    return count
end

function Utility.FindInTable(t, value)
    for i, v in pairs(t) do
        if v == value then
            return i
        end
    end
    return nil
end

function Utility.MergeTables(t1, t2)
    local result = Utility.DeepCopy(t1)
    for k, v in pairs(t2) do
        if type(v) == "table" and type(result[k]) == "table" then
            result[k] = Utility.MergeTables(result[k], v)
        else
            result[k] = v
        end
    end
    return result
end

