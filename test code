function TabObject:AddAccordion(title, items)
    local folder = self:AddFolder(title)
    for _, item in ipairs(items or {}) do
        if item.Type == "Button" then
            folder:AddButton(item.Text, item.Callback)
        elseif item.Type == "Toggle" then
            folder:AddSwitch(item.Text, item.Callback)
        elseif item.Type == "Label" then
            folder:AddLabel(item.Text)
        end
    end
    return folder
end

