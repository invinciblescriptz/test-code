        function TabData:AddDropdown(text, callback)
            local Frame = Create("Frame", {
                Parent = Page,
                Size = UDim2.new(1, 0, 0, 34),
                BackgroundColor3 = Theme.Element,
                BackgroundTransparency = 0.4,
                ClipsDescendants = true
            })
            Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Frame})

            local Title = Create("TextLabel", {
                Parent = Frame,
                Size = UDim2.new(1, -30, 1, 0),
                Position = UDim2.fromOffset(12, 0),
                BackgroundTransparency = 1,
                Text = (text or "Dropdown") .. ": None",
                TextColor3 = Theme.Text,
                TextSize = 13,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left
            })

            local Arrow = Create("TextLabel", {
                Parent = Frame,
                Size = UDim2.fromOffset(20, 20),
                Position = UDim2.new(1, -26, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                BackgroundTransparency = 1,
                Text = "▼",
                TextColor3 = Theme.SubText,
                TextSize = 10
            })

            local OptionsFrame = Create("Frame", {
                Parent = Frame,
                Size = UDim2.new(1, 0, 0, 0),
                Position = UDim2.fromOffset(0, 34),
                BackgroundColor3 = Color3.fromRGB(28, 28, 36),
                Visible = false
            })
            Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = OptionsFrame})
            Create("UIListLayout", {Parent = OptionsFrame, Padding = UDim.new(0, 2)})

            local Open = false
            local Options = {}

            local function Toggle()
                Open = not Open
                OptionsFrame.Visible = Open
                local height = 34 + (#Options * 28)
                Frame.Size = Open and UDim2.new(1, 0, 0, height) or UDim2.new(1, 0, 0, 34)
            end

            local Click = Create("TextButton", {
                Parent = Frame,
                Size = UDim2.new(1, 0, 0, 34),
                BackgroundTransparency = 1,
                Text = ""
            })
            Click.MouseButton1Click:Connect(Toggle)

            local DropdownData = {}

            function DropdownData:Add(option)
                local OptBtn = Create("TextButton", {
                    Parent = OptionsFrame,
                    Size = UDim2.new(1, -6, 0, 26),
                    BackgroundTransparency = 1,
                    Text = "  " .. option,
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false
                })
                table.insert(Options, option)

                OptBtn.MouseButton1Click:Connect(function()
                    Title.Text = (text or "Dropdown") .. ": " .. option
                    if typeof(callback) == "function" then
                        task.spawn(callback, option)
                    end
                    Open = false
                    OptionsFrame.Visible = false
                    Frame.Size = UDim2.new(1, 0, 0, 34)
                end)

                return {
                    Remove = function()
                        OptBtn:Destroy()
                        for i, v in ipairs(Options) do
                            if v == option then
                                table.remove(Options, i)
                                break
                            end
                        end
                    end
                }
            end

            return DropdownData
        end

        function TabData:AddFolder(name)
            local FolderFrame = Create("Frame", {
                Parent = Page,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1
            })
            Create("UIListLayout", {
                Parent = FolderFrame,
                Padding = UDim.new(0, 4),
                SortOrder = Enum.SortOrder.LayoutOrder
            })

            local Header = Create("TextButton", {
                Parent = FolderFrame,
                Size = UDim2.new(1, 0, 0, 28),
                BackgroundColor3 = Theme.Element,
                Text = "  ▶  " .. (name or "Folder"),
                TextColor3 = Theme.Accent,
                TextSize = 13,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false
            })
            Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Header})

            local ContentFrame = Create("Frame", {
                Parent = FolderFrame,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Visible = false
            })
            Create("UIListLayout", {
                Parent = ContentFrame,
                Padding = UDim.new(0, 4)
            })
            Create("UIPadding", {Parent = ContentFrame, PaddingLeft = UDim.new(0, 8)})

            local Open = false
            Header.MouseButton1Click:Connect(function()
                Open = not Open
                ContentFrame.Visible = Open
                Header.Text = (Open and "  ▼  " or "  ▶  ") .. (name or "Folder")
            end)

            -- Proxy methods so you can do folder:AddSwitch etc.
            local FolderData = {}
            setmetatable(FolderData, {
                __index = function(_, key)
                    if TabData[key] then
                        return function(_, ...)
                            local oldParent = Page
                            -- temporarily redirect
                            local args = {...}
                            -- simple redirect by changing parent of created elements is complex,
                            -- so we just call the original and move the last child
                            local result = TabData[key](TabData, ...)
                            -- move last created element into folder content
                            local children = Page:GetChildren()
                            local last = children[#children]
                            if last and last:IsA("GuiObject") and last ~= FolderFrame then
                                last.Parent = ContentFrame
                            end
                            return result
                        end
                    end
                end
            })

            return FolderData
        end

        function TabData:Show()
            Show()
        end

        -- Auto show first tab
        if #WindowData.Tabs == 1 then
            task.defer(Show)
        end

        return TabData
    end

    table.insert(Library.Windows, WindowData)
    return WindowData
end

return Library
