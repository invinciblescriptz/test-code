	content.Size = UDim2.new(1, 0, 1, -70)
	content.Position = UDim2.fromOffset(0, 70)
	content.ZIndex = zBase
	content.Parent = window

	local windowApi = {
		Frame = window,
		Title = title,
		Tabs = {},
	}

	function windowApi:AddTab(tabTitle)
		local tab = createTab(windowApi, tabTitle, tabBtnHolder, content)
		table.insert(windowApi.Tabs, tab)
		-- Auto-show first tab
		if #windowApi.Tabs == 1 then
			tab:Show()
		end
		return tab
	end

	function windowApi:SetTitle(t)
		titleLbl.Text = tostring(t)
	end

	function windowApi:Destroy()
		window:Destroy()
	end

	function windowApi:Minimize()
		minBtn.MouseButton1Click:Fire()
	end

	function windowApi:SetVisible(v)
		window.Visible = v and true or false
	end

	table.insert(Library.Windows, windowApi)
	Anim.ScaleIn(window, 0.25)

	return windowApi
end

