	local function applyColor(newH, newS, newV, fire)
		h, s, v = newH, newS, newV
		color = Color3.fromHSV(h, s, v)
		sample.BackgroundColor3 = color
		satVal.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		hexBox.Text = Util.ColorToHex(color)
		if fire ~= false then
			Util.SafeCallback(callback, color)
		end
	end

	local draggingSV, draggingHue = false, false

	satVal.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingSV = true
		end
	end)
	hueBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingHue = true
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		if draggingSV then
			local abs = satVal.AbsolutePosition
			local size = satVal.AbsoluteSize
			local ns = Util.Clamp((input.Position.X - abs.X) / size.X, 0, 1)
			local nv = 1 - Util.Clamp((input.Position.Y - abs.Y) / size.Y, 0, 1)
			applyColor(h, ns, nv)
		elseif draggingHue then
			local abs = hueBar.AbsolutePosition
			local size = hueBar.AbsoluteSize
			local nh = Util.Clamp((input.Position.Y - abs.Y) / size.Y, 0, 1)
			applyColor(nh, s, v)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingSV = false
			draggingHue = false
		end
	end)

	hexBox.FocusLost:Connect(function()
		local ok, col = pcall(Util.HexToColor, hexBox.Text)
		if ok and typeof(col) == "Color3" then
			local nh, ns, nv = Color3.toHSV(col)
			applyColor(nh, ns, nv)
		else
			hexBox.Text = Util.ColorToHex(color)
		end
	end)

	sample.MouseButton1Click:Connect(function()
		pickerFrame.Visible = not pickerFrame.Visible
	end)

	local api = {}
	function api:Set(c)
		local nh, ns, nv = Color3.toHSV(c)
		applyColor(nh, ns, nv, true)
	end
