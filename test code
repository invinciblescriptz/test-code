function TabObject:AddKeybind(text, callback)
    local cont, label, keyBox = Prefabs.CreateKeybind(text, self.Theme)
    addElementToContainer(self.Content, cont)

    local currentKey = nil
    local listening = false

    keyBox.MouseButton1Click:Connect(function()
        listening = true
        keyBox.Text = "..."
        keyBox.TextColor3 = self.Theme.Accent
    end)

    local connection
    connection = UserInputService.InputBegan:Connect(function(input, gp)
        if not listening then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            currentKey = input.KeyCode
            keyBox.Text = input.KeyCode.Name
            keyBox.TextColor3 = self.Theme.Text
            listening = false
            if callback then
                -- rebind logic can be stored externally
            end
        end
    end)

    -- Also fire callback when the bound key is pressed
    UserInputService.InputBegan:Connect(function(input, gp)
        if not gp and currentKey and input.KeyCode == currentKey and callback then
            task.spawn(callback)
        end
    end)

    local obj = {
        Set = function(_, key)
            currentKey = key
            keyBox.Text = key and key.Name or "None"
        end,
        Get = function() return currentKey end,
    }

    table.insert(self.Elements, obj)
    return obj
end

