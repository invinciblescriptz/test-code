function Library:Notify(opts)
	opts = opts or {}
	local title   = opts.Title or "Notification"
	local content = opts.Content or opts.Text or ""
	local duration = opts.Duration or 4
	local notifType = opts.Type or "Info" -- Info, Success, Warning, Error

	local accent = Library.Theme.Accent
	if notifType == "Success" then accent = Library.Theme.Success
	elseif notifType == "Warning" then accent = Library.Theme.Warning
	elseif notifType == "Error" then accent = Library.Theme.Error
	end

	local frame = Instance.new("Frame")
	frame.Name = "Notification"
	frame.BackgroundColor3 = Library.Theme.NotificationBg
	frame.BorderSizePixel = 0
	frame.Size = UDim2.new(1, 0, 0, 0)
	frame.ClipsDescendants = true
	frame.LayoutOrder = #Library.Notifications + 1
	frame.Parent = NotifHolder
	makeCorner(frame, 6)
	makeStroke(frame, accent, 1.5, 0.2)

	local accentBar = Instance.new("Frame")
	accentBar.BackgroundColor3 = accent
	accentBar.BorderSizePixel = 0
	accentBar.Size = UDim2.new(0, 4, 1, 0)
	accentBar.Parent = frame
	makeCorner(accentBar, 2)

	local titleLbl = Instance.new("TextLabel")
	titleLbl.BackgroundTransparency = 1
	titleLbl.Position = UDim2.fromOffset(14, 8)
	titleLbl.Size = UDim2.new(1, -50, 0, 18)
	titleLbl.Font = Library.Theme.FontBold
	titleLbl.TextSize = 14
	titleLbl.TextColor3 = Library.Theme.Text
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.Text = title
	titleLbl.Parent = frame

	local contentLbl = Instance.new("TextLabel")
	contentLbl.BackgroundTransparency = 1
	contentLbl.Position = UDim2.fromOffset(14, 28)
	contentLbl.Size = UDim2.new(1, -24, 0, 0)
	contentLbl.Font = Library.Theme.Font
	contentLbl.TextSize = 12
	contentLbl.TextColor3 = Library.Theme.TextDim
	contentLbl.TextXAlignment = Enum.TextXAlignment.Left
	contentLbl.TextYAlignment = Enum.TextYAlignment.Top
	contentLbl.TextWrapped = true
	contentLbl.Text = content
	contentLbl.Parent = frame

	local textSize = Util.GetTextSize(content, 12, Library.Theme.Font, 280)
	local height = math.max(56, 40 + textSize.Y)
	contentLbl.Size = UDim2.new(1, -24, 0, textSize.Y + 4)

	local closeBtn = Instance.new("TextButton")
	closeBtn.BackgroundTransparency = 1
	closeBtn.Position = UDim2.new(1, -28, 0, 6)
	closeBtn.Size = UDim2.fromOffset(22, 22)
	closeBtn.Font = Library.Theme.FontBold
	closeBtn.TextSize = 16
	closeBtn.TextColor3 = Library.Theme.TextDim
	closeBtn.Text = "×"
	closeBtn.Parent = frame

	local progress = Instance.new("Frame")
	progress.BackgroundColor3 = accent
	progress.BorderSizePixel = 0
	progress.Position = UDim2.new(0, 0, 1, -3)
	progress.Size = UDim2.new(1, 0, 0, 3)
	progress.Parent = frame

	frame.Size = UDim2.new(1, 0, 0, height)
	table.insert(Library.Notifications, frame)

	-- Animate in
	frame.Position = UDim2.new(1, 20, 0, 0)
	Util.Tween(frame, {Position = UDim2.new(0, 0, 0, 0)}, 0.35, Enum.EasingStyle.Quint)

	local closed = false
	local function close()
		if closed then return end
		closed = true
		Util.Tween(frame, {Position = UDim2.new(1, 40, 0, 0)}, 0.3, Enum.EasingStyle.Quint)
		task.delay(0.35, function()
			if frame and frame.Parent then
				frame:Destroy()
			end
			for i, n in ipairs(Library.Notifications) do
				if n == frame then
					table.remove(Library.Notifications, i)
					break
				end
			end
		end)
	end

	closeBtn.MouseButton1Click:Connect(close)

	Util.Tween(progress, {Size = UDim2.new(0, 0, 0, 3)}, duration, Enum.EasingStyle.Linear)
	task.delay(duration, close)

	return {
		Close = close,
		Frame = frame,
	}
end

