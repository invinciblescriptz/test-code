function Library:ExportConfig()
	local cfg = {
		Flags = Library:GetFlags(),
		Theme = {
			MainColor = {Library.Theme.MainColor.R, Library.Theme.MainColor.G, Library.Theme.MainColor.B},
		},
		Version = Library.Version,
	}
	local ok, encoded = pcall(HttpService.JSONEncode, HttpService, cfg)
	return ok and encoded or nil
end

function Library:ImportConfig(jsonStr)
	local ok, data = pcall(HttpService.JSONDecode, HttpService, jsonStr)
	if not ok or type(data) ~= "table" then return false end
	if data.Flags then
		Library:LoadFlags(data.Flags)
	end
	if data.Theme and data.Theme.MainColor then
		local c = data.Theme.MainColor
		Library:SetTheme({
			MainColor = Color3.new(c[1], c[2], c[3]),
		})
	end
	return true
end

