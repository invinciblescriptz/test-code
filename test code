function Library:AddWindow(title, options)
	options = options or {}
	Library._windowCount = Library._windowCount + 1
	local zBase = Library._zIndexBase + Library._windowCount * 20

	local mainColor = options.main_color or options.MainColor or Library.Theme.MainColor
	local minSize = options.min_size or options.MinSize or Vector2.new(360, 300)
	local canResize = options.can_resize
	if canResize == nil then canResize = options.CanResize end
	if canResize == nil then canResize = true end

	Library.Theme.MainColor = mainColor
	Library.Theme.Accent = Util.Lighten(mainColor, 0.08)
	Library.Theme.SliderFill = mainColor
	Library.Theme.ToggleOn = mainColor

	local window = Instance.new("Frame")
	window.Name = "Window_" .. (title or "Elerium")
	window.BackgroundColor3 = Library.Theme.Background
	window.BorderSizePixel = 0
	window.Size = UDim2.fromOffset(minSize.X, minSize.Y)
	window.Position = UDim2.new(0.5, -minSize.X / 2, 0.5, -minSize.Y / 2)
	window.ClipsDescendants = true
	window.ZIndex = zBase
	window.Parent = ScreenGui
	makeCorner(window, 6)
	makeStroke(window, Library.Theme.Border, 1, 0.4)

	-- Title bar
	local titleBar = Instance.new("Frame")
	titleBar.Name = "TitleBar"
	titleBar.BackgroundColor3 = Library.Theme.TitleBar
	titleBar.BorderSizePixel = 0
	titleBar.Size = UDim2.new(1, 0, 0, 32)
	titleBar.ZIndex = zBase + 1
	titleBar.Parent = window
	makeCorner(titleBar, 6)

	local titleCover = Instance.new("Frame")
	titleCover.BackgroundColor3 = Library.Theme.TitleBar
	titleCover.BorderSizePixel = 0
	titleCover.Size = UDim2.new(1, 0, 0, 10)
	titleCover.Position = UDim2.new(0, 0, 1, -10)
	titleCover.ZIndex = zBase + 1
	titleCover.Parent = titleBar

	local titleLbl = Instance.new("TextLabel")
	titleLbl.BackgroundTransparency = 1
	titleLbl.Size = UDim2.new(1, -70, 1, 0)
	titleLbl.Position = UDim2.fromOffset(10, 0)
	titleLbl.Font = Library.Theme.FontBold
	titleLbl.TextSize = 14
	titleLbl.TextColor3 = Library.Theme.Text
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.Text = title or "Elerium Black"
	titleLbl.ZIndex = zBase + 2
	titleLbl.Parent = titleBar

	-- Close
	local closeBtn = Instance.new("TextButton")
	closeBtn.BackgroundTransparency = 1
	closeBtn.Size = UDim2.fromOffset(28, 28)
	closeBtn.Position = UDim2.new(1, -32, 0.5, -14)
	closeBtn.Font = Library.Theme.FontBold
	closeBtn.TextSize = 16
	closeBtn.TextColor3 = Library.Theme.TextDim
	closeBtn.Text = "×"
	closeBtn.ZIndex = zBase + 2
	closeBtn.Parent = titleBar

	closeBtn.MouseEnter:Connect(function() closeBtn.TextColor3 = Library.Theme.Error end)
	closeBtn.MouseLeave:Connect(function() closeBtn.TextColor3 = Library.Theme.TextDim end)

	-- Minimize
	local minBtn = Instance.new("TextButton")
	minBtn.BackgroundTransparency = 1
	minBtn.Size = UDim2.fromOffset(28, 28)
	minBtn.Position = UDim2.new(1, -60, 0.5, -14)
	minBtn.Font = Library.Theme.FontBold
	minBtn.TextSize = 15
	minBtn.TextColor3 = Library.Theme.TextDim
	minBtn.Text = "–"
	minBtn.ZIndex = zBase + 2
	minBtn.Parent = titleBar

	local minimized = false
	local savedSize = window.Size

	minBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		if minimized then
			savedSize = window.Size
			Util.Tween(window, {Size = UDim2.fromOffset(window.AbsoluteSize.X, 32)}, 0.18)
		else
			Util.Tween(window, {Size = savedSize}, 0.18)
		end
	end)

	closeBtn.MouseButton1Click:Connect(function()
		Util.Tween(window, {Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1}, 0.18)
		task.delay(0.2, function()
			window:Destroy()
			for i, w in ipairs(Library.Windows) do
				if w.Frame == window then
					table.remove(Library.Windows, i)
					break
				end
			end
		end)
	end)

	makeDraggable(window, titleBar)

	if canResize and not Util.IsMobile() then
		makeResizable(window, minSize)
	end

	-- Tab bar
	local tabBar = Instance.new("Frame")
	tabBar.Name = "TabBar"
	tabBar.BackgroundColor3 = Library.Theme.BackgroundDark
	tabBar.BorderSizePixel = 0
	tabBar.Size = UDim2.new(1, 0, 0, 30)
	tabBar.Position = UDim2.fromOffset(0, 32)
	tabBar.ZIndex = zBase + 1
	tabBar.Parent = window

	local tabScroll = Instance.new("ScrollingFrame")
	tabScroll.BackgroundTransparency = 1
	tabScroll.Size = UDim2.fromScale(1, 1)
	tabScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	tabScroll.ScrollBarThickness = 0
	tabScroll.ScrollingDirection = Enum.ScrollingDirection.X
	tabScroll.BorderSizePixel = 0
	tabScroll.Parent = tabBar

	local tabBtnHolder = Instance.new("Frame")
	tabBtnHolder.BackgroundTransparency = 1
	tabBtnHolder.Size = UDim2.new(0, 0, 1, 0)
	tabBtnHolder.AutomaticSize = Enum.AutomaticSize.X
	tabBtnHolder.Parent = tabScroll
	makeList(tabBtnHolder, 3, Enum.FillDirection.Horizontal)
	makePadding(tabBtnHolder, 5, 2, 5, 2)

	-- Content
	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.Size = UDim2.new(1, 0, 1, -62)
	content.Position = UDim2.fromOffset(0, 62)
	content.ZIndex = zBase
	content.Parent = window

	local windowApi = {
		Frame = window,
		Title = title,
		Tabs = {},
	}

	function windowApi:AddTab(tabTitle)
		local tab = createTab(windowApi, tabTitle, tabBtnHolder, content)
		table.insert(windowApi.Tabs, tab)
		if #windowApi.Tabs == 1 then
			tab:Show()
		end
		return tab
	end

	function windowApi:SetTitle(t)
		titleLbl.Text = tostring(t)
	end

	function windowApi:Destroy()
		window:Destroy()
	end

	function windowApi:Minimize()
		minBtn.MouseButton1Click:Fire()
	end

	function windowApi:SetVisible(v)
		window.Visible = v and true or false
	end

	table.insert(Library.Windows, windowApi)
	return windowApi
end

