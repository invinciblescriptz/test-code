        end

        -- Folder last so proxy sees every method
        function tab_data:AddFolder(name)
            local folder = FolderPrefab:Clone()
            folder.Header.Text = "    " .. tostring(name or "Folder")
            folder.Parent = tabFrame

            local open = false
            local content = folder.Content
            local arrow = folder.Header.Arrow
            local contentLayout = content:FindFirstChildOfClass("UIListLayout")

            local function updateFolderSize()
                if open and contentLayout then
                    local h = contentLayout.AbsoluteContentSize.Y + 42
                    Tween(folder, {Size = UDim2.new(1, 0, 0, math.max(30, h))}, 0.18)
                else
                    Tween(folder, {Size = UDim2.new(1, 0, 0, 30)}, 0.18)
                end
            end

            if contentLayout then
                contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                    if open then updateFolderSize() end
                end)
            end

            folder.Header.MouseButton1Click:Connect(function()
                open = not open
                content.Visible = open
                arrow.Text = open and "▾" or "▸"
                updateFolderSize()
            end)

            local fdata = {}
            local methods = {
                "AddLabel", "AddSection", "AddSeparator", "AddSpacer",
                "AddButton", "AddSwitch", "AddTextBox", "AddNumberBox",
                "AddSlider", "AddKeybind", "AddDropdown", "AddMultiDropdown",
                "AddProgressBar", "AddColorPicker", "AddConsole", "AddHorizontal"
            }
            for _, methodName in ipairs(methods) do
                local fn = tab_data[methodName]
                if fn then
                    fdata[methodName] = function(...)
                        local results = {fn(...)}
                        local obj = results[#results]
                        if typeof(obj) == "Instance" then
                            obj.Parent = content
                        end
                        if open then
                            task.defer(updateFolderSize)
                        end
                        return table.unpack(results)
                    end
                end
            end
            return fdata, folder
        end

        function tab_data:Show()
            show()
        end

        return tab_data, tabFrame
    end

    function window_data:GetWindow()
        return Window
    end

    function window_data:SetTitle(newTitle)
        Window.TitleBar.Title.Text = tostring(newTitle)
    end

    function window_data:Close()
        Window.TitleBar.Close.MouseButton1Click:Fire()
    end

    return window_data, Window
end

