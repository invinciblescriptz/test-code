		Text = text or "Feature",
		TextColor3 = Theme.Text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = zBase + 4,
		Parent = container,
	})

	local keyBtn = Create("TextButton", {
		BackgroundColor3 = Theme.Surface,
		Position = UDim2.new(1, -130, 0.5, -11),
		Size = UDim2.fromOffset(70, 22),
		Font = DefaultOptions.font,
		Text = key.Name,
		TextColor3 = Theme.TextDim,
		TextSize = 11,
		AutoButtonColor = false,
		ZIndex = zBase + 4,
		Parent = container,
	})
	ApplyCorner(keyBtn, 5)
	ApplyStroke(keyBtn, Theme.Border, 1, 0.5)

	local track = Create("Frame", {
		BackgroundColor3 = Theme.SwitchOff,
		Position = UDim2.new(1, -48, 0.5, -11),
		Size = UDim2.fromOffset(42, 22),
		ZIndex = zBase + 4,
		Parent = container,
	})
	ApplyCorner(track, 11)

	local knob = Create("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.fromOffset(16, 16),
		ZIndex = zBase + 5,
		Parent = track,
	})
	ApplyCorner(knob, 8)

	local data = {}

	function data:Set(value, fire)
		state = value and true or false
		if state then
			SafeTween(knob, {Position = UDim2.fromOffset(23, 3)}, AnimationPresets.Normal)
			SafeTween(track, {BackgroundColor3 = accent}, AnimationPresets.Normal)
		else
			SafeTween(knob, {Position = UDim2.fromOffset(3, 3)}, AnimationPresets.Normal)
			SafeTween(track, {BackgroundColor3 = Theme.SwitchOff}, AnimationPresets.Normal)
		end
		if fire ~= false then callback(state) end
	end

	function data:Get() return state end
	function data:SetKey(k) key = k; keyBtn.Text = k.Name end
	function data:GetKey() return key end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			data:Set(not state)
		end
	end)

	keyBtn.MouseButton1Click:Connect(function()
		listening = true
		keyBtn.Text = "..."
		SafeTween(keyBtn, {BackgroundColor3 = accent}, AnimationPresets.Fast)
	end)

	UserInputService.InputBegan:Connect(function(input, gpe)
		if listening and input.UserInputType == Enum.UserInputType.Keyboard then
			listening = false
			key = input.KeyCode
			keyBtn.Text = key.Name
			SafeTween(keyBtn, {BackgroundColor3 = Theme.Surface}, AnimationPresets.Fast)
		elseif not gpe and input.KeyCode == key and key ~= Enum.KeyCode.Unknown then
			data:Set(not state)
		end
	end)

	return data
end

