function library:AddWindow(title, options)
	options = options or {}
	local main_color = options.main_color or ui_options.main_color
	local min_size   = options.min_size or ui_options.min_size
	local can_resize = options.can_resize
	if can_resize == nil then can_resize = ui_options.can_resize end

	windows = windows + 1
	local zoff = windows * 10

	local win = Window:Clone()
	win.Visible = true
	win.Parent = imgui
	win.Size = UDim2.new(0, min_size.X, 0, min_size.Y)
	win.Position = UDim2.new(0.5, -min_size.X/2, 0.5, -min_size.Y/2)
	win.ImageColor3 = Color3.fromRGB(21, 22, 23)

	-- apply zindex
	for _, v in ipairs(win:GetDescendants()) do
		if v:IsA("GuiObject") then
			v.ZIndex = v.ZIndex + zoff
		end
	end
	win.ZIndex = zoff

	local bar = win:FindFirstChild("Bar")
	bar.BackgroundColor3 = main_color
	bar:FindFirstChild("Base").ImageColor3 = main_color
	bar:FindFirstChild("Top").ImageColor3 = main_color

	local titleLabel = win:FindFirstChild("Title")
	titleLabel.Text = title or "Elerium"
	titleLabel.ZIndex = zoff + 2

	local tabSelection = win:FindFirstChild("TabSelection")
	local tabButtons   = tabSelection:FindFirstChild("TabButtons")
	local tabsFrame    = win:FindFirstChild("Tabs")

	-- close / minimize via the old arrow
	local toggleBtn = bar:FindFirstChild("Toggle")
	local open = true
	toggleBtn.MouseButton1Click:Connect(function()
		open = not open
		if open then
			tween(win, {Size = UDim2.new(0, min_size.X, 0, min_size.Y)}, 0.2)
			toggleBtn.Rotation = 90
		else
			tween(win, {Size = UDim2.new(0, min_size.X, 0, 25)}, 0.2)
			toggleBtn.Rotation = 0
		end
	end)

	makeDraggable(win, bar)

	-- Resize
	if can_resize then
		local resizer = win:FindFirstChild("Resizer")
		local resizing, startPos, startSize
		resizer.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				resizing = true
				startPos = input.Position
				startSize = win.AbsoluteSize
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				resizing = false
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
				local delta = input.Position - startPos
				local newX = math.max(min_size.X, startSize.X + delta.X)
				local newY = math.max(min_size.Y, startSize.Y + delta.Y)
				win.Size = UDim2.new(0, newX, 0, newY)
			end
		end)
	end

	local window_data = {}
	local tab_list = {}

	function window_data:AddTab(name)
