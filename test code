local library = {}
local windowCount = 0
local WindowsFolder = Instance.new("Folder")
WindowsFolder.Name = "Windows"
WindowsFolder.Parent = imgui

local function makeElementParent(container)
	-- helper so folders can also receive elements
	return container
end

function library:AddWindow(title, options)
	windowCount += 1
	options = typeof(options) == "table" and options or ui_options
	title = tostring(title or "Window")

	local win = WindowTemplate:Clone()
	win.Name = "Window_" .. windowCount
	win.Title.Text = title
	win.Size = UDim2.fromOffset(options.min_size.X, options.min_size.Y)
	win.Position = UDim2.fromOffset(40 + (windowCount - 1) * 30, 40 + (windowCount - 1) * 25)
	win.ZIndex = windowCount * 10
	win.Parent = WindowsFolder

	local mainColor = options.main_color or ui_options.main_color
	win.Bar.BackgroundColor3 = mainColor

	-- Dragging
	local dragging, dragStart, startPos
	win.Bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = win.Position
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			win.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	-- Resizing
	if options.can_resize ~= false then
		local resizing, startSize, startMouse
		win.Resizer.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				resizing = true
				startSize = win.AbsoluteSize
				startMouse = input.Position
			end
		end)
		UIS.InputChanged:Connect(function(input)
			if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
				local delta = input.Position - startMouse
				local nx = math.max(options.min_size.X, startSize.X + delta.X)
				local ny = math.max(options.min_size.Y, startSize.Y + delta.Y)
				win.Size = UDim2.fromOffset(nx, ny)
			end
		end)
		UIS.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then resizing = false end
		end)
	else
		win.Resizer.Visible = false
	end

	-- Minimize
	local open = true
	win.Bar.Toggle.MouseButton1Click:Connect(function()
		open = not open
		win.Content.Visible = open
		win.TabBar.Visible = open and win.TabBar.Buttons:GetChildren()[1] ~= nil
		tween(win, {Size = open and UDim2.fromOffset(win.AbsoluteSize.X, options.min_size.Y) or UDim2.fromOffset(win.AbsoluteSize.X, 28)}, 0.2)
		win.Bar.Toggle.Rotation = open and 90 or 0
	end)

	local windowData = {}
	local tabs = {}
	local firstTab = true

	function windowData:AddTab(name)
		name = tostring(name or "Tab")

		local tabBtn = Instance.new("TextButton")
		tabBtn.BackgroundTransparency = 1
		tabBtn.Size = UDim2.fromOffset(70, 22)
		tabBtn.Font = Enum.Font.GothamBold
		tabBtn.Text = name
		tabBtn.TextColor3 = Color3.fromRGB(160, 160, 160)
		tabBtn.TextSize = 12
		tabBtn.AutoButtonColor = false
		tabBtn.Parent = win.TabBar.Buttons
		roundify(tabBtn, Color3.fromRGB(42, 43, 45))

		local page = Instance.new("ScrollingFrame")
		page.Name = name
		page.BackgroundTransparency = 1
		page.Size = UDim2.fromScale(1, 1)
		page.CanvasSize = UDim2.new(0, 0, 0, 0)
		page.ScrollBarThickness = 3
		page.Visible = firstTab
		page.Parent = win.Content

		local pageList = Instance.new("UIListLayout")
		pageList.SortOrder = Enum.SortOrder.LayoutOrder
		pageList.Padding = UDim.new(0, 6)
		pageList.Parent = page

		pageList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			page.CanvasSize = UDim2.new(0, 0, 0, pageList.AbsoluteContentSize.Y + 10)
		end)

		if firstTab then
			firstTab = false
			win.TabBar.Visible = true
			tabBtn.TextColor3 = Color3.new(1, 1, 1)
		end

		tabBtn.MouseButton1Click:Connect(function()
			for _, p in win.Content:GetChildren() do
				if p:IsA("ScrollingFrame") then p.Visible = false end
			end
			for _, b in win.TabBar.Buttons:GetChildren() do
				if b:IsA("TextButton") then b.TextColor3 = Color3.fromRGB(160, 160, 160) end
			end
			page.Visible = true
			tabBtn.TextColor3 = Color3.new(1, 1, 1)
		end)

		local function addTo(parent)
			local api = {}

			function api:AddLabel(text)
				local l = Label:Clone()
				l.Text = tostring(text)
				l.Parent = parent
				return l
			end

			function api:AddButton(text, callback)
				callback = typeof(callback) == "function" and callback or function() end
				local b = Button:Clone()
				b.Text = tostring(text)
				b.Parent = parent
				b.MouseButton1Click:Connect(function()
					ripple(b)
					callback()
				end)
				return b
			end

			function api:AddSwitch(text, callback)
				callback = typeof(callback) == "function" and callback or function() end
				local s = Switch:Clone()
				s.Text = "○  " .. tostring(text)
				s.Parent = parent
				local state = false

				local obj = {}
				function obj:Set(v)
					state = not not v
					s.Text = (state and "●  " or "○  ") .. tostring(text)
					callback(state)
				end
				s.MouseButton1Click:Connect(function()
					obj:Set(not state)
				end)
				return obj
			end

			function api:AddTextBox(placeholder, callback, opts)
				callback = typeof(callback) == "function" and callback or function() end
				opts = typeof(opts) == "table" and opts or {}
				local t = TextBox:Clone()
				t.PlaceholderText = tostring(placeholder)
				t.Parent = parent
				t.FocusLost:Connect(function(enter)
					if enter or opts.clear == false then
						callback(t.Text)
					end
					if opts.clear ~= false then
						t.Text = ""
					end
				end)
				return t
			end

			function api:AddSlider(text, callback, opts)
				callback = typeof(callback) == "function" and callback or function() end
				opts = typeof(opts) == "table" and opts or {}
				local minv = opts.min or 0
				local maxv = opts.max or 100
				local readonly = opts.readonly

				local s = Slider:Clone()
				s.Title.Text = tostring(text)
				s.Parent = parent
				local value = minv

				local function set(v)
					v = math.clamp(tonumber(v) or minv, minv, maxv)
					value = v
					local pct = (v - minv) / math.max(maxv - minv, 1e-6)
					s.Indicator.Size = UDim2.new(pct, 0, 1, 0)
					s.Value.Text = tostring(math.floor(v + 0.5))
					callback(v)
				end

				if not readonly then
					local hold = false
					s.InputBegan:Connect(function(i)
						if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
							hold = true
						end
					end)
					UIS.InputEnded:Connect(function(i)
						if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
							hold = false
						end
					end)
					UIS.InputChanged:Connect(function(i)
						if hold and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
							local rel = math.clamp((i.Position.X - s.AbsolutePosition.X) / s.AbsoluteSize.X, 0, 1)
							set(minv + rel * (maxv - minv))
						end
					end)
				end

				local obj = {}
				function obj:Set(v) set(v) end
				set(minv)
				return obj
			end

			function api:AddDropdown(text, callback)
				callback = typeof(callback) == "function" and callback or function() end
				local d = Dropdown:Clone()
				d.Text = "      " .. tostring(text)
				d.Parent = parent

				local open = false
				local function toggle()
					open = not open
					d.Box.Visible = open
					d.Arrow.Rotation = open and 0 or -90
					local h = 0
					for _, c in d.Box.Scroll:GetChildren() do
						if c:IsA("TextButton") then h += 22 end
					end
					d.Box.Size = UDim2.new(1, 0, 0, open and math.min(h + 4, 140) or 0)
				end

				d.MouseButton1Click:Connect(toggle)

				local obj = {}
				function obj:Add(option)
					local opt = Instance.new("TextButton")
					opt.BackgroundTransparency = 1
					opt.Size = UDim2.new(1, 0, 0, 20)
					opt.Font = Enum.Font.Gotham
					opt.Text = "  " .. tostring(option)
					opt.TextColor3 = Color3.fromRGB(200, 200, 200)
					opt.TextSize = 13
					opt.TextXAlignment = Enum.TextXAlignment.Left
					opt.AutoButtonColor = false
					opt.Parent = d.Box.Scroll
					roundify(opt, Color3.fromRGB(42, 43, 45))

					opt.MouseButton1Click:Connect(function()
						d.Text = "      " .. tostring(option)
						callback(tostring(option))
						if open then toggle() end
					end)

					local item = {}
					function item:Remove() opt:Destroy() end
					return item
				end
				return obj
			end

			function api:AddFolder(name)
				name = tostring(name or "Folder")
				local f = Folder:Clone()
				f.Title.Text = name
				f.Parent = parent

				local opened = false
				f.InputBegan:Connect(function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 then
						opened = not opened
						f.Content.Visible = opened
						f.Arrow.Rotation = opened and 0 or -90
						local h = 0
						for _, c in f.Content:GetChildren() do
							if c:IsA("GuiObject") then h += c.AbsoluteSize.Y + 5 end
						end
						f.Content.Size = UDim2.new(1, 0, 0, opened and h or 0)
						f.Size = UDim2.new(1, 0, 0, opened and (26 + h) or 22)
					end
				end)

				-- recursive API for folder content
				return addTo(f.Content)
			end

			function api:AddColorPicker(text, callback)
				callback = typeof(callback) == "function" and callback or function() end
				local cp = ColorPicker:Clone()
				cp.Title.Text = tostring(text or "Color")
				cp.Parent = parent

				local current = Color3.new(1, 1, 1)
				local obj = {}
				function obj:Set(c)
					current = typeof(c) == "Color3" and c or Color3.new(1, 1, 1)
					cp.Sample.BackgroundColor3 = current
					callback(current)
				end
				cp.Sample.InputBegan:Connect(function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 then
						-- simple cycle for demo; real version would open palette
						local h = (tick() % 1)
						obj:Set(Color3.fromHSV(h, 0.8, 1))
					end
				end)
				return obj
			end

			function api:AddKeybind(text, callback, opts)
				callback = typeof(callback) == "function" and callback or function() end
				opts = typeof(opts) == "table" and opts or {}
				local kb = Keybind:Clone()
				kb.Title.Text = tostring(text)
				kb.Input.Text = tostring(opts.standard and opts.standard.Name or "None")
				kb.Parent = parent

				local listening = false
				kb.Input.MouseButton1Click:Connect(function()
					listening = true
					kb.Input.Text = "..."
				end)

				local conn
				conn = UIS.InputBegan:Connect(function(input, gpe)
					if listening and not gpe and input.UserInputType == Enum.UserInputType.Keyboard then
						listening = false
						kb.Input.Text = input.KeyCode.Name
						callback(input.KeyCode)
					end
				end)
				return kb
			end

			function api:AddConsole(opts)
				opts = typeof(opts) == "table" and opts or {}
				local c = Console:Clone()
				c.Size = UDim2.new(1, 0, 0, opts.y or 160)
				c.Parent = parent
				local src = c.Scroll.Source
				src.TextEditable = not opts.readonly

				local obj = {}
				function obj:Set(code) src.Text = tostring(code or "") end
				function obj:Get() return src.Text end
				function obj:Log(msg)
					src.Text = src.Text .. "[*] " .. tostring(msg) .. "\n"
					c.Scroll.CanvasPosition = Vector2.new(0, 99999)
				end
				return obj
			end

			return api
		end

		local tabApi = addTo(page)
		function tabApi:Show()
			for _, p in win.Content:GetChildren() do
				if p:IsA("ScrollingFrame") then p.Visible = false end
			end
			page.Visible = true
			for _, b in win.TabBar.Buttons:GetChildren() do
				if b:IsA("TextButton") then b.TextColor3 = Color3.fromRGB(160, 160, 160) end
			end
			tabBtn.TextColor3 = Color3.new(1, 1, 1)
		end

		table.insert(tabs, tabApi)
		return tabApi
	end

	return windowData
end

function library:FormatWindows()
	-- optional layout helper
end

-- Global toggle
UIS.InputBegan:Connect(function(input, gpe)
	if not gpe and input.KeyCode == (ui_options.toggle_key or Enum.KeyCode.RightShift) then
		imgui.Enabled = not imgui.Enabled
	end
end)

return library
