local Theme = {}

function Theme.Apply(newTheme)
    State.Theme = Utility.Merge(State.Theme, newTheme or {})
    -- Broadcast theme change to all windows
    for _, win in pairs(State.Windows) do
        if win.UpdateTheme then
            win:UpdateTheme()
        end
    end
end

function Theme.Get()
    return Utility.DeepCopy(State.Theme)
end

function Theme.SetColor(key, color)
    if State.Theme[key] then
        State.Theme[key] = color
        Theme.Apply({})
    end
end

