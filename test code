		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 32),
		LayoutOrder = -100,
		Parent = tab.Page,
	})
	local box = Create("TextBox", {
		BackgroundColor3 = Color3.fromRGB(40, 40, 40),
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 28),
		Font = ui_options.font,
		PlaceholderText = placeholder or "Search...",
		PlaceholderColor3 = Color3.fromRGB(120, 120, 120),
		Text = "",
		TextColor3 = Color3.fromRGB(230, 230, 230),
		TextSize = 13,
		ClearTextOnFocus = false,
		Parent = searchFrame,
	})
	Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = box })
	Create("UIPadding", {
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		Parent = box,
	})

	box:GetPropertyChangedSignal("Text"):Connect(function()
		local query = string.lower(box.Text)
		for _, child in ipairs(tab.Page:GetChildren()) do
			if child:IsA("GuiObject") and child ~= searchFrame and child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" then
				if query == "" then
					child.Visible = true
				else
					local textContent = ""
					if child:IsA("TextLabel") or child:IsA("TextButton") then
						textContent = child.Text
					else
						local label = child:FindFirstChild("Label") or child:FindFirstChild("Title") or child:FindFirstChildWhichIsA("TextLabel")
						if label then
							textContent = label.Text
						end
					end
					child.Visible = string.find(string.lower(textContent), query, 1, true) ~= nil
				end
			end
		end
	end)

	return box
end

-- Multi-select dropdown variant
function Library:CreateMultiDropdown(tab, text, callback)
	local drop = DropdownPrefab:Clone()
	drop.Visible = true
	drop:FindFirstChild("Label").Text = text or "Multi Select"
	drop.Parent = tab.Page

	local button = drop:FindFirstChild("Button")
	local list = button:FindFirstChild("List")
	local arrow = button:FindFirstChild("Arrow")
	local open = false
	local selected = {}

	local function UpdateButtonText()
		local keys = {}
		for k in pairs(selected) do
			table.insert(keys, k)
		end
		if #keys == 0 then
			button.Text = "None"
		elseif #keys <= 2 then
			button.Text = table.concat(keys, ", ")
		else
			button.Text = #keys .. " selected"
		end
	end

	local function ToggleList(state)
		open = state
		list.Visible = open
		arrow.Text = open and "▲" or "▼"
		if open then
			local count = 0
			for _, c in ipairs(list:GetChildren()) do
				if c:IsA("TextButton") then count = count + 1 end
			end
			list.Size = UDim2.new(1, 0, 0, math.min(count * 26, 150))
		else
			list.Size = UDim2.new(1, 0, 0, 0)
		end
	end

	button.MouseButton1Click:Connect(function()
		ToggleList(not open)
	end)

	local api = {}
	function api:Add(optionText)
		local optBtn = Create("TextButton", {
			Name = optionText,
			BackgroundColor3 = Color3.fromRGB(40, 40, 40),
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 26),
			Font = ui_options.font,
			Text = "  " .. optionText,
			TextColor3 = Color3.fromRGB(200, 200, 200),
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			ZIndex = 21,
			Parent = list,
		})

		local check = Create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(1, -22, 0, 0),
			Size = UDim2.new(0, 18, 1, 0),
			Font = Enum.Font.GothamBold,
			Text = "",
			TextColor3 = Color3.fromRGB(100, 255, 100),
			TextSize = 14,
			ZIndex = 22,
			Parent = optBtn,
		})

		optBtn.MouseButton1Click:Connect(function()
			if selected[optionText] then
				selected[optionText] = nil
				check.Text = ""
				optBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
			else
				selected[optionText] = true
				check.Text = "✓"
				optBtn.BackgroundColor3 = Darken(tab.Window.MainColor, 0.3)
			end
			UpdateButtonText()
			if callback then
				local listSel = {}
				for k in pairs(selected) do table.insert(listSel, k) end
				task.spawn(callback, listSel)
			end
		end)

		return {
			Remove = function()
				optBtn:Destroy()
				selected[optionText] = nil
				UpdateButtonText()
			end,
		}
	end

	function api:Get()
		local listSel = {}
		for k in pairs(selected) do table.insert(listSel, k) end
		return listSel
	end

	function api:Set(items)
		selected = {}
		for _, item in ipairs(items or {}) do
			selected[item] = true
		end
		UpdateButtonText()
		-- update visual checks
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("TextButton") then
				local check = c:FindFirstChildWhichIsA("TextLabel")
				if selected[c.Name] then
					if check then check.Text = "✓" end
					c.BackgroundColor3 = Darken(tab.Window.MainColor, 0.3)
				else
					if check then check.Text = "" end
					c.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
				end
			end
		end
	end

	table.insert(tab.Elements, drop)
	return api
end

