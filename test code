	})

	local searchBox = Create("TextBox", {
		BackgroundColor3 = Theme.Surface,
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 30),
		Font = DefaultOptions.font,
		PlaceholderText = "Search...",
		PlaceholderColor3 = Theme.TextMuted,
		Text = "",
		TextColor3 = Theme.Text,
		TextSize = 14,
		ClearTextOnFocus = false,
		ZIndex = zBase + 4,
		Parent = container,
	})
	ApplyCorner(searchBox, 8)
	ApplyStroke(searchBox, Theme.Border, 1, 0.5)
	ApplyPadding(searchBox, 0, 0, 12, 12)

	local list = Create("ScrollingFrame", {
		BackgroundColor3 = Theme.BackgroundAlt,
		Position = UDim2.fromOffset(0, 58),
		Size = UDim2.new(1, 0, 0, 0),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		ScrollBarThickness = 3,
		Visible = false,
		ZIndex = zBase + 10,
		Parent = container,
	})
	ApplyCorner(list, 8)
	ApplyStroke(list, Theme.Border, 1, 0.4)
	ApplyPadding(list, 4, 4, 4, 4)

	local listLayout = Create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 2),
		Parent = list,
	})

	local function rebuildList(filter)
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		filtered = {}
		filter = (filter or ""):lower()
		for _, opt in ipairs(options) do
			if filter == "" or opt:lower():find(filter, 1, true) then
				table.insert(filtered, opt)
			end
		end
		for _, optName in ipairs(filtered) do
			local optBtn = Create("TextButton", {
				BackgroundColor3 = Theme.Surface,
				Size = UDim2.new(1, 0, 0, 28),
				Font = DefaultOptions.font,
				Text = "  " .. optName,
				TextColor3 = Theme.Text,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
				AutoButtonColor = false,
				ZIndex = zBase + 11,
				Parent = list,
			})
			ApplyCorner(optBtn, 6)
			optBtn.MouseEnter:Connect(function() SafeTween(optBtn, {BackgroundColor3 = accent}, AnimationPresets.Fast) end)
			optBtn.MouseLeave:Connect(function() SafeTween(optBtn, {BackgroundColor3 = Theme.Surface}, AnimationPresets.Fast) end)
			optBtn.MouseButton1Click:Connect(function()
				selected = optName
				searchBox.Text = optName
				callback(optName)
				open = false
				list.Visible = false
				list.Size = UDim2.new(1, 0, 0, 0)
				container.Size = UDim2.new(1, 0, 0, 56)
			end)
		end
		list.CanvasSize = UDim2.new(0, 0, 0, #filtered * 30 + 8)
	end

	local data = {}
	function data:Add(name)
		table.insert(options, name)
		if open then rebuildList(searchBox.Text) end
	end
	function data:Set(name)
		selected = name
		searchBox.Text = name
	end
	function data:Get() return selected end

	searchBox.Focused:Connect(function()
		open = true
		rebuildList(searchBox.Text)
		local height = math.min(#filtered * 30 + 8, 160)
		list.Visible = true
		SafeTween(list, {Size = UDim2.new(1, 0, 0, height)}, AnimationPresets.Normal)
		container.Size = UDim2.new(1, 0, 0, 56 + height + 6)
	end)

	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		if open then
			rebuildList(searchBox.Text)
			local height = math.min(#filtered * 30 + 8, 160)
			list.Size = UDim2.new(1, 0, 0, height)
			container.Size = UDim2.new(1, 0, 0, 56 + height + 6)
		end
	end)

	return data
end

