--  ANIMATION SYSTEM
-- ══════════════════════════════════════════════════════════════════════════════

local Anim = {}

function Anim.FadeIn(obj, duration)
	obj.Visible = true
	if obj:IsA("GuiObject") then
		local orig = obj.BackgroundTransparency
		obj.BackgroundTransparency = 1
		Util.Tween(obj, {BackgroundTransparency = orig}, duration or 0.2)
	end
end

function Anim.FadeOut(obj, duration, destroy)
	if not obj or not obj.Parent then return end
	local tw = Util.Tween(obj, {BackgroundTransparency = 1}, duration or 0.2)
	tw.Completed:Connect(function()
		if destroy then
			obj:Destroy()
		else
			obj.Visible = false
		end
	end)
end

function Anim.ScaleIn(obj, duration)
	obj.Visible = true
	local scale = Instance.new("UIScale")
	scale.Scale = 0.85
	scale.Parent = obj
	Util.Tween(scale, {Scale = 1}, duration or 0.2, Enum.EasingStyle.Back)
	task.delay((duration or 0.2) + 0.05, function()
		if scale and scale.Parent then scale:Destroy() end
	end)
end

function Anim.Slide(obj, from, to, duration)
	obj.Position = from
	Util.Tween(obj, {Position = to}, duration or 0.25, Enum.EasingStyle.Quint)
end

function Anim.Pulse(obj, times)
	times = times or 1
	task.spawn(function()
		for _ = 1, times do
			Util.Tween(obj, {BackgroundTransparency = 0.3}, 0.15)
			task.wait(0.15)
			Util.Tween(obj, {BackgroundTransparency = 0}, 0.15)
			task.wait(0.15)
		end
	end)
end

