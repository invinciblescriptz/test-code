	keyBtn.AutoButtonColor = false
	keyBtn.Parent = frame
	makeCorner(keyBtn, 4)
	makeStroke(keyBtn, Library.Theme.Border, 1, 0.5)

	local function setKey(k)
		key = k
		keyBtn.Text = k.Name ~= "Unknown" and k.Name or "None"
		listening = false
		Util.Tween(keyBtn, {BackgroundColor3 = Library.Theme.BackgroundDark}, 0.1)
	end

	keyBtn.MouseButton1Click:Connect(function()
		listening = true
		keyBtn.Text = "..."
		Util.Tween(keyBtn, {BackgroundColor3 = Library.Theme.MainColor}, 0.1)
	end)

	UserInputService.InputBegan:Connect(function(input, gp)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				if input.KeyCode == Enum.KeyCode.Escape then
					setKey(Enum.KeyCode.Unknown)
				else
					setKey(input.KeyCode)
					Util.SafeCallback(callback, key)
				end
			end
		elseif not gp and input.KeyCode == key and key ~= Enum.KeyCode.Unknown then
			Util.SafeCallback(callback, key)
		end
	end)

	local api = {}
	function api:Set(k)
		setKey(k)
	end
	function api:Get()
		return key
	end
	return api, frame
end

