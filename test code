-- NaN Lock
CreateToggle("NaN Lock", false, function(state)
    local player = LocalPlayer
    local targetCFrame = CFrame.new(-38.9849625, 0.111833394, 23.6454487,
        0.228692636, 5.38890532e-08, 0.973498702,
        9.52623491e-09, 1, -5.75939509e-08,
        -0.973498702, 2.24450893e-08, 0.228692636)

    if _G.NaNLockConnection then
        _G.NaNLockConnection:Disconnect()
        _G.NaNLockConnection = nil
    end

    if state then
        local args = {"changeSize", 0/0}
        ReplicatedStorage:WaitForChild("rEvents"):WaitForChild("changeSpeedSizeRemote"):InvokeServer(unpack(args))

        local function applyLock(character)
            local root = character:WaitForChild("HumanoidRootPart", 5)
            if not root then return end
            root.CFrame = targetCFrame
            root.Anchored = true
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero

            if _G.NaNLockConnection then _G.NaNLockConnection:Disconnect() end
            _G.NaNLockConnection = RunService.Heartbeat:Connect(function()
                if root and root.Parent then
                    root.CFrame = targetCFrame
                    root.Velocity = Vector3.zero
                    root.RotVelocity = Vector3.zero
                end
            end)
        end

        local char = player.Character or player.CharacterAdded:Wait()
        applyLock(char)

        if not _G.NaNCharacterAddedConn then
            _G.NaNCharacterAddedConn = player.CharacterAdded:Connect(function(newChar)
                task.wait(0.1)
                applyLock(newChar)
            end)
        end
    else
        local char = player.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                root.Anchored = false
                root.Velocity = Vector3.new(0, 5, 0)
            end
        end
        if _G.NaNLockConnection then
            _G.NaNLockConnection:Disconnect()
            _G.NaNLockConnection = nil
        end
    end
end)

