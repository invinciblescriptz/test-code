function Library:CreateContextMenu(items)
    local theme = self.CurrentTheme
    local menu = Instance.new("Frame")
    menu.Name = "ContextMenu"
    menu.Size = UDim2.new(0, 160, 0, #items * 28 + 8)
    menu.BackgroundColor3 = theme.Background2
    menu.BorderSizePixel = 0
    menu.Visible = false
    menu.ZIndex = 200
    createCorner(menu, 6)
    createStroke(menu, theme.Border, 1, 0.3)

    local layout = createListLayout(menu, 2)
    createPadding(menu, 4, 4, 4, 4)

    for _, item in ipairs(items) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 26)
        btn.BackgroundColor3 = theme.Background3
        btn.BorderSizePixel = 0
        btn.Font = DEFAULT_FONT
        btn.TextSize = 13
        btn.TextColor3 = theme.Text
        btn.Text = item.Text or "Item"
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.AutoButtonColor = false
        btn.ZIndex = 201
        btn.Parent = menu
        createCorner(btn, 4)
        createPadding(btn, 0, 0, 8, 4)

        btn.MouseEnter:Connect(function()
            tweenColor(btn, "BackgroundColor3", theme.Accent, 0.1)
        end)
        btn.MouseLeave:Connect(function()
            tweenColor(btn, "BackgroundColor3", theme.Background3, 0.1)
        end)
        btn.MouseButton1Click:Connect(function()
            menu.Visible = false
            if item.Callback then task.spawn(item.Callback) end
        end)
    end

    return {
        Show = function(_, x, y)
            menu.Position = UDim2.new(0, x or 0, 0, y or 0)
            menu.Visible = true
            menu.Parent = LocalPlayer.PlayerGui -- or CoreGui
        end,
        Hide = function()
            menu.Visible = false
        end,
        Frame = menu,
    }
end

