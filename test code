function Tab:AddSwitch(text, callback)
	callback = callback or function() end
	local state = false
	local frame = createElementBase(self)

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, -50, 1, 0)
	label.Position = UDim2.fromOffset(10, 0)
	label.Font = self.Window.Theme.font
	label.Text = text or "Switch"
	label.TextColor3 = self.Window.Theme.text_color
	label.TextSize = self.Window.Theme.font_size
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.ZIndex = 13
	label.Parent = frame

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
	track.Size = UDim2.fromOffset(36, 18)
	track.Position = UDim2.new(1, -44, 0.5, -9)
	track.ZIndex = 13
	track.Parent = frame
	makeCorner(track, 9)

	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.BackgroundColor3 = Color3.fromRGB(200, 200, 210)
	knob.Size = UDim2.fromOffset(14, 14)
	knob.Position = UDim2.fromOffset(2, 2)
	knob.ZIndex = 14
	knob.Parent = track
	makeCorner(knob, 7)

	local function setState(val, fire)
		state = val
		if state then
			tween(track, {BackgroundColor3 = self.Window.Theme.main_color}, 0.15)
			tween(knob, {Position = UDim2.fromOffset(20, 2), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}, 0.15)
		else
			tween(track, {BackgroundColor3 = Color3.fromRGB(60, 60, 70)}, 0.15)
			tween(knob, {Position = UDim2.fromOffset(2, 2), BackgroundColor3 = Color3.fromRGB(200, 200, 210)}, 0.15)
		end
		if fire ~= false then
			task.spawn(callback, state)
		end
	end

	local hit = Instance.new("TextButton")
	hit.BackgroundTransparency = 1
	hit.Size = UDim2.fromScale(1, 1)
	hit.ZIndex = 15
	hit.Text = ""
	hit.Parent = frame
	hit.MouseButton1Click:Connect(function()
		setState(not state)
	end)

	local obj = {
		Frame = frame,
		State = function() return state end,
		Set = function(_, val)
			setState(val, true)
		end,
		SetSilent = function(_, val)
			setState(val, false)
		end
	}
	return self:_addElement(obj)
end

