local Prefabs = {}

function Prefabs.CreateLabel(text, theme, size)
    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, -8, 0, size or 22)
    label.Font = DEFAULT_FONT
    label.TextSize = 14
    label.TextColor3 = theme.Text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = text or ""
    label.TextWrapped = true
    return label
end

function Prefabs.CreateButton(text, theme)
    local btn = Instance.new("TextButton")
    btn.Name = "Button"
    btn.Size = UDim2.new(1, -8, 0, 32)
    btn.BackgroundColor3 = theme.Background3
    btn.BorderSizePixel = 0
    btn.Font = DEFAULT_FONT_SEMI
    btn.TextSize = 14
    btn.TextColor3 = theme.Text
    btn.Text = text or "Button"
    btn.AutoButtonColor = false

    createCorner(btn, 6)
    createStroke(btn, theme.Border, 1, 0.4)

    btn.MouseEnter:Connect(function()
        tweenColor(btn, "BackgroundColor3", theme.Accent, 0.12)
    end)
    btn.MouseLeave:Connect(function()
        tweenColor(btn, "BackgroundColor3", theme.Background3, 0.12)
    end)
    btn.MouseButton1Down:Connect(function()
        tweenColor(btn, "BackgroundColor3", theme.AccentHover, 0.08)
        rippleEffect(btn, theme.AccentHover)
    end)
    btn.MouseButton1Up:Connect(function()
        tweenColor(btn, "BackgroundColor3", theme.Accent, 0.08)
    end)

    return btn
end

