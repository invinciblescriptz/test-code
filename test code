		end

		function tab_data:AddSlider(text, callback, opts)
			opts = opts or {}
			callback = typeof(callback) == "function" and callback or function() end
			local min = opts.min or 0
			local max = opts.max or 100
			local value = min

			local holder = Instance.new("Frame")
			holder.BackgroundTransparency = 1
			holder.Size = UDim2.new(1, 0, 0, 20)
			holder.Parent = page

			local bg = Instance.new("ImageLabel")
			bg.BackgroundTransparency = 1
			bg.Image = "rbxassetid://2851929490"
			bg.ImageColor3 = Color3.fromRGB(37, 38, 40)
			bg.ScaleType = Enum.ScaleType.Slice
			bg.SliceCenter = Rect.new(4, 4, 4, 4)
			bg.Size = UDim2.new(1, 0, 1, 0)
			bg.ZIndex = zoff + 1
			bg.Parent = holder

			local fill = Instance.new("ImageLabel")
			fill.BackgroundTransparency = 1
			fill.Image = "rbxassetid://2851929490"
			fill.ImageColor3 = Color3.fromRGB(65, 67, 71)
			fill.ScaleType = Enum.ScaleType.Slice
			fill.SliceCenter = Rect.new(4, 4, 4, 4)
			fill.Size = UDim2.new(0, 0, 1, 0)
			fill.ZIndex = zoff + 2
			fill.Parent = holder

			local title = Instance.new("TextLabel")
			title.BackgroundTransparency = 1
			title.Size = UDim2.new(1, -60, 1, 0)
			title.Font = Enum.Font.GothamBold
			title.TextSize = 14
			title.TextColor3 = Color3.fromRGB(200, 200, 200)
			title.TextXAlignment = Enum.TextXAlignment.Left
			title.Text = "  " .. (text or "Slider")
			title.ZIndex = zoff + 3
			title.Parent = holder

			local valLbl = Instance.new("TextLabel")
			valLbl.BackgroundTransparency = 1
			valLbl.Position = UDim2.new(1, -55, 0, 0)
			valLbl.Size = UDim2.new(0, 50, 1, 0)
			valLbl.Font = Enum.Font.GothamBold
			valLbl.TextSize = 14
			valLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
			valLbl.Text = "0%"
			valLbl.ZIndex = zoff + 3
			valLbl.Parent = holder

			local sliding = false

			local function set(v, fire)
				value = math.clamp(v, min, max)
				local pct = (value - min) / math.max(max - min, 1)
				fill.Size = UDim2.new(pct, 0, 1, 0)
				valLbl.Text = math.floor(value + 0.5) .. "%"
				if fire ~= false then
					pcall(callback, value)
				end
			end

			holder.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					local pct = math.clamp((input.Position.X - holder.AbsolutePosition.X) / holder.AbsoluteSize.X, 0, 1)
					set(min + pct * (max - min))
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local pct = math.clamp((input.Position.X - holder.AbsolutePosition.X) / holder.AbsoluteSize.X, 0, 1)
					set(min + pct * (max - min))
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = false
				end
			end)

			local api = {}
			function api:Set(v) set(v, true) end
			function api:Get() return value end
			return api
		end

