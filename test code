function Library:AddWindow(title, options)
	options = options or {}
	local mainColor = options.main_color or ui_options.main_color
	local minSize = options.min_size or ui_options.min_size
	local canResize = options.can_resize
	if canResize == nil then canResize = ui_options.can_resize end

	local win = setmetatable({}, Window)
	win.Tabs = {}
	win.CurrentTab = nil
	win.Visible = true
	win.Options = options

	local frame = WindowPrefab:Clone()
	frame.Visible = true
	frame.Size = UDim2.new(0, math.max(minSize.X, 450), 0, math.max(minSize.Y, 350))
	frame.Position = UDim2.new(0.5, -frame.Size.X.Offset / 2, 0.5, -frame.Size.Y.Offset / 2)
	frame.Parent = EleriumUI
	frame.ImageColor3 = Color3.fromRGB(22, 22, 22)

	local bar = frame:FindFirstChild("Bar")
	bar.BackgroundColor3 = mainColor
	local titleLabel = bar:FindFirstChild("Title")
	titleLabel.Text = title or "Elerium"

	local closeBtn = bar:FindFirstChild("Close")
	closeBtn.MouseButton1Click:Connect(function()
		frame.Visible = false
		win.Visible = false
	end)

	closeBtn.MouseEnter:Connect(function()
		Tween(closeBtn, { TextColor3 = Color3.fromRGB(255, 80, 80) }, 0.1)
	end)
	closeBtn.MouseLeave:Connect(function()
		Tween(closeBtn, { TextColor3 = Color3.fromRGB(200, 200, 200) }, 0.1)
	end)

	MakeDraggable(frame, bar)

	if canResize then
		MakeResizable(frame, minSize)
	end

	-- Toggle visibility with key
	SafeConnect(UserInputService.InputBegan, function(input, gp)
		if gp then return end
		if input.KeyCode == (options.toggle_key or ui_options.toggle_key) then
			frame.Visible = not frame.Visible
			win.Visible = frame.Visible
		end
	end)

	win.Frame = frame
	win.Body = frame:FindFirstChild("Body")
	win.TabButtons = win.Body:FindFirstChild("TabButtons")
	win.TabContent = win.Body:FindFirstChild("TabContent")
	win.MainColor = mainColor

	table.insert(Library.Windows, win)
	return win
