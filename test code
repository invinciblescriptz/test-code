			optBtn.Text = optionText
			optBtn.TextColor3 = self.Window.Theme.text_color
			optBtn.TextSize = self.Window.Theme.font_size - 1
			optBtn.ZIndex = 21
			optBtn.AutoButtonColor = false
			optBtn.Parent = dropFrame
			makeCorner(optBtn, 3)

			optBtn.MouseEnter:Connect(function()
				tween(optBtn, {BackgroundColor3 = self.Window.Theme.main_color}, 0.1)
			end)
			optBtn.MouseLeave:Connect(function()
				tween(optBtn, {BackgroundColor3 = Color3.fromRGB(45, 45, 55)}, 0.1)
			end)

			optBtn.MouseButton1Click:Connect(function()
				selected = optionText
				btn.Text = "  " .. optionText .. "  ▼"
				toggle()
				task.spawn(callback, optionText)
			end)

			local entry = {
				Button = optBtn,
				Text = optionText,
				Remove = function()
					optBtn:Destroy()
					for i, o in ipairs(options) do
						if o.Text == optionText then
							table.remove(options, i)
							break
						end
					end
				end
			}
			table.insert(options, entry)
			return entry
		end,
		Get = function() return selected end,
		Set = function(_, val)
			selected = val
			btn.Text = "  " .. tostring(val) .. "  ▼"
		end
	}
	return self:_addElement(obj)
end

