function Elements.RadioGroup(parent, title, items, callback, options)
	options = options or {}
	callback = typeof(callback) == "function" and callback or function() end
	local selected = options.Default or (items and items[1])

	local frame = Instance.new("Frame")
	frame.Name = "RadioGroup"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.new(1, 0, 0, 0)
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.Parent = parent

	if title then
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 0, 20)
		t.Font = Library.Theme.Font
		t.TextSize = 12
		t.TextColor3 = Library.Theme.TextDim
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.Text = title
		t.Parent = frame
		makePadding(t, 6, 0, 6, 0)
	end

	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.new(1, 0, 0, 0)
	holder.AutomaticSize = Enum.AutomaticSize.Y
	holder.Parent = frame
	makeList(holder, 2)

	local buttons = {}

	local function select(name)
		selected = name
		for n, b in pairs(buttons) do
			local dot = b:FindFirstChild("Dot")
			if dot then
				dot.BackgroundTransparency = (n == name) and 0 or 1
			end
		end
		Util.SafeCallback(callback, name)
	end

	for _, name in ipairs(items or {}) do
		local row = Instance.new("Frame")
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 26)
		row.Parent = holder

		local circle = Instance.new("Frame")
		circle.BackgroundColor3 = Library.Theme.BackgroundDark
		circle.BorderSizePixel = 0
		circle.Size = UDim2.fromOffset(18, 18)
		circle.Position = UDim2.fromOffset(8, 4)
		circle.Parent = row
		makeCorner(circle, 9)
		makeStroke(circle, Library.Theme.Border, 1, 0.4)

		local dot = Instance.new("Frame")
		dot.Name = "Dot"
		dot.BackgroundColor3 = Library.Theme.MainColor
		dot.BackgroundTransparency = (name == selected) and 0 or 1
		dot.BorderSizePixel = 0
		dot.Size = UDim2.fromOffset(10, 10)
		dot.Position = UDim2.fromOffset(4, 4)
		dot.Parent = circle
		makeCorner(dot, 5)

		local lbl = Instance.new("TextLabel")
		lbl.BackgroundTransparency = 1
		lbl.Size = UDim2.new(1, -36, 1, 0)
		lbl.Position = UDim2.fromOffset(32, 0)
		lbl.Font = Library.Theme.Font
		lbl.TextSize = 13
		lbl.TextColor3 = Library.Theme.Text
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.Text = name
		lbl.Parent = row

		local hit = Instance.new("TextButton")
		hit.BackgroundTransparency = 1
		hit.Size = UDim2.fromScale(1, 1)
		hit.Text = ""
		hit.Parent = row
		hit.MouseButton1Click:Connect(function()
			select(name)
		end)

		buttons[name] = circle
	end

	local api = {}
	function api:Set(name)
		select(name)
	end
	function api:Get()
		return selected
	end
	return api, frame
end

