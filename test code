		Position = UDim2.new(0, 0, 1, -12),
		Size = UDim2.new(1, 0, 0, 12),
		BorderSizePixel = 0,
		ZIndex = zBase + 1,
		Parent = TitleBar,
	})

	local AccentLine = Create("Frame", {
		BackgroundColor3 = accent,
		Size = UDim2.new(1, 0, 0, 2),
		Position = UDim2.new(0, 0, 1, -2),
		BorderSizePixel = 0,
		ZIndex = zBase + 2,
