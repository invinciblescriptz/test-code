    return btn
end

function TabObject:AddSwitch(text, callback)
    local cont, track, knob, click = Prefabs.CreateToggle(text, self.Theme)
    addElementToContainer(self.Content, cont)
    local obj = SwitchObject.new(track, knob, self.Theme, callback)
    click.MouseButton1Click:Connect(function()
        obj:Toggle()
    end)
    table.insert(self.Elements, obj)
    return obj
end

function TabObject:AddSlider(text, callback, options)
    options = options or {}
    local min = options.min or options["min"] or 0
    local max = options.max or options["max"] or 100
    local cont, track, fill, knob, valueLabel, hitbox = Prefabs.CreateSlider(text, self.Theme)
    addElementToContainer(self.Content, cont)

    local obj = SliderObject.new(fill, kno, valueLabel, track, min, max, callback, self.Theme)
    -- fix typo
    obj = SliderObject.new(fill, knob, valueLabel, track, min, max, callback, self.Theme)

    local dragging = false
    local function update(input)
        local absPos = track.AbsolutePosition.X
        local absSize = track.AbsoluteSize.X
        local rel = clamp((input.Position.X - absPos) / absSize, 0, 1)
        local value = min + (max - min) * rel
        obj:Set(value)
    end

    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    hitbox.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or
                         input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)

    obj:Set(min, true)
    table.insert(self.Elements, obj)
    return obj
end

function TabObject:AddTextBox(text, callback, options)
    options = options or {}
    local clearOnSubmit = options.clear ~= false
    local cont, box = Prefabs.CreateTextBox(text, self.Theme)
    addElementToContainer(self.Content, cont)

    box.FocusLost:Connect(function(enter)
        if enter and callback then
            task.spawn(callback, box.Text)
            if clearOnSubmit then
                box.Text = ""
            end
        end
    end)

    table.insert(self.Elements, box)
    return box
end

function TabObject:AddDropdown(text, callback)
    local cont, button, arrow, listFrame, listScroll, listLayout =
        Prefabs.CreateDropdown(text, self.Theme)
    addElementToContainer(self.Content, cont)

    local obj = DropdownObject.new(cont, button, arrow, listFrame, listScroll, listLayout, self.Theme, callback)

    button.MouseButton1Click:Connect(function()
        obj:Toggle()
    end)

    -- Close when clicking outside (simple version)
    UserInputService.InputBegan:Connect(function(input)
        if obj.Open and input.UserInputType == Enum.UserInputType.MouseButton1 then
            local mousePos = UserInputService:GetMouseLocation()
            local absPos = cont.AbsolutePosition
            local absSize = cont.AbsoluteSize
            if mousePos.X < absPos.X or mousePos.X > absPos.X + absSize.X or
               mousePos.Y < absPos.Y or mousePos.Y > absPos.Y + absSize.Y + 10 then
                obj:Close()
            end
        end
    end)

    table.insert(self.Elements, obj)
    return obj
end

function TabObject:AddColorPicker(callback)
    local cont, preview, label, click = Prefabs.CreateColorPicker(self.Theme)
    addElementToContainer(self.Content, cont)

    local obj = ColorPickerObject.new(preview, callback)

    -- Simple color picker: cycles through a palette on click (full HSV picker would be much longer)
    local palette = {
        Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 128, 0), Color3.fromRGB(255, 255, 0),
        Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 255, 255), Color3.fromRGB(0, 128, 255),
        Color3.fromRGB(128, 0, 255), Color3.fromRGB(255, 0, 255), Color3.fromRGB(255, 255, 255),
        Color3.fromRGB(128, 128, 128), Color3.fromRGB(0, 0, 0), Color3.fromRGB(41, 74, 122),
    }
    local idx = 1

    click.MouseButton1Click:Connect(function()
        idx = idx % #palette + 1
        obj:Set(palette[idx])
    end)

    -- Right-click opens a more advanced (but still compact) HSV panel
    click.MouseButton2Click:Connect(function()
        -- For brevity we keep the cycle; a full picker can be expanded here
        idx = idx % #palette + 1
        obj:Set(palette[idx])
    end)

    table.insert(self.Elements, obj)
    return obj
end

function TabObject:AddConsole(options)
    options = options or {}
    local height = options.y or options.height or 160
    local cont, scroll, addLine = Prefabs.CreateConsole(self.Theme, height)
    addElementToContainer(self.Content, cont)

    local consoleObj = {
        Frame = cont,
        Scroll = scroll,
        AddLine = addLine,
        Log = function(_, msg, color)
            addLine(tostring(msg), color)
        end,
        Clear = function()
            for _, child in ipairs(scroll:GetChildren()) do
                if child:IsA("TextLabel") then child:Destroy() end
            end
        end,
    }

    table.insert(self.Elements, consoleObj)
    return consoleObj
end

function TabObject:AddFolder(name)
    name = name or "Folder"
    local cont, header, arrow, content, contentLayout = Prefabs.CreateFolder(self.Theme)
    header.Text = "  " .. name
    addElementToContainer(self.Content, cont)

    local open = false
    local folderTab = setmetatable({
        Content = content,
        Theme = self.Theme,
        Elements = {},
        Window = self.Window,
    }, TabObject)

    -- Proxy all Add* methods
    for k, v in pairs(TabObject) do
        if type(v) == "function" and k:sub(1, 3) == "Add" then
            folderTab[k] = v
        end
    end

    header.MouseButton1Click:Connect(function()
        open = not open
        content.Visible = open
        arrow.Text = open and "▼" or "▶"
        if open then
            local h = contentLayout.AbsoluteContentSize.Y + 40
            tween(cont, {Size = UDim2.new(1, -8, 0, h)}, 0.2)
        else
            tween(cont, {Size = UDim2.new(1, -8, 0, 32)}, 0.2)
        end
    end)

