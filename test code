local Library = {}
Library.__index = Library

function Library.new(options)
    options = options or {}
    local self = setmetatable({}, Library)

    -- Destroy old instance
    pcall(function()
        local old = CoreGui:FindFirstChild("CustomUI_Library")
        if old then old:Destroy() end
        local old2 = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("CustomUI_Library")
        if old2 then old2:Destroy() end
    end)

    self.Options = {
        Title = options.Title or "Custom UI",
        ToggleKey = options.ToggleKey or Enum.KeyCode.RightShift,
        Theme = options.Theme or "Dark",
        MinSize = options.MinSize or Vector2.new(420, 380),
        CanResize = options.CanResize ~= false,
        SaveConfig = options.SaveConfig ~= false,
        ConfigName = options.ConfigName or "CustomUI_Config",
        Acrylic = options.Acrylic or false,
    }

    self.Theme = ThemeManager.new(self.Options.Theme)
    self.Config = ConfigManager.new(self.Options.ConfigName)
    self.Config:Load()

    self.Windows = {}
    self.Flags = {}
    self.Connections = {}
    self.Visible = true
    self.Initialized = false

    -- Main ScreenGui
    self.ScreenGui = Utility.Create("ScreenGui", {
        Name = "CustomUI_Library",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        Parent = (gethui and gethui()) or CoreGui,
    })

    self.Notifications = NotificationManager.new(self.ScreenGui, self.Theme)
    self.Tooltips = TooltipManager.new(self.ScreenGui, self.Theme)

    -- Toggle key
    table.insert(self.Connections, UIS.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == self.Options.ToggleKey then
            self:Toggle()
        end
    end))

    self.Initialized = true
    return self
end

function Library:Toggle()
    self.Visible = not self.Visible
    self.ScreenGui.Enabled = self.Visible
end

function Library:SetVisible(visible)
    self.Visible = visible
    self.ScreenGui.Enabled = visible
end

function Library:Notify(options)
    return self.Notifications:Notify(options)
end

function Library:SetTheme(themeName)
    self.Theme:SetTheme(themeName)
    -- In a full implementation we would update all existing elements
    self:Notify({
        Title = "Theme Changed",
        Content = "Switched to " .. themeName,
        Type = "Success",
        Duration = 2,
    })
end

function Library:GetFlag(flag)
    return self.Flags[flag]
end

function Library:SetFlag(flag, value)
    self.Flags[flag] = value
    if self.Options.SaveConfig then
        self.Config:Set(flag, value)
    end
end

function Library:Destroy()
    for _, connection in ipairs(self.Connections) do
        connection:Disconnect()
    end
    if self.ScreenGui then
        self.ScreenGui:Destroy()
    end
    setmetatable(self, nil)
end

