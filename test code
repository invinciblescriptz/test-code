function Elements.Slider(parent, text, callback, options)
	options = options or {}
	callback = typeof(callback) == "function" and callback or function() end
	local min = options.Min or options.min or 0
	local max = options.Max or options.max or 100
	local default = options.Default or options.default or min
	local decimals = options.Decimals or options.decimals or 0
	local suffix = options.Suffix or options.suffix or ""
	local value = Util.Clamp(default, min, max)

	local frame = Instance.new("Frame")
	frame.Name = "Slider"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.new(1, 0, 0, 48)
	frame.Parent = parent

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(0.65, 0, 0, 18)
	title.Position = UDim2.fromOffset(6, 2)
	title.Font = Library.Theme.Font
	title.TextSize = 13
	title.TextColor3 = Library.Theme.Text
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = text or "Slider"
	title.Parent = frame

	local valueLbl = Instance.new("TextLabel")
	valueLbl.BackgroundTransparency = 1
	valueLbl.Size = UDim2.new(0.35, -12, 0, 18)
	valueLbl.Position = UDim2.new(0.65, 0, 0, 2)
	valueLbl.Font = Library.Theme.FontMedium
	valueLbl.TextSize = 12
	valueLbl.TextColor3 = Library.Theme.TextDim
	valueLbl.TextXAlignment = Enum.TextXAlignment.Right
	valueLbl.Text = tostring(Util.Round(value, decimals)) .. suffix
	valueLbl.Parent = frame

	local track = Instance.new("Frame")
	track.Name = "Track"
	track.BackgroundColor3 = Library.Theme.SliderTrack
	track.BorderSizePixel = 0
	track.Size = UDim2.new(1, -12, 0, 6)
	track.Position = UDim2.fromOffset(6, 28)
	track.Parent = frame
	makeCorner(track, 3)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = Library.Theme.SliderFill
	fill.BorderSizePixel = 0
	fill.Size = UDim2.new((value - min) / math.max(max - min, 0.001), 0, 1, 0)
	fill.Parent = track
	makeCorner(fill, 3)

	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.BorderSizePixel = 0
	knob.Size = UDim2.fromOffset(14, 14)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.new((value - min) / math.max(max - min, 0.001), 0, 0.5, 0)
	knob.Parent = track
	makeCorner(knob, 7)
	makeStroke(knob, Library.Theme.MainColor, 1.5, 0)

	local sliding = false

	local function setValue(v, fire)
		value = Util.Clamp(v, min, max)
		local pct = (value - min) / math.max(max - min, 0.001)
		fill.Size = UDim2.new(pct, 0, 1, 0)
		knob.Position = UDim2.new(pct, 0, 0.5, 0)
		valueLbl.Text = tostring(Util.Round(value, decimals)) .. suffix
		if fire ~= false then
			Util.SafeCallback(callback, value)
		end
	end

	local function updateFromInput(input)
		local abs = track.AbsolutePosition.X
		local size = track.AbsoluteSize.X
		local pct = Util.Clamp((input.Position.X - abs) / size, 0, 1)
		setValue(min + pct * (max - min))
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			updateFromInput(input)
		end
	end)

	knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)

	local api = {}
	function api:Set(v)
		setValue(v, true)
	end
	function api:SetSilent(v)
		setValue(v, false)
	end
	function api:Get()
		return value
	end
	function api:SetMin(m)
		min = m
		setValue(value, false)
	end
	function api:SetMax(m)
		max = m
		setValue(value, false)
	end
	return api, frame
end

