local Notification = {}

function Notification.Show(options)
    options = typeof(options) == "table" and options or { Title = "Notification", Content = tostring(options) }
    local title = options.Title or "Notification"
    local content = options.Content or ""
    local duration = options.Duration or 4
    local notifType = options.Type or "Info" -- Info, Success, Warning, Error
    local color = State.Theme.AccentColor
    if notifType == "Success" then color = State.Theme.SuccessColor
    elseif notifType == "Warning" then color = State.Theme.WarningColor
    elseif notifType == "Error" then color = State.Theme.DangerColor end

    local notif = Utility.Create("Frame", {
        Name = "Notification",
        BackgroundColor3 = State.Theme.BackgroundColor,
        Size = UDim2.fromOffset(280, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = NotificationHolder
    })
    Utility.AddCorner(notif, 6)
    Utility.AddStroke(notif, color, 2)

    local accent = Utility.Create("Frame", {
        BackgroundColor3 = color,
        Size = UDim2.new(0, 4, 1, 0),
        BorderSizePixel = 0,
        Parent = notif
    })
    Utility.AddCorner(accent, 2)

    local titleLbl = Utility.Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(16, 10),
        Size = UDim2.new(1, -32, 0, 18),
        Font = State.Theme.FontBold,
        TextSize = 14,
        TextColor3 = State.Theme.TextColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = title,
        Parent = notif
    })

    local contentLbl = Utility.Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(16, 32),
        Size = UDim2.new(1, -32, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = State.Theme.Font,
        TextSize = 13,
        TextColor3 = State.Theme.SubTextColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Text = content,
        Parent = notif
    })

    Utility.AddPadding(notif, 8, 12, 0, 0)

    -- Position based on setting
    local pos = State.Theme.NotificationPosition
    if pos == "TopRight" then
        notif.Position = UDim2.new(1, -300, 0, 20 + (#State.Notifications * 90))
        notif.AnchorPoint = Vector2.new(0, 0)
    elseif pos == "TopLeft" then
        notif.Position = UDim2.new(0, 20, 0, 20 + (#State.Notifications * 90))
    elseif pos == "BottomRight" then
        notif.Position = UDim2.new(1, -300, 1, -80 - (#State.Notifications * 90))
    else
        notif.Position = UDim2.new(0, 20, 1, -80 - (#State.Notifications * 90))
    end

    table.insert(State.Notifications, notif)

    -- Animate in
    notif.BackgroundTransparency = 1
    titleLbl.TextTransparency = 1
    contentLbl.TextTransparency = 1
    Utility.Tween(notif, { BackgroundTransparency = 0 }, 0.3)
    Utility.Tween(titleLbl, { TextTransparency = 0 }, 0.3)
    Utility.Tween(contentLbl, { TextTransparency = 0 }, 0.3)

    task.delay(duration, function()
        Utility.Tween(notif, { BackgroundTransparency = 1 }, 0.3)
        Utility.Tween(titleLbl, { TextTransparency = 1 }, 0.3)
        Utility.Tween(contentLbl, { TextTransparency = 1 }, 0.3)
        task.wait(0.35)
        for i, n in ipairs(State.Notifications) do
            if n == notif then
                table.remove(State.Notifications, i)
                break
            end
        end
        notif:Destroy()
    end)

    return notif
end

