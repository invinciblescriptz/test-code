-- ============================================================================
-- EXTENDED: PLAYER LIST HELPER
-- ============================================================================

function Tab:AddPlayerList(callback)
	callback = callback or function() end
	local frame = createElementBase(self, 140)

	local scroller = Instance.new("ScrollingFrame")
	scroller.BackgroundTransparency = 1
	scroller.Size = UDim2.fromScale(1, 1)
	scroller.CanvasSize = UDim2.fromOffset(0, 0)
	scroller.ScrollBarThickness = 2
	scroller.ZIndex = 13
	scroller.Parent = frame
	makePadding(scroller, 4, 4, 4, 4)
	local list = makeList(scroller, 2)

	local function refresh()
		for _, c in ipairs(scroller:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			local btn = Instance.new("TextButton")
			btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
			btn.Size = UDim2.new(1, 0, 0, 22)
			btn.Font = self.Window.Theme.font
			btn.Text = "  " .. plr.Name
			btn.TextColor3 = self.Window.Theme.text_color
			btn.TextSize = 12
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.ZIndex = 14
			btn.Parent = scroller
			makeCorner(btn, 3)
			btn.MouseButton1Click:Connect(function()
				task.spawn(callback, plr)
			end)
		end
		scroller.CanvasSize = UDim2.fromOffset(0, list.AbsoluteContentSize.Y + 8)
	end

	refresh()
	Players.PlayerAdded:Connect(refresh)
	Players.PlayerRemoving:Connect(refresh)

	return self:_addElement({Frame = frame, Refresh = refresh})
end

