		open = force ~= nil and force or not open
		listFrame.Visible = open
		arrow.Text = open and "▲" or "▼"
		if open then
			local h = math.min(#items * 26 + 8, 160)
			Util.Tween(listFrame, {Size = UDim2.new(1, -12, 0, h)}, 0.15)
			frame.Size = UDim2.new(1, 0, 0, 52 + h)
		else
