-- =============================================
-- Roblox Username Whitelist (Server Script)
-- Place this in ServerScriptService
-- =============================================

local WHITELISTED_USERNAMES = {
    "YourUsernameHere",     -- ← CHANGE THIS TO YOUR USERNAME
    -- Add more usernames below:
    -- "Friend1",
    -- "Friend2",
}

local KICK_REASON = "You are not whitelisted on this game."

local Players = game:GetService("Players")

local function isWhitelisted(player)
    if not player or not player.Name then return false end
    
    local playerName = player.Name:lower()
    
    for _, name in ipairs(WHITELISTED_USERNAMES) do
        if name:lower() == playerName then
            return true
        end
    end
    return false
end

Players.PlayerAdded:Connect(function(player)
    task.wait(0.3) -- Small delay for better reliability
    
    if not isWhitelisted(player) then
        warn("[WHITELIST] " .. player.Name .. " is not whitelisted. Kicking...")
        player:Kick(KICK_REASON)
    else
        print("[WHITELIST] " .. player.Name .. " successfully joined (whitelisted)")
    end
end)

print("✅ Username Whitelist System Loaded | " .. #WHITELISTED_USERNAMES .. " user(s) whitelisted")
