			itemBtn.BackgroundColor3 = Library.Theme.Hover
		end)
		itemBtn.MouseLeave:Connect(function()
			itemBtn.BackgroundTransparency = 1
		end)
		itemBtn.MouseButton1Click:Connect(function()
			selected = name
			main.Text = name
			toggle(false)
			Util.SafeCallback(callback, name)
		end)

		local entry = {
			Name = name,
			Button = itemBtn,
			Remove = function()
				itemBtn:Destroy()
				for i, it in ipairs(items) do
					if it.Name == name then
						table.remove(items, i)
						break
					end
				end
				if open then
					local h = math.min(#items * 26 + 8, 160)
					listFrame.Size = UDim2.new(1, -12, 0, h)
					frame.Size = UDim2.new(1, 0, 0, 52 + h)
				end
			end,
		}
		table.insert(items, entry)
		return entry
	end

	local api = {}
	function api:Add(name)
		return addItem(tostring(name))
	end
	function api:Set(name)
		selected = name
		main.Text = name
	end
	function api:Get()
		return selected
	end
	function api:Clear()
		for _, it in ipairs(items) do
			it.Button:Destroy()
		end
		items = {}
		selected = nil
		main.Text = options.Placeholder or "Select..."
	end
	function api:GetItems()
		local t = {}
		for _, it in ipairs(items) do
			table.insert(t, it.Name)
		end
		return t
	end
	return api, frame
end

