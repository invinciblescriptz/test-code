-- BUTTON
local function CreateButton(parent, text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 55)
    btn.BackgroundColor3 = THEME.Surface2
    btn.Text = text
    btn.TextColor3 = THEME.Text
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 17
    btn.Parent = parent or scrolling
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)
    
    local s = Instance.new("UIStroke")
    s.Color = THEME.Accent
    s.Transparency = 0.65
    s.Parent = btn

    btn.MouseButton1Click:Connect(function()
        callback()
        TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = THEME.Accent}):Play()
        task.wait(0.12)
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = THEME.Surface2}):Play()
    end)
end

-- TOGGLE (unchanged)
local function CreateToggle(text, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 55)
    frame.BackgroundTransparency = 1
    frame.Parent = scrolling

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.65, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = THEME.Text
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 17
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0, 65, 0, 34)
    toggle.Position = UDim2.new(1, -75, 0.5, -17)
    toggle.BackgroundColor3 = default and THEME.Accent or THEME.Surface2
    toggle.Text = ""
    toggle.Parent = frame
    Instance.new("UICorner", toggle).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 27, 0, 27)
    knob.Position = default and UDim2.new(1, -32, 0.5, -13.5) or UDim2.new(0, 3.5, 0.5, -13.5)
    knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
    knob.Parent = toggle
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local state = default
    toggle.MouseButton1Click:Connect(function()
        state = not state
        TweenService:Create(toggle, TweenInfo.new(0.25), {BackgroundColor3 = state and THEME.Accent or THEME.Surface2}):Play()
        TweenService:Create(knob, TweenInfo.new(0.25), {Position = state and UDim2.new(1, -32, 0.5, -13.5) or UDim2.new(0, 3.5, 0.5, -13.5)}):Play()
        callback(state)
    end)
end

-- FOLDER
local function CreateFolder(name)
    local folderFrame = Instance.new("Frame")
    folderFrame.Size = UDim2.new(1, 0, 0, 50)
    folderFrame.BackgroundColor3 = THEME.Surface
    folderFrame.Parent = scrolling
    Instance.new("UICorner", folderFrame).CornerRadius = UDim.new(0, 12)

    local header = Instance.new("TextButton")
    header.Size = UDim2.new(1, 0, 0, 50)
    header.BackgroundTransparency = 1
    header.Text = " ▼ " .. name
    header.TextColor3 = THEME.Text
    header.Font = Enum.Font.GothamBold
    header.TextSize = 17
    header.TextXAlignment = Enum.TextXAlignment.Left
    header.Parent = folderFrame

    local content = Instance.new("Frame")
    content.Size = UDim2.new(1, 0, 0, 0)
    content.Position = UDim2.new(0, 0, 0, 50)
    content.BackgroundTransparency = 1
    content.ClipsDescendants = true
    content.Parent = folderFrame
    Instance.new("UIListLayout", content).Padding = UDim.new(0, 10)

    local open = false
    header.MouseButton1Click:Connect(function()
        open = not open
        header.Text = open and " ▲ " .. name or " ▼ " .. name
        local height = open and content:FindFirstChildWhichIsA("UIListLayout").AbsoluteContentSize.Y + 30 or 0
        TweenService:Create(content, TweenInfo.new(0.35, Enum.EasingStyle.Quint), {Size = UDim2.new(1,0,0,height)}):Play()
    end)

    return content
end

