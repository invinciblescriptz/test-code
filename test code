function NotificationManager:Notify(options)
    options = options or {}
    local title = options.Title or "Notification"
    local content = options.Content or ""
    local duration = options.Duration or self.DefaultDuration
    local notificationType = options.Type or "Info" -- Info, Success, Warning, Error
    local callback = options.Callback

    local accentColor = self.Theme:Get("Accent")
    if notificationType == "Success" then
        accentColor = self.Theme:Get("Success")
    elseif notificationType == "Warning" then
        accentColor = self.Theme:Get("Warning")
    elseif notificationType == "Error" then
        accentColor = self.Theme:Get("Error")
    end

    local notif = Utility.Create("Frame", {
        Name = "Notification",
        BackgroundColor3 = self.Theme:Get("Secondary"),
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ClipsDescendants = true,
        Parent = self.Container,
    })
    Utility.Create("UICorner", {
        CornerRadius = UDim.new(0, self.Theme:Get("CornerRadius")),
        Parent = notif,
    })
    Utility.Create("UIStroke", {
        Color = self.Theme:Get("Border"),
        Thickness = 1,
        Parent = notif,
    })

    local accentBar = Utility.Create("Frame", {
        BackgroundColor3 = accentColor,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 4, 1, 0),
        Parent = notif,
    })
    Utility.Create("UICorner", {
        CornerRadius = UDim.new(0, 4),
        Parent = accentBar,
    })

    local titleLabel = Utility.Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 10),
        Size = UDim2.new(1, -50, 0, 18),
        Font = self.Theme:Get("FontBold"),
        Text = title,
        TextColor3 = self.Theme:Get("Text"),
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = notif,
    })

    local contentLabel = Utility.Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 30),
        Size = UDim2.new(1, -32, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = self.Theme:Get("Font"),
        Text = content,
        TextColor3 = self.Theme:Get("SubText"),
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Parent = notif,
    })

    local closeBtn = Utility.Create("TextButton", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -28, 0, 6),
        Size = UDim2.new(0, 22, 0, 22),
        Font = self.Theme:Get("FontBold"),
        Text = "×",
        TextColor3 = self.Theme:Get("SubText"),
        TextSize = 16,
        Parent = notif,
    })

    local padding = Utility.Create("UIPadding", {
        PaddingBottom = UDim.new(0, 12),
        Parent = notif,
    })

    -- Entrance animation
    notif.Position = UDim2.new(1, 50, 0, 0)
    Utility.Tween(notif, {Position = UDim2.new(0, 0, 0, 0)}, 0.35, Enum.EasingStyle.Back)

    local function DestroyNotification()
        Utility.Tween(notif, {Position = UDim2.new(1, 50, 0, 0), BackgroundTransparency = 1}, 0.25)
        task.delay(0.3, function()
            if notif and notif.Parent then
                notif:Destroy()
            end
        end)
    end

    closeBtn.MouseButton1Click:Connect(DestroyNotification)

    if callback then
        notif.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                callback()
                DestroyNotification()
            end
        end)
    end

    if duration > 0 then
        task.delay(duration, DestroyNotification)
    end

    table.insert(self.Active, notif)
    return notif
end

