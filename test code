local Config = {}
Config.__index = Config

function Config.new()
    return setmetatable({ data = {} }, Config)
end

function Config:Set(key, value)
    self.data[key] = value
end

function Config:Get(key, default)
    local v = self.data[key]
    if v == nil then return default end
    return v
end

function Config:Save(name)
    name = name or "imgui_config"
    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, self.data)
    if ok then
        -- In a real executor environment you would write to a file.
        -- Here we just return the string so the user can store it.
        return encoded
    end
    return nil
end

function Config:Load(jsonString)
    if typeof(jsonString) ~= "string" then return false end
    local ok, decoded = pcall(HttpService.JSONDecode, HttpService, jsonString)
    if ok and typeof(decoded) == "table" then
        self.data = decoded
        return true
    end
    return false
end

function library:CreateConfig()
    return Config.new()
end

---------------------------------------------------------------------------
-- ADD WINDOW
---------------------------------------------------------------------------
function library:AddWindow(title, options)
    windows += 1
    title = tostring(title or "Window")
    options = typeof(options) == "table" and options or {}
    for k, v in pairs(ui_options) do
        if options[k] == nil then
            options[k] = v
        end
    end

    local Window = WindowPrefab:Clone()
    Window.Parent = Windows
    Window.TitleBar.Title.Text = title
    Window.Size = UDim2.fromOffset(options.min_size.X, options.min_size.Y)
    Window.Position = UDim2.fromOffset(40 + (windows - 1) * 30, 40 + (windows - 1) * 30)
    Window.Visible = true

    table.insert(window_list, Window)

    -- Z-Index
    local baseZ = windows * 25
    for _, d in ipairs(Window:GetDescendants()) do
        if hasprop(d, "ZIndex") then
            d.ZIndex = (d.ZIndex or 1) + baseZ
        end
    end
    Window.ZIndex = baseZ

    if options.shadow then
        makeShadow(Window)
    end

    -- Bring to front on click
    local function bringToFront()
        active_window = Window
        local highest = 0
        for _, w in ipairs(window_list) do
            if w and w.Parent and w.ZIndex > highest then
                highest = w.ZIndex
            end
        end
        if Window.ZIndex <= highest then
            local newBase = highest + 25
            for _, d in ipairs(Window:GetDescendants()) do
                if hasprop(d, "ZIndex") then
                    d.ZIndex = (d.ZIndex or 1) - baseZ + newBase
                end
            end
            Window.ZIndex = newBase
            baseZ = newBase
        end
    end

    Window.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            bringToFront()
        end
    end)

    -- Dragging
    local dragging, dragStart, startPos
    Window.TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Window.Position
            bringToFront()
        end
    end)
    Window.TitleBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Window.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    -- Minimize
    local minimized = false
    local oldSizeY = Window.AbsoluteSize.Y
    Window.TitleBar.Minimize.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            oldSizeY = Window.AbsoluteSize.Y
            Tween(Window, {Size = UDim2.fromOffset(Window.AbsoluteSize.X, 34)}, 0.2)
            Window.Content.Visible = false
        else
            Window.Content.Visible = true
            Tween(Window, {Size = UDim2.fromOffset(Window.AbsoluteSize.X, oldSizeY)}, 0.2)
        end
    end)

    -- Close
    Window.TitleBar.Close.MouseButton1Click:Connect(function()
        Tween(Window, {
            Size = UDim2.fromOffset(Window.AbsoluteSize.X, 0),
            BackgroundTransparency = 1
        }, 0.2)
        task.wait(0.22)
        for i, w in ipairs(window_list) do
            if w == Window then
                table.remove(window_list, i)
                break
            end
        end
        Window:Destroy()
    end)

    -- Title button hover
    for _, btn in ipairs({Window.TitleBar.Minimize, Window.TitleBar.Close}) do
        btn.MouseEnter:Connect(function()
            Tween(btn, {TextColor3 = ui_options.text}, 0.12)
        end)
        btn.MouseLeave:Connect(function()
            Tween(btn, {TextColor3 = ui_options.text_dim}, 0.12)
        end)
    end

    -- Resizing
    if options.can_resize then
        local resizer = Window:FindFirstChild("Resizer")
        if resizer then
            local resizing = false
            local resStart, sizeStart
            resizer.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    resizing = true
                    resStart = input.Position
                    sizeStart = Window.AbsoluteSize
                    bringToFront()
                end
            end)
            resizer.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    resizing = false
                end
            end)
            UIS.InputChanged:Connect(function(input)
                if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local delta = input.Position - resStart
                    local nx = math.max(options.min_size.X, sizeStart.X + delta.X)
                    local ny = math.max(options.min_size.Y, sizeStart.Y + delta.Y)
                    Window.Size = UDim2.fromOffset(nx, ny)
                end
            end)
        end
    end

    local window_data = {}
    local current_tab = nil
    local underline = Window.Content.TabBar.Underline

    function window_data:AddTab(tab_name)
        tab_name = tostring(tab_name or "Tab")
        Window.Content.TabBar.Visible = true

        local tabBtn = TabButtonPrefab:Clone()
        tabBtn.Text = tab_name
        tabBtn.Size = UDim2.fromOffset(gNameLen(tabBtn) + 10, 28)
        tabBtn.Parent = Window.Content.TabBar.TabButtons

        local tabFrame = Create("ScrollingFrame", {
            Name = tab_name,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = options.main_color,
            Visible = false,
            Parent = Window.Content.Tabs,
        })
        local layout = ListLayout(tabFrame, Enum.FillDirection.Vertical, 8)
        Padding(tabFrame, 4, 4, 10, 4)

        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            tabFrame.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 16)
        end)

        local function show()
            for _, t in ipairs(Window.Content.Tabs:GetChildren()) do
                if t:IsA("ScrollingFrame") then
                    t.Visible = false
                end
            end
            for _, b in ipairs(Window.Content.TabBar.TabButtons:GetChildren()) do
                if b:IsA("TextButton") then
                    b.TextColor3 = ui_options.text_dim
                end
            end
            tabFrame.Visible = true
            tabBtn.TextColor3 = options.main_color
            current_tab = tabFrame

            local abs = tabBtn.AbsolutePosition
            local parentAbs = Window.Content.TabBar.TabButtons.AbsolutePosition
            local offset = abs.X - parentAbs.X
            Tween(underline, {
                Position = UDim2.fromOffset(offset + 8, Window.Content.TabBar.AbsoluteSize.Y - 2),
                Size = UDim2.fromOffset(tabBtn.AbsoluteSize.X, 2)
            }, 0.15)
        end

        tabBtn.MouseButton1Click:Connect(show)
        if not current_tab then
            show()
        end

        local tab_data = {}

        -------------------------------------------------------------------
        -- ELEMENT FACTORIES
        -------------------------------------------------------------------
        function tab_data:AddLabel(text)
            local lbl = LabelPrefab:Clone()
            lbl.Text = tostring(text or "Label")
            lbl.Parent = tabFrame
            return lbl
        end

        function tab_data:AddSection(text)
            local sec = SectionPrefab:Clone()
            sec.Title.Text = string.upper(tostring(text or "Section"))
            sec.Parent = tabFrame
            return sec
        end

        function tab_data:AddSeparator()
            local sep = SeparatorPrefab:Clone()
            sep.Parent = tabFrame
            return sep
        end

        function tab_data:AddSpacer(height)
            local sp = SpacerPrefab:Clone()
            sp.Size = UDim2.new(1, 0, 0, height or 12)
            sp.Parent = tabFrame
            return sp
        end

        function tab_data:AddButton(text, callback)
            callback = typeof(callback) == "function" and callback or function() end
            local btn = ButtonPrefab:Clone()
            btn.Text = tostring(text or "Button")
            btn.Size = UDim2.fromOffset(math.max(110, gNameLen(btn)), 30)
            btn.Parent = tabFrame

            btn.MouseEnter:Connect(function()
                Tween(btn, {BackgroundColor3 = Color3.fromRGB(52, 52, 62)}, 0.12)
            end)
            btn.MouseLeave:Connect(function()
                Tween(btn, {BackgroundColor3 = ui_options.tertiary}, 0.12)
            end)
            btn.MouseButton1Click:Connect(function()
                ripple(btn, Mouse.X, Mouse.Y, options.main_color)
                safeCallback(callback)
            end)
            return btn
        end

        function tab_data:AddSwitch(text, callback)
            callback = typeof(callback) == "function" and callback or function() end
            local sw = SwitchPrefab:Clone()
            sw.Title.Text = tostring(text or "Switch")
            sw.Parent = tabFrame

            local toggled = false
            local track = sw.Track
            local knob = track.Knob

            local function set(state, silent)
                toggled = state and true or false
                if toggled then
                    Tween(track, {BackgroundColor3 = options.main_color}, 0.15)
                    Tween(knob, {Position = UDim2.new(1, -20, 0.5, -9)}, 0.15)
                else
                    Tween(track, {BackgroundColor3 = Color3.fromRGB(50, 50, 58)}, 0.15)
                    Tween(knob, {Position = UDim2.new(0, 2, 0.5, -9)}, 0.15)
                end
                if not silent then
                    safeCallback(callback, toggled)
                end
            end

            track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    set(not toggled)
                end
            end)

            local data = {}
            function data:Set(v, silent) set(v, silent) end
            function data:Get() return toggled end
            function data:Toggle() set(not toggled) end
            return data, sw
        end

        function tab_data:AddTextBox(placeholder, callback, opts)
            callback = typeof(callback) == "function" and callback or function() end
            opts = typeof(opts) == "table" and opts or {}
            local clearOnEnter = opts.clear ~= false

            local tb = TextBoxPrefab:Clone()
            tb.PlaceholderText = tostring(placeholder or "Input...")
            if opts.default then
                tb.Text = tostring(opts.default)
            end
            tb.Parent = tabFrame

            local stroke = tb:FindFirstChildOfClass("UIStroke")
            tb.Focused:Connect(function()
                if stroke then
                    Tween(stroke, {Color = options.main_color, Transparency = 0}, 0.12)
                end
            end)
            tb.FocusLost:Connect(function(enter)
                if stroke then
                    Tween(stroke, {Color = ui_options.border, Transparency = 0.45}, 0.12)
                end
                if enter and #tb.Text > 0 then
                    safeCallback(callback, tb.Text)
                    if clearOnEnter then
                        tb.Text = ""
                    end
                end
            end)
            return tb
