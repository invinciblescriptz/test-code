-- ══════════════════════════════════════════════════════════════════════════════
--  UTILITY / MATH / COLOR HELPERS
-- ══════════════════════════════════════════════════════════════════════════════

local Util = {}

function Util.Clamp(n, min, max)
	return math.max(min, math.min(max, n))
end

function Util.Lerp(a, b, t)
	return a + (b - a) * t
end

function Util.Round(n, places)
	local mult = 10 ^ (places or 0)
	return math.floor(n * mult + 0.5) / mult
end

function Util.Map(value, inMin, inMax, outMin, outMax)
	return outMin + (value - inMin) * (outMax - outMin) / (inMax - inMin)
end

function Util.IsMobile()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function Util.DeepCopy(t)
	if type(t) ~= "table" then return t end
	local copy = {}
	for k, v in pairs(t) do
		copy[Util.DeepCopy(k)] = Util.DeepCopy(v)
	end
	return copy
end

function Util.Merge(base, override)
	local result = Util.DeepCopy(base)
	if type(override) ~= "table" then return result end
	for k, v in pairs(override) do
		if type(v) == "table" and type(result[k]) == "table" then
			result[k] = Util.Merge(result[k], v)
		else
			result[k] = v
		end
	end
	return result
end

function Util.ColorToHex(c)
	return string.format("#%02X%02X%02X",
		math.floor(c.R * 255),
		math.floor(c.G * 255),
		math.floor(c.B * 255)
	)
end

function Util.HexToColor(hex)
	hex = hex:gsub("#", "")
	local r = tonumber(hex:sub(1, 2), 16) or 0
	local g = tonumber(hex:sub(3, 4), 16) or 0
	local b = tonumber(hex:sub(5, 6), 16) or 0
	return Color3.fromRGB(r, g, b)
end

function Util.Darken(c, amount)
	return Color3.new(
		Util.Clamp(c.R - amount, 0, 1),
		Util.Clamp(c.G - amount, 0, 1),
		Util.Clamp(c.B - amount, 0, 1)
	)
end

function Util.Lighten(c, amount)
	return Color3.new(
		Util.Clamp(c.R + amount, 0, 1),
		Util.Clamp(c.G + amount, 0, 1),
		Util.Clamp(c.B + amount, 0, 1)
	)
end

function Util.Saturate(c, amount)
	local h, s, v = Color3.toHSV(c)
	return Color3.fromHSV(h, Util.Clamp(s + amount, 0, 1), v)
end

function Util.Contrast(c)
	local luminance = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
	return luminance > 0.5 and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
end

function Util.CreateGradient(colors, rotation)
	local seq = {}
	local n = #colors
	for i, col in ipairs(colors) do
		table.insert(seq, ColorSequenceKeypoint.new((i - 1) / math.max(n - 1, 1), col))
	end
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(seq)
	g.Rotation = rotation or 90
	return g
end

function Util.Tween(obj, props, duration, style, direction)
	local info = TweenInfo.new(
		duration or 0.2,
		style or Enum.EasingStyle.Quad,
		direction or Enum.EasingDirection.Out
	)
	local tw = TweenService:Create(obj, info, props)
	tw:Play()
	return tw
end

function Util.Ripple(parent, x, y, color)
	local ripple = Instance.new("Frame")
	ripple.Name = "Ripple"
	ripple.BackgroundColor3 = color or Color3.new(1, 1, 1)
	ripple.BackgroundTransparency = 0.6
	ripple.BorderSizePixel = 0
	ripple.AnchorPoint = Vector2.new(0.5, 0.5)
	ripple.Position = UDim2.fromOffset(x, y)
	ripple.Size = UDim2.fromOffset(0, 0)
	ripple.ZIndex = 50
	ripple.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = ripple

	local size = math.max(parent.AbsoluteSize.X, parent.AbsoluteSize.Y) * 2.2
	Util.Tween(ripple, {
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1
	}, 0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	task.delay(0.5, function()
		if ripple and ripple.Parent then
			ripple:Destroy()
		end
	end)
end

function Util.PlayClickSound()
	-- Silent by default; users can hook their own sounds
end

function Util.SafeCallback(fn, ...)
	if type(fn) ~= "function" then return end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[EleriumCustom] Callback error:", err)
	end
end

function Util.GenerateId()
	return HttpService:GenerateGUID(false):gsub("-", ""):sub(1, 12)
end

function Util.GetTextSize(text, size, font, maxWidth)
	return TextService:GetTextSize(
		text or "",
		size or 14,
		font or Enum.Font.Gotham,
		Vector2.new(maxWidth or 9999, 9999)
	)
end

