	folderProxy.AddDropdown = function(_, t, cb) return Tab.AddDropdown(folderProxy, t, cb) end
	folderProxy.AddColorPicker = function(_, cb) return Tab.AddColorPicker(folderProxy, cb) end
	folderProxy.AddFolder = function(_, n) return Tab.AddFolder(folderProxy, n) end

	cList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		if open then
			container.Size = UDim2.new(1, -4, 0, cList.AbsoluteContentSize.Y + 8)
		end
	end)

	return self:_addElement(folderProxy)
end

