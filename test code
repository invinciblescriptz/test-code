-- Monkey-patch existing tab/folder creators to include extras
-- (Since createTab and createFolder already returned APIs, we enhance via a wrapper)

local _origAddWindow = Library.AddWindow
function Library:AddWindow(title, options)
	local win = _origAddWindow(self, title, options)
	local _origAddTab = win.AddTab
	function win:AddTab(tabTitle)
		local tab = _origAddTab(self, tabTitle)
		attachExtraMethods(tab, tab._page)
		local _origAddFolder = tab.AddFolder
		function tab:AddFolder(folderTitle)
			local folder = _origAddFolder(self, folderTitle)
			attachExtraMethods(folder, folder._content)
			return folder
		end
		return tab
	end
	return win
end

