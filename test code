local Tooltip = {
	_frame = nil,
	_label = nil,
	_visible = false,
}

function Tooltip.Init()
	local f = Instance.new("Frame")
	f.Name = "Tooltip"
	f.BackgroundColor3 = Library.Theme.BackgroundDark
	f.BorderSizePixel = 0
	f.Size = UDim2.fromOffset(0, 0)
	f.Visible = false
	f.ZIndex = 1000
	f.Parent = ScreenGui
	makeCorner(f, 4)
	makeStroke(f, Library.Theme.Border, 1, 0.3)

	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.Font = Library.Theme.Font
	lbl.TextSize = 12
	lbl.TextColor3 = Library.Theme.Text
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextWrapped = true
	lbl.ZIndex = 1001
	lbl.Parent = f
	makePadding(lbl, 8, 4, 8, 4)

	Tooltip._frame = f
	Tooltip._label = lbl
end

function Tooltip.Show(text, x, y)
	if not text or text == "" then return end
	local size = Util.GetTextSize(text, 12, Library.Theme.Font, 260)
	Tooltip._label.Text = text
	Tooltip._frame.Size = UDim2.fromOffset(size.X + 16, size.Y + 8)
	Tooltip._frame.Position = UDim2.fromOffset(x + 12, y + 12)
	Tooltip._frame.Visible = true
	Tooltip._visible = true
end

function Tooltip.Hide()
	Tooltip._frame.Visible = false
	Tooltip._visible = false
end

function Tooltip.Attach(guiObject, text)
	guiObject.MouseEnter:Connect(function()
		local pos = UserInputService:GetMouseLocation()
		Tooltip.Show(text, pos.X, pos.Y)
	end)
	guiObject.MouseLeave:Connect(function()
		Tooltip.Hide()
	end)
	guiObject.MouseMoved:Connect(function()
		if Tooltip._visible then
			local pos = UserInputService:GetMouseLocation()
			Tooltip._frame.Position = UDim2.fromOffset(pos.X + 12, pos.Y + 12)
		end
	end)
end

Tooltip.Init()

