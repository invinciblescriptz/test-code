		ApplyCorner(tabBtn, 6)

		local tabContent = Create("ScrollingFrame", {
			Name = tabName,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			CanvasSize = UDim2.new(0, 0, 0, 0),
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Theme.Border,
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = zBase + 2,
			Parent = Content,
		})
		ApplyPadding(tabContent, 12, 12, 14, 14)

		local listLayout = Create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
			Parent = tabContent,
		})

		listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			tabContent.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 20)
		end)

		local tabData = {
			Button = tabBtn,
			Content = tabContent,
			Name = tabName,
		}

		local function showTab()
			for _, t in pairs(windowData.Tabs) do
				t.Content.Visible = false
				Tween(t.Button, {BackgroundColor3 = Theme.Surface, TextColor3 = Theme.TextDim}, 0.15)
			end
			tabContent.Visible = true
			Tween(tabBtn, {BackgroundColor3 = accent, TextColor3 = Color3.new(1,1,1)}, 0.15)
			windowData.CurrentTab = tabData
		end

		tabBtn.MouseButton1Click:Connect(showTab)

		tabBtn.MouseEnter:Connect(function()
			if windowData.CurrentTab ~= tabData then
				Tween(tabBtn, {BackgroundColor3 = Theme.SurfaceHover}, 0.15)
			end
		end)
		tabBtn.MouseLeave:Connect(function()
			if windowData.CurrentTab ~= tabData then
				Tween(tabBtn, {BackgroundColor3 = Theme.Surface}, 0.15)
			end
		end)

		function tabData:Show()
			showTab()
		end

