CreateDropdown("Kill Targets (Click to add/remove)", true, function(player)
    local name = player.Name
    local index = table.find(targetPlayerNames, name)
    if index then
        table.remove(targetPlayerNames, index)
        print("Removed: " .. name)
    else
        table.insert(targetPlayerNames, name)
        print("Added: " .. name)
    end
end)

