--  GLOBAL TOGGLE + THEME API
-- ══════════════════════════════════════════════════════════════════════════════

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Library.ToggleKey then
		Library.Open = not Library.Open
		for _, w in ipairs(Library.Windows) do
			if w.Frame and w.Frame.Parent then
				w.Frame.Visible = Library.Open
			end
		end
	end
end)

function Library:SetTheme(themeTable)
	Library.Theme = Util.Merge(Library.Theme, themeTable or {})
end

function Library:GetTheme()
	return Util.DeepCopy(Library.Theme)
end

function Library:ResetTheme()
	Library.Theme = Util.DeepCopy(DefaultTheme)
end

function Library:SetToggleKey(key)
	if typeof(key) == "EnumItem" then
		Library.ToggleKey = key
	end
end

function Library:SetFlag(name, value) Library.Flags[name] = value end
function Library:GetFlag(name) return Library.Flags[name] end
function Library:GetFlags() return Util.DeepCopy(Library.Flags) end
function Library:LoadFlags(flags)
	if type(flags) ~= "table" then return end
	for k, v in pairs(flags) do Library.Flags[k] = v end
end

Library.Util = Util

function Library:IsMobile() return Util.IsMobile() end
function Library:GetVersion() return Library.Version end

print("[EleriumBlack] v" .. Library.Version .. " loaded.")

return Library
