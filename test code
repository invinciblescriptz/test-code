UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == (typeof(ui_options.toggle_key) == "EnumItem" and ui_options.toggle_key or Enum.KeyCode.RightShift) then
		if not checks.binding and imgui then
			imgui.Enabled = not imgui.Enabled
		end
	end
end)

local function Resize(part, props, delay)
	delay = delay or 0.1
	local ti = TweenInfo.new(delay, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(part, ti, props):Play()
end

local function gNameLen(obj)
	return obj.TextBounds.X + 15
end

local function gMouse()
	local pos = UIS:GetMouseLocation()
	return Vector2.new(pos.X, pos.Y - 36) -- account for topbar
end

local function ripple(button, x, y)
	task.spawn(function()
		button.ClipsDescendants = true
		local circle = Prefabs.Circle:Clone()
		circle.Parent = button
		circle.ZIndex = 1000

		local absPos = button.AbsolutePosition
		circle.Position = UDim2.new(0, x - absPos.X, 0, y - absPos.Y)

		local size = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 1.5
		circle:TweenSizeAndPosition(
			UDim2.new(0, size, 0, size),
			UDim2.new(0.5, -size/2, 0.5, -size/2),
			Enum.EasingDirection.Out,
			Enum.EasingStyle.Quad,
			0.4,
			true
		)
		Resize(circle, {ImageTransparency = 1}, 0.4)
		task.wait(0.45)
		circle:Destroy()
	end)
end

local windows = 0
local library = {}

function library:AddWindow(title, options)
	windows += 1
	local dropdown_open = false
	title = tostring(title or "New Window")
	options = typeof(options) == "table" and options or ui_options
	options.tween_time = options.tween_time or 0.1
	options.main_color = options.main_color or ui_options.main_color
	options.min_size = options.min_size or ui_options.min_size
	options.can_resize = options.can_resize ~= false

	local Window = Prefabs.Window:Clone()
	Window.Parent = Windows
	Window.Title.Text = title
	Window.Size = UDim2.new(0, options.min_size.X, 0, options.min_size.Y)
	Window.ZIndex = 10 + (windows * 10)

	-- Color the bar
	local function applyColor()
		Window.Bar.BackgroundColor3 = options.main_color
		Window.Bar.Base.BackgroundColor3 = options.main_color
		Window.Bar.Base.ImageColor3 = options.main_color
		Window.Bar.Top.ImageColor3 = options.main_color
		Window.TabSelection.Frame.BackgroundColor3 = options.main_color
	end
	applyColor()

	local Resizer = Window.Resizer
	local window_data = {}
	Window.Draggable = true

	-- Resize logic
	do
		local Entered, Held = false, false
		Resizer.MouseEnter:Connect(function()
			Entered = true
			Window.Draggable = false
		end)
		Resizer.MouseLeave:Connect(function()
			Entered = false
			Window.Draggable = true
		end)

		UIS.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				Held = true
				task.spawn(function()
					while Held and Entered and Resizer.Active and options.can_resize do
						local m = gMouse()
						local x = math.max(m.X - Window.AbsolutePosition.X, options.min_size.X)
						local y = math.max(m.Y - Window.AbsolutePosition.Y, options.min_size.Y)
						Resize(Window, {Size = UDim2.new(0, x, 0, y)}, options.tween_time)
						RS.Heartbeat:Wait()
					end
				end)
			end
		end)
		UIS.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				Held = false
			end
		end)
	end

	-- Open / Close
	do
		local open_close = Window.Bar.Toggle
		local open = true
		local canopen = true
		local oldy = Window.AbsoluteSize.Y
		local olddata = {}

		open_close.MouseButton1Click:Connect(function()
			if not canopen then return end
			canopen = false

			if open then
				olddata = {}
				for _, v in ipairs(Window.Tabs:GetChildren()) do
					olddata[v] = v.Visible
					v.Visible = false
				end
				Resizer.Active = false
				oldy = Window.AbsoluteSize.Y
				Resize(open_close, {Rotation = 0}, options.tween_time)
				Resize(Window, {Size = UDim2.new(0, Window.AbsoluteSize.X, 0, 26)}, options.tween_time)
				Window.Bar.Base.Transparency = 1
			else
				for i, v in pairs(olddata) do
					i.Visible = v
				end
				Resizer.Active = true
				Resize(open_close, {Rotation = 90}, options.tween_time)
				Resize(Window, {Size = UDim2.new(0, Window.AbsoluteSize.X, 0, oldy)}, options.tween_time)
				Window.Bar.Base.Transparency = 0
			end

			open = not open
			task.wait(options.tween_time + 0.05)
			canopen = true
		end)
	end

	-- Tabs
	local tabs = Window.Tabs
	local tab_selection = Window.TabSelection
	local tab_buttons = tab_selection.TabButtons

	function window_data:AddTab(tab_name)
		local tab_data = {}
		tab_name = tostring(tab_name or "New Tab")
		tab_selection.Visible = true

		local new_button = Prefabs.TabButton:Clone()
		new_button.Parent = tab_buttons
		new_button.Text = tab_name
		new_button.Size = UDim2.new(0, gNameLen(new_button), 0, 20)
		new_button.ZIndex = 20 + (windows * 10)
		new_button:FindFirstChild("TextButton_Roundify_4px").ZIndex = new_button.ZIndex

		local new_tab = Prefabs.Tab:Clone()
		new_tab.Parent = tabs
		new_tab.ZIndex = 10 + (windows * 10)

		local function show()
			if dropdown_open then return end
			for _, v in ipairs(tab_buttons:GetChildren()) do
				if v:IsA("TextButton") then
					v:FindFirstChild("TextButton_Roundify_4px").ImageColor3 = Color3.fromRGB(52, 53, 56)
					Resize(v, {Size = UDim2.new(0, v.AbsoluteSize.X, 0, 20)}, options.tween_time)
				end
			end
			for _, v in ipairs(tabs:GetChildren()) do
				v.Visible = false
			end
			Resize(new_button, {Size = UDim2.new(0, new_button.AbsoluteSize.X, 0, 25)}, options.tween_time)
			new_button:FindFirstChild("TextButton_Roundify_4px").ImageColor3 = Color3.fromRGB(73, 75, 79)
			new_tab.Visible = true
		end

		new_button.MouseButton1Click:Connect(show)
		function tab_data:Show() show() end

		-- Elements
		function tab_data:AddLabel(text)
			local label = Prefabs.Label:Clone()
			label.Parent = new_tab
			label.Text = tostring(text or "Label")
			label.Size = UDim2.new(0, gNameLen(label), 0, 20)
			label.ZIndex = 15 + (windows * 10)
			return label
		end

		function tab_data:AddButton(text, callback)
			callback = typeof(callback) == "function" and callback or function() end
			local button = Prefabs.Button:Clone()
			button.Parent = new_tab
			button.Text = tostring(text or "Button")
			button.Size = UDim2.new(0, gNameLen(button), 0, 20)
			button.ZIndex = 15 + (windows * 10)
			button:FindFirstChild("TextButton_Roundify_4px").ZIndex = button.ZIndex
			button:FindFirstChild("TextButton_Roundify_4px").ImageColor3 = options.main_color

			button.MouseButton1Click:Connect(function()
				ripple(button, mouse.X, mouse.Y)
				pcall(callback)
			end)
			return button
		end

		function tab_data:AddSwitch(text, callback)
			local data = {}
			callback = typeof(callback) == "function" and callback or function() end
			local switch = Prefabs.Switch:Clone()
			switch.Parent = new_tab
			switch.Title.Text = tostring(text or "Switch")
			switch.ZIndex = 15 + (windows * 10)
			switch.Title.ZIndex = switch.ZIndex
			switch:FindFirstChild("TextButton_Roundify_4px").ZIndex = switch.ZIndex
			switch:FindFirstChild("TextButton_Roundify_4px").ImageColor3 = options.main_color

			local toggled = false
			switch.MouseButton1Click:Connect(function()
				toggled = not toggled
				switch.Text = toggled and "✓" or ""
				pcall(callback, toggled)
			end)

			function data:Set(bool)
				toggled = bool == true
				switch.Text = toggled and "✓" or ""
				pcall(callback, toggled)
			end
			return data, switch
		end

		function tab_data:AddTextBox(placeholder, callback, opts)
			callback = typeof(callback) == "function" and callback or function() end
			opts = typeof(opts) == "table" and opts or {clear = true}
			local tb = Prefabs.TextBox:Clone()
			tb.Parent = new_tab
			tb.PlaceholderText = tostring(placeholder or "Text")
			tb.ZIndex = 15 + (windows * 10)
			tb:FindFirstChild("TextBox_Roundify_4px").ZIndex = tb.ZIndex

			tb.FocusLost:Connect(function(enter)
				if enter and #tb.Text > 0 then
					pcall(callback, tb.Text)
					if opts.clear then tb.Text = "" end
				end
			end)
			return tb
		end

		function tab_data:AddSlider(text, callback, opts)
			local data = {}
			callback = typeof(callback) == "function" and callback or function() end
			opts = typeof(opts) == "table" and opts or {}
			local minv = opts.min or 0
			local maxv = opts.max or 100
			local readonly = opts.readonly or false

			local slider = Prefabs.Slider:Clone()
			slider.Parent = new_tab
			slider.ZIndex = 15 + (windows * 10)
			slider.Title.Text = tostring(text or "Slider")
			slider.Title.ZIndex = slider.ZIndex
			slider.Indicator.ZIndex = slider.ZIndex
			slider.Value.ZIndex = slider.ZIndex

			local Entered, Held = false, false
			slider.MouseEnter:Connect(function()
				Entered = true
				Window.Draggable = false
			end)
			slider.MouseLeave:Connect(function()
				Entered = false
				Window.Draggable = true
			end)

			UIS.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					Held = true
					task.spawn(function()
						while Held and Entered and not readonly and not dropdown_open do
							local m = gMouse()
							local rel = math.clamp((m.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
							Resize(slider.Indicator, {Size = UDim2.new(rel, 0, 0, 20)}, options.tween_time)
							local val = math.floor(minv + (maxv - minv) * rel)
							slider.Value.Text = tostring(val)
							pcall(callback, val)
							RS.Heartbeat:Wait()
						end
					end)
				end
			end)
			UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					Held = false
				end
			end)

			function data:Set(val)
				val = tonumber(val) or minv
				val = math.clamp(val, minv, maxv)
				local rel = (maxv == minv) and 0 or (val - minv) / (maxv - minv)
				Resize(slider.Indicator, {Size = UDim2.new(rel, 0, 0, 20)}, options.tween_time)
				slider.Value.Text = tostring(math.floor(val))
				pcall(callback, math.floor(val))
			end
			data:Set(minv)
			return data, slider
		end

		function tab_data:AddKeybind(name, callback, opts)
			local data = {}
			callback = typeof(callback) == "function" and callback or function() end
			opts = typeof(opts) == "table" and opts or {}
			local current = opts.standard or Enum.KeyCode.RightShift

			local kb = Prefabs.Keybind:Clone()
			kb.Parent = new_tab
			kb.Title.Text = "  " .. tostring(name or "Keybind")
			kb.Size = UDim2.new(0, gNameLen(kb.Title) + 80, 0, 20)
			kb.ZIndex = 15 + (windows * 10)
			kb.Title.ZIndex = kb.ZIndex
			kb.Input.ZIndex = kb.ZIndex

			local short = {
				RightControl = "RightCtrl", LeftControl = "LeftCtrl",
				LeftShift = "LShift", RightShift = "RShift",
				MouseButton1 = "Mouse1", MouseButton2 = "Mouse2"
			}

			function data:SetKeybind(key)
				current = key
				kb.Input.Text = short[key.Name] or key.Name
			end
			data:SetKeybind(current)

			UIS.InputBegan:Connect(function(inp, gp)
				if checks.binding then
					task.defer(function() checks.binding = false end)
					return
				end
				if inp.KeyCode == current and not gp then
					pcall(callback, current)
				end
			end)

			kb.Input.MouseButton1Click:Connect(function()
				if checks.binding then return end
				kb.Input.Text = "..."
				checks.binding = true
				local inp = UIS.InputBegan:Wait()
				if inp.KeyCode ~= Enum.KeyCode.Unknown then
					data:SetKeybind(inp.KeyCode)
				end
				checks.binding = false
			end)

			return data, kb
		end

		function tab_data:AddDropdown(name, callback)
			local data = {}
			callback = typeof(callback) == "function" and callback or function() end

			local dd = Prefabs.Dropdown:Clone()
			dd.Parent = new_tab
			dd.Text = "      " .. tostring(name or "Dropdown")
			dd.ZIndex = 15 + (windows * 10)
			dd.Box.ZIndex = dd.ZIndex + 1
			dd.Box.Objects.ZIndex = dd.ZIndex + 1
			dd.Indicator.ZIndex = dd.ZIndex

			local open = false
			dd.MouseButton1Click:Connect(function()
				open = not open
				local count = #dd.Box.Objects:GetChildren() - 1
				local len = math.min(count, 10) * 20
				if count > 10 then
					dd.Box.Objects.CanvasSize = UDim2.new(0, 0, 0, count * 20)
				end

				if open then
					if dropdown_open then return end
					dropdown_open = true
					Resize(dd.Box, {Size = UDim2.new(1, 0, 0, len)}, options.tween_time)
					Resize(dd.Indicator, {Rotation = 90}, options.tween_time)
				else
					dropdown_open = false
					Resize(dd.Box, {Size = UDim2.new(1, 0, 0, 0)}, options.tween_time)
					Resize(dd.Indicator, {Rotation = -90}, options.tween_time)
				end
			end)

			function data:Add(option)
				local obj = Prefabs.DropdownButton:Clone()
				obj.Parent = dd.Box.Objects
				obj.Text = "      " .. tostring(option)
				obj.ZIndex = dd.ZIndex + 2

				obj.MouseEnter:Connect(function()
					obj.BackgroundColor3 = options.main_color
				end)
				obj.MouseLeave:Connect(function()
					obj.BackgroundColor3 = Color3.fromRGB(33, 34, 36)
				end)

				obj.MouseButton1Click:Connect(function()
					if not dropdown_open then return end
					dd.Text = "      [ " .. tostring(option) .. " ]"
					dropdown_open = false
					open = false
					Resize(dd.Box, {Size = UDim2.new(1, 0, 0, 0)}, options.tween_time)
					Resize(dd.Indicator, {Rotation = -90}, options.tween_time)
					pcall(callback, option)
				end)

				return obj
			end

			return data, dd
		end

		function tab_data:AddColorPicker(callback)
			local data = {}
			callback = typeof(callback) == "function" and callback or function() end

			local cp = Prefabs.ColorPicker:Clone()
			cp.Parent = new_tab
			cp.ZIndex = 15 + (windows * 10)

			local h, s, v = 0, 1, 1
			local function update()
				local col = Color3.fromHSV(h, s, v)
				cp.Sample.ImageColor3 = col
				cp.Saturation.ImageColor3 = Color3.fromHSV(h, 1, 1)
				pcall(callback, col)
			end
			update()

			local Entered1, Entered2, Held = false, false, false
			cp.Palette.MouseEnter:Connect(function() Entered1 = true; Window.Draggable = false end)
			cp.Palette.MouseLeave:Connect(function() Entered1 = false; Window.Draggable = true end)
			cp.Saturation.MouseEnter:Connect(function() Entered2 = true; Window.Draggable = false end)
			cp.Saturation.MouseLeave:Connect(function() Entered2 = false; Window.Draggable = true end)

			UIS.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					Held = true
					task.spawn(function()
						while Held do
							local m = gMouse()
							if Entered1 and not dropdown_open then
								local x = math.clamp((m.X - cp.Palette.AbsolutePosition.X) / 100, 0, 1)
								local y = math.clamp((m.Y - cp.Palette.AbsolutePosition.Y) / 100, 0, 1)
								h = x
								s = 1 - y
								cp.Palette.Indicator.Position = UDim2.new(0, x * 100 - 2.5, 0, y * 100 - 2.5)
								update()
							elseif Entered2 and not dropdown_open then
								local y = math.clamp((m.Y - cp.Saturation.AbsolutePosition.Y) / 100, 0, 1)
								v = 1 - y
								cp.Saturation.Indicator.Position = UDim2.new(0, 0, 0, y * 100)
								update()
							end
							RS.Heartbeat:Wait()
						end
					end)
				end
			end)
			UIS.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					Held = false
				end
			end)

			function data:Set(col)
				if typeof(col) ~= "Color3" then return end
				local r, g, b = col.R * 255, col.G * 255, col.B * 255
				-- simple rgb to hsv
				local maxc, minc = math.max(r, g, b), math.min(r, g, b)
				v = maxc / 255
				local d = maxc - minc
				s = (maxc == 0) and 0 or d / maxc
				if maxc == minc then
					h = 0
				elseif maxc == r then
					h = ((g - b) / d + (g < b and 6 or 0)) / 6
				elseif maxc == g then
					h = ((b - r) / d + 2) / 6
				else
					h = ((r - g) / d + 4) / 6
				end
				update()
			end

			return data, cp
		end

		function tab_data:AddFolder(name)
			local data = {}
			local folder = Prefabs.Folder:Clone()
			folder.Parent = new_tab
			folder.Button.Text = "      " .. tostring(name or "Folder")
			folder.ZIndex = 15 + (windows * 10)
			folder.Button.ZIndex = folder.ZIndex
			folder.Button:FindFirstChild("TextButton_Roundify_4px").ImageColor3 = options.main_color

			local open = false
			folder.Button.MouseButton1Click:Connect(function()
				open = not open
				folder.Objects.Visible = open
				Resize(folder.Button.Toggle, {Rotation = open and 90 or 0}, options.tween_time)
			end)

			-- Proxy methods so you can do folder:AddButton etc.
			for k, v in pairs(tab_data) do
				if typeof(v) == "function" and k ~= "AddFolder" then
					data[k] = function(_, ...)
						local res = {v(...)}
						local obj = res[2] or res[1]
						if typeof(obj) == "Instance" then
							obj.Parent = folder.Objects
						end
						return table.unpack(res)
					end
				end
			end

			-- Keep size updated
			task.spawn(function()
				while folder.Parent do
					local h = 20
					if open then
						for _, c in ipairs(folder.Objects:GetChildren()) do
							if not c:IsA("UIListLayout") then
								h = h + c.AbsoluteSize.Y + 5
							end
						end
					end
					Resize(folder, {Size = UDim2.new(1, 0, 0, h)}, 0.05)
					task.wait(0.1)
				end
			end)

			return data, folder
		end

		-- Auto show first tab
		if #tab_buttons:GetChildren() == 2 then -- layout + first button
			task.defer(show)
		end

		return tab_data, new_tab
	end

	return window_data, Window
end

return library
