-- Config / Flags system (common in modern Elerium-style libs)
Library.Config = {}
Library.ConfigPath = "EleriumConfig"

function Library:SaveConfig(name)
	name = name or "default"
	local data = {}
	for flag, value in pairs(self.Flags) do
		if typeof(value) == "Color3" then
			data[flag] = { R = value.R, G = value.G, B = value.B, __type = "Color3" }
		elseif typeof(value) == "EnumItem" then
			data[flag] = { Name = value.Name, EnumType = tostring(value.EnumType), __type = "EnumItem" }
		else
			data[flag] = value
		end
	end
	local success, encoded = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	if success then
		-- In executor environments writefile may exist
		if writefile then
			pcall(writefile, self.ConfigPath .. "_" .. name .. ".json", encoded)
		end
		self.Config[name] = data
		return true
	end
	return false
end

function Library:LoadConfig(name)
	name = name or "default"
	local raw
	if readfile and isfile and isfile(self.ConfigPath .. "_" .. name .. ".json") then
		raw = readfile(self.ConfigPath .. "_" .. name .. ".json")
	elseif self.Config[name] then
		-- already in memory
		return true
	else
		return false
	end
	local success, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not success then return false end

	for flag, value in pairs(data) do
		if typeof(value) == "table" and value.__type == "Color3" then
			self.Flags[flag] = Color3.new(value.R, value.G, value.B)
		elseif typeof(value) == "table" and value.__type == "EnumItem" then
			-- best effort restore
			self.Flags[flag] = value.Name
		else
			self.Flags[flag] = value
		end
	end
	self.Config[name] = data
	return true
end

function Library:SetFlag(flag, value)
	self.Flags[flag] = value
end

function Library:GetFlag(flag)
	return self.Flags[flag]
end

