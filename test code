        function tab_data:AddNumberBox(placeholder, callback, opts)
            callback = typeof(callback) == "function" and callback or function() end
            opts = typeof(opts) == "table" and opts or {}
            local minv = opts.min
            local maxv = opts.max
            local default = opts.default or 0

            local tb = NumberBoxPrefab:Clone()
            tb.PlaceholderText = tostring(placeholder or "0")
            tb.Text = tostring(default)
            tb.Parent = tabFrame

            local stroke = tb:FindFirstChildOfClass("UIStroke")
            tb.Focused:Connect(function()
                if stroke then
                    Tween(stroke, {Color = options.main_color, Transparency = 0}, 0.12)
                end
            end)
            tb.FocusLost:Connect(function()
                if stroke then
                    Tween(stroke, {Color = ui_options.border, Transparency = 0.45}, 0.12)
                end
                local num = tonumber(tb.Text)
                if num then
                    if minv then num = math.max(minv, num) end
                    if maxv then num = math.min(maxv, num) end
                    tb.Text = tostring(num)
                    safeCallback(callback, num)
                else
                    tb.Text = tostring(default)
                end
            end)
            return tb
        end

        function tab_data:AddSlider(text, callback, opts)
            callback = typeof(callback) == "function" and callback or function() end
            opts = typeof(opts) == "table" and opts or {}
            local minv     = opts.min or 0
            local maxv     = opts.max or 100
            local default  = opts.default or minv
            local readonly = opts.readonly or false
            local decimals = opts.decimals or 0

            local sl = SliderPrefab:Clone()
            sl.Title.Text = tostring(text or "Slider")
            sl.Parent = tabFrame

            local track    = sl.Track
            local fill     = track.Fill
            local valueLbl = sl.Value
            local held     = false

            local function update(pct, silent)
                pct = clamp(pct, 0, 1)
                fill.Size = UDim2.new(pct, 0, 1, 0)
                local val = minv + (maxv - minv) * pct
                if decimals <= 0 then
                    val = math.floor(val + 0.5)
                else
                    val = round(val, decimals)
                end
                valueLbl.Text = tostring(val)
                if not silent then
                    safeCallback(callback, val)
                end
                return val
            end

            track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 and not readonly then
                    held = true
                end
            end)
            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    held = false
                end
            end)
            RS.RenderStepped:Connect(function()
                if held and track.Parent then
                    local rel = clamp((gMouse().X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    update(rel)
                end
            end)

            local data = {}
            function data:Set(v, silent)
                v = tonumber(v) or minv
                update((v - minv) / math.max(0.0001, maxv - minv), silent)
            end
            function data:Get()
                return tonumber(valueLbl.Text) or minv
            end
            data:Set(default, true)
            return data, sl
        end

        function tab_data:AddKeybind(text, callback, opts)
            callback = typeof(callback) == "function" and callback or function() end
            opts = typeof(opts) == "table" and opts or {}
            local standard = opts.standard or Enum.KeyCode.RightShift

            local kb = KeybindPrefab:Clone()
            kb.Title.Text = "  " .. tostring(text or "Keybind")
            kb.Parent = tabFrame

            local short = {
                RightControl = "RCtrl", LeftControl = "LCtrl",
                LeftShift = "LShift", RightShift = "RShift",
                MouseButton1 = "M1", MouseButton2 = "M2",
                MouseButton3 = "M3",
            }

            local current = standard
            local inputBtn = kb.Input

            local function setKey(key)
                current = key
                local name = typeof(key) == "EnumItem" and key.Name or tostring(key)
                inputBtn.Text = short[name] or name
            end
            setKey(standard)

            UIS.InputBegan:Connect(function(inp, gpe)
                if checks.binding or gpe then return end
                if typeof(current) == "EnumItem" and current.EnumType == Enum.KeyCode then
                    if inp.KeyCode == current then
                        safeCallback(callback, current)
                    end
                elseif typeof(current) == "EnumItem" and current.EnumType == Enum.UserInputType then
                    if inp.UserInputType == current then
                        safeCallback(callback, current)
                    end
                end
            end)

            inputBtn.MouseButton1Click:Connect(function()
                if checks.binding then return end
                checks.binding = true
                inputBtn.Text = "..."
                local conn
                conn = UIS.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.Keyboard then
                        setKey(inp.KeyCode)
                        checks.binding = false
                        conn:Disconnect()
                    elseif inp.UserInputType == Enum.UserInputType.MouseButton1
                        or inp.UserInputType == Enum.UserInputType.MouseButton2
                        or inp.UserInputType == Enum.UserInputType.MouseButton3 then
                        setKey(inp.UserInputType)
                        checks.binding = false
                        conn:Disconnect()
                    end
                end)
            end)

            local data = {}
            function data:SetKeybind(k) setKey(k) end
            function data:Get() return current end
            return data, kb
        end

        function tab_data:AddDropdown(text, callback)
            callback = typeof(callback) == "function" and callback or function() end
            local dd = DropdownPrefab:Clone()
            dd.Button.Text = "  " .. tostring(text or "Dropdown")
            dd.Parent = tabFrame

            local open = false
            local list = dd.List
            local btn  = dd.Button
            local selected = nil

            local function toggle()
                open = not open
                checks.dropdown_open = open
                if open then
                    local count = 0
                    for _, c in ipairs(list:GetChildren()) do
                        if c:IsA("TextButton") then count += 1 end
                    end
                    local h = math.min(count * 28 + 8, 180)
                    list.Visible = true
                    Tween(list, {Size = UDim2.new(1, 0, 0, h)}, 0.18)
                    btn.Arrow.Text = "▴"
                else
                    Tween(list, {Size = UDim2.new(1, 0, 0, 0)}, 0.15)
                    task.wait(0.15)
                    list.Visible = false
                    btn.Arrow.Text = "▾"
                end
            end

            btn.MouseButton1Click:Connect(toggle)

            local data = {}
            function data:Add(name)
                name = tostring(name or "Option")
                local opt = Create("TextButton", {
                    BackgroundColor3 = Color3.fromRGB(40, 40, 48),
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 26),
                    Font = ui_options.font,
                    Text = "  " .. name,
                    TextColor3 = ui_options.text,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    Parent = list,
                })
                Roundify(opt, 4)

                opt.MouseEnter:Connect(function()
                    Tween(opt, {BackgroundColor3 = options.main_color}, 0.1)
                end)
                opt.MouseLeave:Connect(function()
                    Tween(opt, {BackgroundColor3 = Color3.fromRGB(40, 40, 48)}, 0.1)
                end)
                opt.MouseButton1Click:Connect(function()
                    selected = name
                    btn.Text = "  [ " .. name .. " ]"
                    toggle()
                    safeCallback(callback, name)
                end)
                return opt
            end
            function data:Get() return selected end
            function data:Set(name)
                selected = name
                btn.Text = "  [ " .. tostring(name) .. " ]"
            end
            function data:Clear()
                for _, c in ipairs(list:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
            end
            return data, dd
        end

        function tab_data:AddMultiDropdown(text, callback)
            callback = typeof(callback) == "function" and callback or function() end
            local dd = MultiDropdownPrefab:Clone()
            dd.Button.Text = "  " .. tostring(text or "Multi")
            dd.Parent = tabFrame

            local open = false
            local list = dd.List
            local btn  = dd.Button
            local selected = {}

            local function refreshText()
                local keys = {}
                for k in pairs(selected) do
                    table.insert(keys, k)
                end
                if #keys == 0 then
                    btn.Text = "  " .. tostring(text or "Multi")
                else
                    btn.Text = "  [ " .. table.concat(keys, ", ") .. " ]"
                end
            end

            local function toggle()
                open = not open
                checks.dropdown_open = open
                if open then
                    local count = 0
                    for _, c in ipairs(list:GetChildren()) do
                        if c:IsA("TextButton") then count += 1 end
                    end
                    local h = math.min(count * 28 + 8, 180)
                    list.Visible = true
                    Tween(list, {Size = UDim2.new(1, 0, 0, h)}, 0.18)
                    btn.Arrow.Text = "▴"
                else
                    Tween(list, {Size = UDim2.new(1, 0, 0, 0)}, 0.15)
                    task.wait(0.15)
                    list.Visible = false
                    btn.Arrow.Text = "▾"
                end
            end

            btn.MouseButton1Click:Connect(toggle)

            local data = {}
            function data:Add(name)
                name = tostring(name or "Option")
                local opt = Create("TextButton", {
                    BackgroundColor3 = Color3.fromRGB(40, 40, 48),
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 26),
                    Font = ui_options.font,
                    Text = "  " .. name,
                    TextColor3 = ui_options.text,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    Parent = list,
                })
                Roundify(opt, 4)

                opt.MouseEnter:Connect(function()
                    Tween(opt, {BackgroundColor3 = options.main_color}, 0.1)
                end)
                opt.MouseLeave:Connect(function()
                    if not selected[name] then
                        Tween(opt, {BackgroundColor3 = Color3.fromRGB(40, 40, 48)}, 0.1)
                    end
                end)
                opt.MouseButton1Click:Connect(function()
                    if selected[name] then
                        selected[name] = nil
                        Tween(opt, {BackgroundColor3 = Color3.fromRGB(40, 40, 48)}, 0.1)
                    else
                        selected[name] = true
                        Tween(opt, {BackgroundColor3 = options.main_color}, 0.1)
                    end
                    refreshText()
                    local arr = {}
                    for k in pairs(selected) do table.insert(arr, k) end
                    safeCallback(callback, arr)
                end)
                return opt
            end
            function data:Get()
                local arr = {}
                for k in pairs(selected) do table.insert(arr, k) end
                return arr
            end
            function data:Clear()
                selected = {}
                refreshText()
                for _, c in ipairs(list:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
            end
            return data, dd
        end

        function tab_data:AddProgressBar(text)
            local pb = ProgressPrefab:Clone()
            pb.Title.Text = tostring(text or "Progress")
            pb.Parent = tabFrame

            local data = {}
            function data:Set(pct)
                pct = clamp(tonumber(pct) or 0, 0, 100)
