local ConfigManager = {}
ConfigManager.__index = ConfigManager

function ConfigManager.new(folderName)
    local self = setmetatable({}, ConfigManager)
    self.FolderName = folderName or "CustomUI_Config"
    self.Data = {}
    self.AutoSave = true
    self.Changed = Signal.new()
    return self
end

function ConfigManager:Set(key, value)
    self.Data[key] = value
    self.Changed:Fire(key, value)
    if self.AutoSave then
        self:Save()
    end
end

function ConfigManager:Get(key, default)
    if self.Data[key] ~= nil then
        return self.Data[key]
    end
    return default
end

function ConfigManager:Save()
    local success, err = pcall(function()
        if writefile then
            local encoded = HttpService:JSONEncode(self.Data)
            writefile(self.FolderName .. ".json", encoded)
        end
    end)
    if not success then
        warn("[ConfigManager] Failed to save:", err)
    end
end

function ConfigManager:Load()
    local success, result = pcall(function()
        if isfile and isfile(self.FolderName .. ".json") then
            local content = readfile(self.FolderName .. ".json")
            return HttpService:JSONDecode(content)
        end
        return {}
    end)
    if success and type(result) == "table" then
        self.Data = result
    else
        self.Data = {}
    end
    return self.Data
end

function ConfigManager:Delete()
    pcall(function()
        if isfile and isfile(self.FolderName .. ".json") then
            delfile(self.FolderName .. ".json")
        end
    end)
    self.Data = {}
end

function ConfigManager:GetAll()
    return Utility.DeepCopy(self.Data)
end

