local Utility = {}

function Utility.DeepCopy(original)
    local copy
    if typeof(original) == "table" then
        copy = {}
        for k, v in pairs(original) do
            copy[Utility.DeepCopy(k)] = Utility.DeepCopy(v)
        end
        setmetatable(copy, Utility.DeepCopy(getmetatable(original)))
    else
        copy = original
    end
    return copy
end

function Utility.Merge(t1, t2)
    local result = Utility.DeepCopy(t1)
    for k, v in pairs(t2) do
        if typeof(v) == "table" and typeof(result[k]) == "table" then
            result[k] = Utility.Merge(result[k], v)
        else
            result[k] = v
        end
    end
    return result
end

function Utility.Round(num, decimalPlaces)
    local mult = 10 ^ (decimalPlaces or 0)
    return math.floor(num * mult + 0.5) / mult
end

function Utility.Clamp(value, min, max)
    return math.max(min, math.min(max, value))
end

function Utility.Lerp(a, b, t)
    return a + (b - a) * t
end

function Utility.Color3ToHex(color)
    return string.format("#%02X%02X%02X",
        math.floor(color.R * 255),
        math.floor(color.G * 255),
        math.floor(color.B * 255)
    )
end

function Utility.HexToColor3(hex)
    hex = hex:gsub("#", "")
    return Color3.fromRGB(
        tonumber("0x" .. hex:sub(1, 2)),
        tonumber("0x" .. hex:sub(3, 4)),
        tonumber("0x" .. hex:sub(5, 6))
    )
end

function Utility.RGBToHSV(r, g, b)
    r, g, b = r / 255, g / 255, b / 255
    local max, min = math.max(r, g, b), math.min(r, g, b)
    local h, s, v = 0, 0, max
    local d = max - min
    s = max == 0 and 0 or d / max
    if max ~= min then
        if max == r then
            h = (g - b) / d + (g < b and 6 or 0)
        elseif max == g then
            h = (b - r) / d + 2
        else
            h = (r - g) / d + 4
        end
        h = h / 6
    end
    return h, s, v
end

function Utility.HSVToRGB(h, s, v)
    local r, g, b
    local i = math.floor(h * 6)
    local f = h * 6 - i
    local p = v * (1 - s)
    local q = v * (1 - f * s)
    local t = v * (1 - (1 - f) * s)
    i = i % 6
    if i == 0 then r, g, b = v, t, p
    elseif i == 1 then r, g, b = q, v, p
    elseif i == 2 then r, g, b = p, v, t
    elseif i == 3 then r, g, b = p, q, v
    elseif i == 4 then r, g, b = t, p, v
    else r, g, b = v, p, q end
    return Color3.new(r, g, b)
end

function Utility.GetTextSize(text, font, size, frameSize)
    return TextService:GetTextSize(tostring(text), size, font, frameSize or Vector2.new(10000, 10000))
end

function Utility.Create(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then
            inst[k] = v
        end
    end
    if props and props.Parent then
        inst.Parent = props.Parent
    end
    return inst
end

function Utility.AddCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 4)
    c.Parent = parent
    return c
end

function Utility.AddPadding(parent, top, bottom, left, right)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, top or 0)
    p.PaddingBottom = UDim.new(0, bottom or 0)
    p.PaddingLeft = UDim.new(0, left or 0)
    p.PaddingRight = UDim.new(0, right or 0)
    p.Parent = parent
    return p
end

function Utility.AddListLayout(parent, fillDirection, padding, horizontalAlignment, verticalAlignment)
    local l = Instance.new("UIListLayout")
    l.FillDirection = fillDirection or Enum.FillDirection.Vertical
    l.Padding = UDim.new(0, padding or 6)
    l.HorizontalAlignment = horizontalAlignment or Enum.HorizontalAlignment.Left
    l.VerticalAlignment = verticalAlignment or Enum.VerticalAlignment.Top
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Parent = parent
    return l
end

function Utility.AddStroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or State.Theme.BorderColor
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.Parent = parent
    return s
end

function Utility.Tween(obj, props, duration, style, direction)
    duration = duration or State.Theme.TweenTime
    style = style or State.Theme.TweenStyle
    direction = direction or State.Theme.TweenDirection
    local info = TweenInfo.new(duration, style, direction)
    local tween = TweenService:Create(obj, info, props)
    tween:Play()
    return tween
end

function Utility.PlaySound(id, volume)
    if not State.Theme.EnableSounds then return end
    local s = Instance.new("Sound")
    s.SoundId = id
    s.Volume = volume or 0.3
    s.Parent = SoundService
    s:Play()
    s.Ended:Connect(function()
        s:Destroy()
    end)
end

function Utility.SafeCall(fn, ...)
    local success, result = pcall(fn, ...)
    if not success then
        warn("[UILibrary] Error:", result)
    end
    return success, result
end

function Utility.GenerateUID()
    return HttpService:GenerateGUID(false):gsub("-", ""):sub(1, 12)
end

function Utility.MousePos()
    local loc = UserInputService:GetMouseLocation()
    return Vector2.new(loc.X, loc.Y)
end

function Utility.IsMouseOver(gui)
    local pos = Utility.MousePos()
    local absPos = gui.AbsolutePosition
    local absSize = gui.AbsoluteSize
    return pos.X >= absPos.X and pos.X <= absPos.X + absSize.X
       and pos.Y >= absPos.Y and pos.Y <= absPos.Y + absSize.Y
end

function Utility.Ripple(button, x, y, color)
    task.spawn(function()
        local circle = Utility.Create("ImageLabel", {
            Name = "Ripple",
            BackgroundTransparency = 1,
            Image = "rbxassetid://266543268",
            ImageColor3 = color or Color3.new(1, 1, 1),
            ImageTransparency = 0.6,
            ZIndex = 100,
            Parent = button
        })
        button.ClipsDescendants = true
        local relX = x - button.AbsolutePosition.X
        local relY = y - button.AbsolutePosition.Y
        circle.Position = UDim2.fromOffset(relX, relY)
        local targetSize = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2.2
        Utility.Tween(circle, {
            Size = UDim2.fromOffset(targetSize, targetSize),
            Position = UDim2.new(0.5, -targetSize/2, 0.5, -targetSize/2),
            ImageTransparency = 1
        }, 0.5)
        task.wait(0.55)
        circle:Destroy()
    end)
end

function Utility.MakeDraggable(frame, handle)
    handle = handle or frame
    local dragging, dragInput, dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            State.Dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    State.Dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

