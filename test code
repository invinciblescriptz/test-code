-- Main Loop
spawn(function()
    while true do
        wait(0.1)
        
        if not Character or not Character:FindFirstChild("HumanoidRootPart") then
            Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            RootPart = Character:WaitForChild("HumanoidRootPart")
            Humanoid = Character:WaitForChild("Humanoid")
        end
        
        -- Anti AFK
        if getgenv().MuscleLegendsConfig.AntiAFK then
            pcall(function()
                for _, v in pairs(getconnections(LocalPlayer.Idled)) do
                    v:Disable()
                end
            end)
        end
        
        -- God Mode
        if getgenv().MuscleLegendsConfig.GodMode and Humanoid then
            Humanoid.MaxHealth = math.huge
            Humanoid.Health = math.huge
        end
        
        -- Auto Train / Farm
        if getgenv().MuscleLegendsConfig.AutoTrain or getgenv().MuscleLegendsConfig.AutoFarmStrength then
            pcall(function()
                -- Common training remotes in Muscle Legends (adjust based on actual game)
                if ReplicatedStorage:FindFirstChild("Events") then
                    local events = ReplicatedStorage.Events
                    -- Example fire (you may need to find exact remote names via Dex)
                    if events:FindFirstChild("Train") then
                        events.Train:FireServer("Lift") -- or "Pushup", etc.
                    end
                end
                
                -- Simulate clicking training objects
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj.Name:lower():find("dumbbell") or obj.Name:lower():find("weight") then
                        if (RootPart.Position - obj.Position).Magnitude < 20 then
                            -- Fire proximity or click event
                        end
                    end
                end
            end)
        end
        
        -- Kill Aura
        if getgenv().MuscleLegendsConfig.KillAura then
            pcall(function()
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = (RootPart.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                        if dist < getgenv().MuscleLegendsConfig.KillAuraRange then
                            plr.Character.Humanoid.Health = 0
                        end
                    end
                end
            end)
        end
        
        -- Auto Rebirth
        if getgenv().MuscleLegendsConfig.AutoRebirth then
            pcall(function()
                local strength = LocalPlayer.leaderstats and LocalPlayer.leaderstats:FindFirstChild("Strength")
                if strength and strength.Value >= getgenv().MuscleLegendsConfig.RebirthAt then
                    -- Fire rebirth remote
                    Notify("Rebirth", "Rebirthing now!")
                end
            end)
        end
    end
end)

