                CanvasSize = UDim2.new(0, 0, 0, 0),
                ScrollBarThickness = 2,
                BorderSizePixel = 0,
                Parent = DropFrame,
            })
            local DropLayout = Utility.Create("UIListLayout", {
                Parent = DropScroll,
            })
            DropLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                DropScroll.CanvasSize = UDim2.new(0, 0, 0, DropLayout.AbsoluteContentSize.Y)
            end)

            local function Toggle()
                open = not open
                DropFrame.Visible = open
                local height = math.min(#list * 28, 140)
                Container.Size = open and UDim2.new(1, 0, 0, 34 + height + 6) or UDim2.new(1, 0, 0, 34)
                DropFrame.Size = open and UDim2.new(1, 0, 0, height) or UDim2.new(1, 0, 0, 0)
                Arrow.Text = open and "▴" or "▾"
            end

            Button.MouseButton1Click:Connect(Toggle)

            local function RefreshText()
                if multi then
                    local count = Utility.TableLength(selected)
                    Button.Text = "  " .. (count > 0 and (count .. " selected") or text)
                else
                    Button.Text = "  " .. (selected or text)
                end
            end

            for _, option in ipairs(list) do
                local OptBtn = Utility.Create("TextButton", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 28),
                    Font = theme:Get("FontSemi"),
                    Text = "  " .. tostring(option),
                    TextColor3 = theme:Get("SubText"),
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    Parent = DropScroll,
                })
                OptBtn.MouseEnter:Connect(function()
                    OptBtn.TextColor3 = theme:Get("Text")
                    OptBtn.BackgroundTransparency = 0.9
                end)
                OptBtn.MouseLeave:Connect(function()
                    OptBtn.TextColor3 = theme:Get("SubText")
                    OptBtn.BackgroundTransparency = 1
                end)
                OptBtn.MouseButton1Click:Connect(function()
                    if multi then
                        if selected[option] then
                            selected[option] = nil
                        else
                            selected[option] = true
                        end
                        RefreshText()
                        Utility.SafeCall(callback, selected)
                    else
                        selected = option
                        RefreshText()
                        Toggle()
                        Utility.SafeCall(callback, selected)
                    end
                end)
            end

            RefreshText()

            return {
                Instance = Container,
                Set = function(_, value)
                    selected = value
                    RefreshText()
                end,
                Get = function() return selected end,
                Refresh = function(_, newList)
                    -- simplified
                end,
            }
        end

        function TabAPI:AddKeybind(options)
            options = type(options) == "table" and options or {}
            local text = options.Text or "Keybind"
            local default = options.Default or Enum.KeyCode.Unknown
            local callback = options.Callback or function() end
            local flag = options.Flag

            local Container = Utility.Create("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 32),
                Parent = TabContent,
            })

            local Label = Utility.Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -100, 1, 0),
                Font = theme:Get("FontSemi"),
                Text = text,
                TextColor3 = theme:Get("Text"),
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = Container,
            })

            local KeyButton = Utility.Create("TextButton", {
                BackgroundColor3 = theme:Get("Secondary"),
                Position = UDim2.new(1, -90, 0.5, -12),
                Size = UDim2.new(0, 85, 0, 24),
                Font = theme:Get("FontSemi"),
                Text = default.Name or "None",
                TextColor3 = theme:Get("Text"),
                TextSize = 12,
                AutoButtonColor = false,
                Parent = Container,
            })
            Utility.Create("UICorner", {
                CornerRadius = UDim.new(0, 6),
                Parent = KeyButton,
            })

            local listening = false
            local currentKey = default

            local function Set(key)
                currentKey = key
                KeyButton.Text = key.Name or tostring(key)
            end

            KeyButton.MouseButton1Click:Connect(function()
                listening = true
                KeyButton.Text = "..."
                KeyButton.TextColor3 = theme:Get("Accent")
            end)

            local connection
            connection = UIS.InputBegan:Connect(function(input, gpe)
                if listening and not gpe then
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        Set(input.KeyCode)
                        listening = false
                        KeyButton.TextColor3 = theme:Get("Text")
                        Utility.SafeCall(callback, currentKey)
                    end
                elseif not listening and input.KeyCode == currentKey then
                    Utility.SafeCall(callback, currentKey)
                end
            end)

            return {
                Instance = Container,
                Set = Set,
                Get = function() return currentKey end,
            }
        end

        function TabAPI:AddColorPicker(options)
            options = type(options) == "table" and options or {}
            local text = options.Text or "Color"
            local default = options.Default or Color3.fromRGB(255, 255, 255)
            local callback = options.Callback or function() end

            local Container = Utility.Create("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 32),
                Parent = TabContent,
            })

            local Label = Utility.Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -40, 1, 0),
                Font = theme:Get("FontSemi"),
                Text = text,
                TextColor3 = theme:Get("Text"),
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = Container,
            })

            local Preview = Utility.Create("Frame", {
                BackgroundColor3 = default,
                Position = UDim2.new(1, -30, 0.5, -10),
                Size = UDim2.new(0, 24, 0, 20),
                Parent = Container,
            })
            Utility.Create("UICorner", {
                CornerRadius = UDim.new(0, 5),
                Parent = Preview,
            })
            Utility.Create("UIStroke", {
                Color = theme:Get("Border"),
                Thickness = 1,
                Parent = Preview,
            })

            -- Simplified: clicking cycles through some colors or opens a basic picker
            local colors = {
                Color3.fromRGB(255, 80, 80),
                Color3.fromRGB(255, 160, 50),
                Color3.fromRGB(255, 220, 50),
                Color3.fromRGB(80, 220, 120),
                Color3.fromRGB(50, 180, 255),
                Color3.fromRGB(140, 100, 255),
                Color3.fromRGB(255, 100, 200),
                Color3.fromRGB(255, 255, 255),
            }
            local index = 1
            Preview.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    index = index % #colors + 1
                    Preview.BackgroundColor3 = colors[index]
                    Utility.SafeCall(callback, colors[index])
                end
            end)

            return {
                Instance = Container,
                Set = function(_, color)
                    Preview.BackgroundColor3 = color
                end,
                Get = function() return Preview.BackgroundColor3 end,
            }
        end

        function TabAPI:AddFolder(name)
            local open = false
            local FolderContainer = Utility.Create("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 30),
                ClipsDescendants = true,
                Parent = TabContent,
            })

            local Header = Utility.Create("TextButton", {
                BackgroundColor3 = theme:Get("Tertiary"),
                Size = UDim2.new(1, 0, 0, 30),
                Font = theme:Get("FontBold"),
                Text = "  ▶  " .. (name or "Folder"),
                TextColor3 = theme:Get("SubText"),
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
                Parent = FolderContainer,
            })
            Utility.Create("UICorner", {
                CornerRadius = UDim.new(0, 6),
                Parent = Header,
            })

            local Content = Utility.Create("Frame", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, 34),
                Size = UDim2.new(1, 0, 0, 0),
                Visible = false,
                Parent = FolderContainer,
            })
            local ContentLayout = Utility.Create("UIListLayout", {
                Padding = UDim.new(0, 6),
                Parent = Content,
            })
            Utility.Create("UIPadding", {
                PaddingLeft = UDim.new(0, 8),
                Parent = Content,
            })

            Header.MouseButton1Click:Connect(function()
                open = not open
                Content.Visible = open
                Header.Text = (open and "  ▼  " or "  ▶  ") .. (name or "Folder")
                local height = open and (ContentLayout.AbsoluteContentSize.Y + 40) or 30
                FolderContainer.Size = UDim2.new(1, 0, 0, height)
            end)
            ContentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                if open then
                    FolderContainer.Size = UDim2.new(1, 0, 0, ContentLayout.AbsoluteContentSize.Y + 40)
                end
            end)

            -- Proxy methods to add elements into the folder content
            local FolderAPI = {}
            for key, func in pairs(TabAPI) do
                if type(func) == "function" and key ~= "Show" and key ~= "AddFolder" then
                    FolderAPI[key] = function(_, ...)
                        local oldParent = TabContent
                        -- We temporarily change the parent target by creating elements then reparenting
                        local results = {func(TabAPI, ...)}
                        local children = TabContent:GetChildren()
                        local last = children[#children]
                        if last and last ~= FolderContainer then
                            last.Parent = Content
                        end
                        return unpack(results)
                    end
                end
            end
            return FolderAPI
        end

        function TabAPI:AddSeparator()
            local Sep = Utility.Create("Frame", {
                BackgroundColor3 = theme:Get("Border"),
                Size = UDim2.new(1, 0, 0, 1),
                Parent = TabContent,
            })
            return Sep
        end

        function TabAPI:AddSpace(pixels)
            local Spacer = Utility.Create("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, pixels or 10),
                Parent = TabContent,
            })
            return Spacer
        end

        table.insert(WindowAPI.Tabs, TabAPI)
        if #WindowAPI.Tabs == 1 then
            TabAPI:Show()
        end
        return TabAPI
    end

    table.insert(self.Windows, WindowAPI)
    return WindowAPI
end

