	local container = Create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 40),
		ZIndex = zBase + 3,
		Parent = parent,
	})

	local label = Create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -50, 0, 16),
		Font = DefaultOptions.font,
		Text = text or "Progress",
		TextColor3 = Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = zBase + 4,
		Parent = container,
	})

	local percentLabel = Create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -45, 0, 0),
		Size = UDim2.fromOffset(45, 16),
		Font = DefaultOptions.font_bold,
		Text = "0%",
		TextColor3 = accent,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = zBase + 4,
		Parent = container,
	})

	local track = Create("Frame", {
		BackgroundColor3 = Theme.SliderTrack,
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 8),
		ZIndex = zBase + 4,
		Parent = container,
	})
	ApplyCorner(track, 4)

	local fill = Create("Frame", {
		BackgroundColor3 = accent,
		Size = UDim2.fromScale(0, 1),
		ZIndex = zBase + 5,
		Parent = track,
	})
	ApplyCorner(fill, 4)

	local data = {}
	function data:Set(percent)
		percent = Clamp(percent, 0, 100)
		SafeTween(fill, {Size = UDim2.fromScale(percent / 100, 1)}, AnimationPresets.Normal)
		percentLabel.Text = math.floor(percent) .. "%"
	end
	function data:Get()
		return fill.Size.X.Scale * 100
	end

	return data
end

