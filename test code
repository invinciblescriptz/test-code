--[[ 
    Fixed ImGui-style UI Library
    Works as ModuleScript or via loadstring / executor
]]

local ui_options = {
	main_color = Color3.fromRGB(41, 74, 122),
	min_size = Vector2.new(400, 300),
	toggle_key = Enum.KeyCode.RightShift,
	can_resize = true,
}

-- Clean up previous
do
	local existing = game:GetService("CoreGui"):FindFirstChild("imgui")
	if existing then existing:Destroy() end
	if gethui then
		local h = gethui():FindFirstChild("imgui")
		if h then h:Destroy() end
	end
end

local imgui = Instance.new("ScreenGui")
imgui.Name = "imgui"
imgui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
imgui.ResetOnSpawn = false

pcall(function()
	imgui.Parent = game:GetService("CoreGui")
end)
if not imgui.Parent then
	imgui.Parent = gethui and gethui() or game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end

