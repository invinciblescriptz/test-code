function Tab:AddSearchBox(placeholder, callback)
	callback = callback or function() end
	local frame = createElementBase(self, 32)

	local box = Instance.new("TextBox")
	box.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	box.Size = UDim2.new(1, -16, 1, -8)
	box.Position = UDim2.fromOffset(8, 4)
	box.Font = self.Window.Theme.font
	box.PlaceholderText = placeholder or "Search..."
	box.PlaceholderColor3 = self.Window.Theme.dim_text
	box.Text = ""
	box.TextColor3 = self.Window.Theme.text_color
	box.TextSize = self.Window.Theme.font_size
	box.ClearTextOnFocus = false
	box.ZIndex = 13
	box.Parent = frame
	makeCorner(box, 4)
	makePadding(box, 0, 8, 0, 8)

	box:GetPropertyChangedSignal("Text"):Connect(function()
		task.spawn(callback, box.Text)
	end)

	return self:_addElement({Frame = frame, Box = box})
end

