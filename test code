		Window = Window,
		TitleBar = TitleBar,
		TabBar = TabBar,
		TabList = TabList,
		Content = Content,
		Tabs = {},
		CurrentTab = nil,
		Accent = accent,
		Minimized = false,
	}

	local originalSize = Window.Size

	MinBtn.MouseButton1Click:Connect(function()
		windowData.Minimized = not windowData.Minimized
		if windowData.Minimized then
			originalSize = Window.Size
			Tween(Window, {Size = UDim2.fromOffset(Window.AbsoluteSize.X, DefaultOptions.title_bar_height)}, 0.25)
			Content.Visible = false
			TabBar.Visible = false
		else
			Tween(Window, {Size = originalSize}, 0.25)
			Content.Visible = true
			TabBar.Visible = #windowData.Tabs > 1
		end
	end)

