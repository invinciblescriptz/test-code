-- ===================== UTILS =====================

local function tween(obj, props, time, style, dir)
	return TweenService:Create(obj, TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
end

local function ripple(parent)
	local c = Instance.new("ImageLabel")
	c.BackgroundTransparency = 1
	c.Image = "rbxassetid://266543268"
	c.ImageTransparency = 0.55
	c.Size = UDim2.fromOffset(0, 0)
	c.Position = UDim2.fromScale(0.5, 0.5)
	c.AnchorPoint = Vector2.new(0.5, 0.5)
	c.ZIndex = 20
	c.Parent = parent

	local size = math.max(parent.AbsoluteSize.X, parent.AbsoluteSize.Y) * 1.6
	tween(c, {
		Size = UDim2.fromOffset(size, size),
		ImageTransparency = 1
	}, 0.45)
	task.delay(0.5, c.Destroy, c)
end

local function roundify(parent, color, z)
	local img = Instance.new("ImageLabel")
	img.Name = "Roundify"
	img.BackgroundTransparency = 1
	img.Size = UDim2.fromScale(1, 1)
	img.Image = "rbxassetid://2851929490"
	img.ImageColor3 = color or Color3.fromRGB(52, 53, 56)
	img.ScaleType = Enum.ScaleType.Slice
	img.SliceCenter = Rect.new(4, 4, 4, 4)
	img.ZIndex = (parent.ZIndex or 1) + (z or 0)
	img.Parent = parent
	return img
end

