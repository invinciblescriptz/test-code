-- Color conversion helpers
function Library.ColorToHex(color)
    local r = math.floor(color.R * 255)
    local g = math.floor(color.G * 255)
    local b = math.floor(color.B * 255)
    return string.format("#%02X%02X%02X", r, g, b)
end

function Library.HexToColor(hex)
    hex = hex:gsub("#", "")
    local r = tonumber(hex:sub(1, 2), 16) / 255
    local g = tonumber(hex:sub(3, 4), 16) / 255
    local b = tonumber(hex:sub(5, 6), 16) / 255
    return Color3.new(r, g, b)
end

function Library.RGBToHSV(r, g, b)
    local max = math.max(r, g, b)
    local min = math.min(r, g, b)
    local h, s, v
    v = max
    local d = max - min
    s = max == 0 and 0 or d / max
    if max == min then
        h = 0
    else
        if max == r then
            h = (g - b) / d + (g < b and 6 or 0)
        elseif max == g then
            h = (b - r) / d + 2
        else
            h = (r - g) / d + 4
        end
        h = h / 6
    end
    return h, s, v
end

function Library.HSVToRGB(h, s, v)
    local r, g, b
    local i = math.floor(h * 6)
    local f = h * 6 - i
    local p = v * (1 - s)
    local q = v * (1 - f * s)
    local t = v * (1 - (1 - f) * s)
    i = i % 6
    if i == 0 then r, g, b = v, t, p
    elseif i == 1 then r, g, b = q, v, p
    elseif i == 2 then r, g, b = p, v, t
    elseif i == 3 then r, g, b = p, q, v
    elseif i == 4 then r, g, b = t, p, v
    else r, g, b = v, p, q end
    return r, g, b
end

-- Math helpers
function Library.Lerp(a, b, t)
    return a + (b - a) * t
end

function Library.Map(value, inMin, inMax, outMin, outMax)
    return outMin + (value - inMin) * (outMax - outMin) / (inMax - inMin)
end

function Library.Clamp(value, min, max)
    return clamp(value, min, max)
end

function Library.Round(n, decimals)
    return round(n, decimals)
end

-- Table helpers
function Library.DeepCopy(t)
    return deepCopy(t)
end

function Library.MergeTables(t1, t2)
    local result = deepCopy(t1)
    for k, v in pairs(t2) do
        if type(v) == "table" and type(result[k]) == "table" then
            result[k] = Library.MergeTables(result[k], v)
        else
            result[k] = v
        end
    end
    return result
end

function Library.TableContains(t, value)
    for _, v in pairs(t) do
        if v == value then return true end
    end
    return false
end

function Library.TableFind(t, value)
    for i, v in pairs(t) do
        if v == value then return i end
    end
    return nil
end

function Library.TableLength(t)
    local count = 0
    for _ in pairs(t) do count = count + 1 end
    return count
end

-- String helpers
function Library.Truncate(str, maxLen)
    if #str <= maxLen then return str end
    return str:sub(1, maxLen - 3) .. "..."
end

function Library.Split(str, sep)
    local result = {}
    for part in string.gmatch(str, "([^" .. sep .. "]+)") do
        table.insert(result, part)
    end
    return result
end

function Library.StartsWith(str, prefix)
    return str:sub(1, #prefix) == prefix
end

function Library.EndsWith(str, suffix)
    return str:sub(-#suffix) == suffix
end

function Library.Trim(str)
    return str:match("^%s*(.-)%s*$")
end

-- Input helpers
function Library.IsKeyDown(keyCode)
    return UserInputService:IsKeyDown(keyCode)
end

function Library.IsMouseButtonPressed(button)
    return UserInputService:IsMouseButtonPressed(button)
end

function Library.GetMousePosition()
    return UserInputService:GetMouseLocation()
end

function Library.IsMobileDevice()
    return isMobile()
end

-- Animation presets
function Library.FadeIn(guiObject, duration)
    guiObject.Visible = true
    local original = guiObject.BackgroundTransparency
    guiObject.BackgroundTransparency = 1
    return tween(guiObject, {BackgroundTransparency = original}, duration or 0.3)
end

function Library.FadeOut(guiObject, duration, destroyAfter)
    local tw = tween(guiObject, {BackgroundTransparency = 1}, duration or 0.3)
    if destroyAfter then
        tw.Completed:Connect(function()
            guiObject:Destroy()
        end)
    end
    return tw
end

function Library.SlideIn(guiObject, direction, duration)
    local original = guiObject.Position
    local offset = direction == "left" and UDim2.new(-1, 0, 0, 0)
                 or direction == "right" and UDim2.new(1, 0, 0, 0)
                 or direction == "up" and UDim2.new(0, 0, -1, 0)
                 or UDim2.new(0, 0, 1, 0)
    guiObject.Position = original + offset
    guiObject.Visible = true
    return tween(guiObject, {Position = original}, duration or 0.35, Enum.EasingStyle.Quart)
end

function Library.Pulse(guiObject, scale, duration)
    local original = guiObject.Size
    local tw1 = tween(guiObject, {
        Size = UDim2.new(
            original.X.Scale * scale,
            original.X.Offset * scale,
            original.Y.Scale * scale,
            original.Y.Offset * scale
        )
    }, (duration or 0.4) / 2)
    tw1.Completed:Connect(function()
        tween(guiObject, {Size = original}, (duration or 0.4) / 2)
    end)
    return tw1
end

-- Config save / load (simple JSON via HttpService)
function Library:SaveConfig(name, data)
    local success, encoded = pcall(HttpService.JSONEncode, HttpService, data)
    if success then
        -- In a real exploit environment you would write to a file
        -- Here we store in memory / flags
        self._flags["config_" .. name] = encoded
        return true
    end
    return false
end

function Library:LoadConfig(name)
    local encoded = self._flags["config_" .. name]
    if not encoded then return nil end
    local success, data = pcall(HttpService.JSONDecode, HttpService, encoded)
    if success then return data end
    return nil
end

-- Debugging helpers
function Library:DebugPrint(...)
    print("[EleriumUI]", ...)
end

function Library:GetVersion()
    return self.Version
end

