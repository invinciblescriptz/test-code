			header.BackgroundTransparency = 1
			header.Size = UDim2.new(1, 0, 0, 20)
			header.Font = Enum.Font.GothamSemibold
			header.TextSize = 14
			header.TextColor3 = Color3.new(1, 1, 1)
			header.TextXAlignment = Enum.TextXAlignment.Left
			header.Text = "      " .. (name or "Folder")
			header.ZIndex = zoff + 2
			header.Parent = folder

			local arrow = Instance.new("ImageLabel")
			arrow.BackgroundTransparency = 1
			arrow.Image = "rbxassetid://4731371541"
			arrow.Size = UDim2.new(0, 20, 0, 20)
			arrow.Position = UDim2.new(0, 5, 0, 0)
			arrow.Rotation = 0
			arrow.ZIndex = zoff + 3
			arrow.Parent = header

			local content = Instance.new("Frame")
			content.BackgroundTransparency = 1
			content.Position = UDim2.new(0, 10, 0, 25)
			content.Size = UDim2.new(1, -10, 0, 0)
			content.Visible = false
			content.ZIndex = zoff + 1
			content.Parent = folder

			local clist = Instance.new("UIListLayout")
			clist.SortOrder = Enum.SortOrder.LayoutOrder
			clist.Padding = UDim.new(0, 5)
			clist.Parent = content

			header.MouseButton1Click:Connect(function()
				open = not open
				content.Visible = open
				arrow.Rotation = open and 90 or 0
				if open then
					folder.Size = UDim2.new(1, 0, 0, 25 + clist.AbsoluteContentSize.Y)
				else
					folder.Size = UDim2.new(1, 0, 0, 20)
				end
			end)

			clist:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
				if open then
					folder.Size = UDim2.new(1, 0, 0, 25 + clist.AbsoluteContentSize.Y)
				end
			end)

			-- return a mini tab-like object so you can do folder:AddButton etc.
			local folder_data = {}
			function folder_data:AddLabel(t) return tab_data:AddLabel(t) end -- simplified
			-- For full support you would re-implement the adders pointing to `content`
			-- (kept simple here for size)

			return folder_data
		end

		table.insert(tab_list, {btn = tabBtn, page = page, data = tab_data})
		if #tab_list == 1 then
			tab_data:Show()
		end

		return tab_data
	end

	return window_data, win
end

-- Global toggle key
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == ui_options.toggle_key then
		for _, gui in ipairs(imgui:GetChildren()) do
			if gui.Name == "Window" or gui:IsA("ImageLabel") and gui.Image == "rbxassetid://2851926732" then
				gui.Visible = not gui.Visible
			end
		end
	end
end)

return library
