local function createFolder(parent, title)
	local open = true
	local frame = Instance.new("Frame")
	frame.Name = "Folder"
	frame.BackgroundColor3 = Library.Theme.Background
	frame.BackgroundTransparency = 0.3
	frame.BorderSizePixel = 0
	frame.Size = UDim2.new(1, 0, 0, 26)
	frame.ClipsDescendants = true
	frame.Parent = parent
	makeCorner(frame, 4)

	local header = Instance.new("TextButton")
	header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, 0, 0, 26)
	header.Font = Library.Theme.FontMedium
	header.TextSize = 13
	header.TextColor3 = Library.Theme.Text
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.Text = "  ▼  " .. (title or "Folder")
	header.AutoButtonColor = false
	header.Parent = frame
	makePadding(header, 2, 0, 2, 0)

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.Position = UDim2.fromOffset(0, 26)
	content.Size = UDim2.new(1, 0, 0, 0)
	content.AutomaticSize = Enum.AutomaticSize.Y
	content.Parent = frame
	makeList(content, 3)
	makePadding(content, 3, 2, 3, 4)

	local function updateSize()
		if open then
			frame.AutomaticSize = Enum.AutomaticSize.Y
			header.Text = "  ▼  " .. (title or "Folder")
		else
			frame.AutomaticSize = Enum.AutomaticSize.None
			frame.Size = UDim2.new(1, 0, 0, 26)
			header.Text = "  ▶  " .. (title or "Folder")
		end
	end

	header.MouseButton1Click:Connect(function()
		open = not open
		content.Visible = open
		updateSize()
	end)

	updateSize()

	local folderApi = { _content = content }

	function folderApi:AddLabel(t, opts) return Elements.Label(content, t, opts) end
	function folderApi:AddButton(t, cb, opts) return Elements.Button(content, t, cb, opts) end
	function folderApi:AddSwitch(t, cb, opts) return Elements.Switch(content, t, cb, opts) end
	function folderApi:AddSlider(t, cb, opts) return Elements.Slider(content, t, cb, opts) end
	function folderApi:AddTextBox(t, cb, opts) return Elements.TextBox(content, t, cb, opts) end
	function folderApi:AddDropdown(t, cb, opts) return Elements.Dropdown(content, t, cb, opts) end
	function folderApi:AddCheckbox(t, cb, opts) return Elements.Checkbox(content, t, cb, opts) end
	function folderApi:AddParagraph(t, opts) return Elements.Paragraph(content, t, opts) end
	function folderApi:AddSeparator(opts) return Elements.Separator(content, opts) end
	function folderApi:AddFolder(t) return createFolder(content, t) end

	return folderApi, frame
end

