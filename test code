--[[
================================================================================
    ELERIUM UI LIBRARY  (Original Implementation)
    Version: 3.0.0
    Written from scratch – not derived from any existing Elerium / ImGui source.
    Compatible with Roblox Lua (Luau) environments that allow CoreGui / PlayerGui.
================================================================================

    PUBLIC API (high-level)
    -----------------------
    local Library = loadstring(...)()   -- or require this module

    local Window = Library:AddWindow(title, options)
    local Tab    = Window:AddTab(name)
    Tab:Show()

    Tab:AddLabel(text)
    Tab:AddButton(text, callback)
    Tab:AddSwitch(text, callback)      → returns object with :Set(bool)
    Tab:AddSlider(text, callback, opts)→ returns object with :Set(number)
    Tab:AddTextBox(text, callback, opts)
    Tab:AddDropdown(text, callback)    → returns object with :Add(option) / :Remove()
    Tab:AddColorPicker(callback)       → returns object with :Set(Color3)
    Tab:AddConsole(opts)
    Tab:AddFolder()                    → nested container that supports the same methods
    Tab:AddSeparator()
    Tab:AddKeybind(text, callback)
    Tab:AddParagraph(title, content)

    Extra utilities, themes, animation helpers and internal systems are also
    exposed for advanced users.

================================================================================
]]

